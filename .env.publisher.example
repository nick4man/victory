# Telegram-публикатор очереди (services/content-publisher) в контейнере publisher.
# Скопировать в .env.publisher. Значения — из workspace/agents/content-publisher/.env
# на хосте chat (вне git). Форма ключей — services/content-publisher/.env.example.
CHANNEL_BOT_TOKEN=
OKSANA_CHAT_ID=
DARTAGNAN_CHAT_ID=
CHIEF_EDITOR_CHAT_ID=
RZNVICTORY_CHANNEL=@rznvictory
# Та же база, что у конвейера (news-db); пароль — NEWS_DB_PASSWORD из .env.conveyor
DATABASE_URL=postgresql://news:PASSWORD@news-db:5432/news
PUBLISH_SLOTS=09:00,13:00,19:00
MAX_POSTS_PER_DAY=2
APPROVAL_TIMEOUT_HOURS=24
APPROVAL_ESCALATION_HOURS=48
