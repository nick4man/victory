# Postgres 15 + PostGIS 3.5 + pgvector, на Debian bookworm.
#
# Почему не postgis/postgis:15-3.5, как было раньше: тот образ собран на
# bullseye, а у bullseye 07.09.26 протух подписанный Release
# debian-security. apt-get update внутри сборки стал выходить с кодом 100,
# и джоб RSpec в CI перестал доходить до запуска спеков. Само это не
# чинится — окно протухания только растёт.
#
# Bookworm-варианта у postgis/postgis нет (в реестре только 15-3.5 и
# 15-3.5-alpine), поэтому берём официальный postgres:15-bookworm и ставим
# оба расширения из apt.postgresql.org — репозиторий, который базовый
# образ уже настроил и которому доверяет.
#
# Мажор PostgreSQL намеренно остаётся 15: этот же Dockerfile собирает
# прод-базу (docker-compose.yml) и dev-базу для bin/rb. Смена мажора
# потребовала бы dump/restore прода.
FROM postgres:15-bookworm

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      postgresql-15-postgis-3 \
      postgresql-15-postgis-3-scripts \
      postgresql-15-pgvector \
 && rm -rf /var/lib/apt/lists/*
