# Postgres 15 + PostGIS 3.5 + pgvector
#
# Built on the official postgis/postgis image (which auto-runs
# CREATE EXTENSION postgis on first init). pgvector is added via the
# apt.postgresql.org repo that the postgis base image already trusts.
FROM postgis/postgis:15-3.5

# `Acquire::Check-Valid-Until=false` — не косметика и не «отключим проверку».
# Базовый образ собран на Debian bullseye, а его security-репозиторий
# перестал обновляться: файл Release протух, и `apt-get update` на этом
# возвращает код 100. Сборка падала сама собой, по календарю, без единой
# правки в репозитории — 07.09.26 из-за этого покраснел main.
#
# Флаг велит apt не отвергать протухшие метаданные. Подписи при этом
# проверяются как обычно — отключается только проверка срока годности.
# Образ живёт минуты внутри CI-джоба, ставит один пакет и умирает вместе
# с ним, поэтому устаревший индекс безопасности здесь ничего не решает.
#
# Правильное лечение — база на bookworm вместо bullseye; сделать его нужно
# отдельно и с прогоном, потому что смена базы меняет версии PostGIS и
# локали, а на них завязаны спеки геопоиска.
RUN apt-get -o Acquire::Check-Valid-Until=false update \
 && apt-get install -y --no-install-recommends postgresql-15-pgvector \
 && rm -rf /var/lib/apt/lists/*
