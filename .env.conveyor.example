# Конвейер новостей (services/urgent-news-collector) в контейнере conveyor.
# Скопировать в .env.conveyor и заполнить. Значения — из /opt/victory-conveyor/.env
# на хосте chat (вне git); перенос описан в docs/runbooks/cutover-1.0.md.

# --- База конвейера: служба news-db в compose. Обе пары ключей смотрят в неё:
#     urgent_events (NEWS_DB_*) и posts_queue/system_flags (DB_*) с 1.0 живут
#     в одной базе, разделение на два инстанса было особенностью chat ---
NEWS_DB_HOST=news-db
NEWS_DB_PORT=5432
NEWS_DB_NAME=news
NEWS_DB_USER=news
NEWS_DB_PASSWORD=
DB_HOST=news-db
DB_PORT=5432
DB_NAME=news
DB_USER=news
DB_PASSWORD=

# --- LLM-шлюз. На chat это 127.0.0.1:20128; из контейнера на victory —
#     тот же адрес, что OMNIROUTE_BASE_URL в .env Rails ---
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
GEMINI_API_KEY=
GEMINI_EMBEDDING_API_KEY=
OPENROUTER_API_KEY=

# --- Зеркало на сайт: вебхук Rails изнутри docker-сети ---
VICTORY_NEWS_URL=http://web:3000/webhooks/news_ingest
VICTORY_NEWS_TOKEN=
MIRROR_SCRIPT=/opt/conveyor/mirror/post_news_to_victory.sh

# --- Модель и окна (дефолты в коде, менять не обязательно) ---
URGENT_COLLECTOR_MODEL=
URGENT_MAX_AGE_HOURS=
SEEN_HEADLINE_WINDOW_DAYS=

# --- Бесплатные LLM-цепочки (13.10.26, feat/conveyor-openrouter-free) ---
# Цепочки моделей — chains.json в образе; оверрайд автопробера лежит на
# постоянном томе state/ ($CONVEYOR_HOME/state/chains.json) и переживает
# rollout. В контейнере НЕТ фолбэка ключей на openclaw.json — все ключи
# только из этого файла. CLOUDFLARE_AI_* нужны звену cloudflare в цепочке:
#CLOUDFLARE_AI_BASE_URL=
#CLOUDFLARE_AI_API_KEY=
# Платный хвост (openrouter/anthropic/claude-sonnet-4) ограничен бюджетом:
#PAID_DAILY_LIMIT=5
#PAID_MONTHLY_LIMIT=20
# Пути state/логов/конфига (LLM_USAGE_LOG, PAID_BUDGET_STATE_PATH,
# CHAINS_JSON_PATH) не задавать — дефолты под $CONVEYOR_HOME верные.
# 🚨 URGENT_COLLECTOR_MODEL выше — не «добавить модель», а схлопнуть всю
# цепочку в один маршрут без фолбэка (07.09.26: 1950 новостей в NOISE).
