# Скопировать в .env рядом со скриптами и заполнить.
# .env в git не попадает (см. .gitignore) — в боевом каталоге он лежит
# в /opt/victory-conveyor/.env и переживает деплой.

# --- Где боевой каталог (логи, notifications, published, зеркало) ---
# По умолчанию /opt/victory-conveyor. Менять только если конвейер переехал.
CONVEYOR_HOME=/opt/victory-conveyor

# --- Продакшн-БД: очередь постов, системные флаги ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- База новостей: urgent_events, pgvector-эмбеддинги ---
# Если не заданы, код падает обратно на DB_* (см. urgent_collector.py).
NEWS_DB_HOST=localhost
NEWS_DB_PORT=5433
NEWS_DB_NAME=
NEWS_DB_USER=
NEWS_DB_PASSWORD=

# --- LLM-цепочка (по порядку обхода в complete_with_fallbacks) ---
GEMINI_API_KEY=
GEMINI_EMBEDDING_API_KEY=
CLOUDFLARE_AI_BASE_URL=
CLOUDFLARE_AI_API_KEY=
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
# Прямой OpenRouter: бесплатные модели классификатора и платный хвост цепочки
# (anthropic/claude-sonnet-4). Ставь месячный лимит расходов на самом ключе.
OPENROUTER_API_KEY=

# 🚨 URGENT_COLLECTOR_MODEL / URGENT_TRIGGER_MODEL / OMNIROUTE_MODEL здесь
# НЕ задавать. Они не «добавляют модель», а схлопывают всю цепочку
# MAIN_MODEL_CHAIN в один маршрут без фолбэка. Ровно так 07.09.26 конвейер
# встал на 4 дня: в .env прописали cc/claude-sonnet-4-5, у которого в
# omniroute нет кредов, и 1950 новостей ушли в NOISE без классификации.

# --- Зеркалирование на сайт ---
VICTORY_NEWS_URL=https://victory62.org/webhooks/news_ingest
VICTORY_NEWS_TOKEN=

# --- Telegram-публикация (weekly_digest_trigger, bank_rates_trigger) ---
# Раньше жили отдельным файлом в архиве openclaw
# (workspace/agents/content-publisher/.env) — с 11.09.26 всё в одном .env.
CHANNEL_BOT_TOKEN=
RZNVICTORY_CHANNEL=
OKSANA_CHAT_ID=
DARTAGNAN_CHAT_ID=
CHIEF_EDITOR_CHAT_ID=
DATABASE_URL=
PUBLISH_SLOTS=
MAX_POSTS_PER_DAY=
APPROVAL_TIMEOUT_HOURS=
APPROVAL_ESCALATION_HOURS=
