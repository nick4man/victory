# publisher-bot (services/content-publisher) — публикатор очереди posts_queue в Telegram.
# Скопировать в .env.publisher в корне репозитория. Значения — из
# workspace/agents/content-publisher/.env на хосте chat (вне git).

# Telegram: бот канала и чаты согласования
CHANNEL_BOT_TOKEN=
OKSANA_CHAT_ID=
DARTAGNAN_CHAT_ID=
CHIEF_EDITOR_CHAT_ID=
RZNVICTORY_CHANNEL=@rznvictory

# База очереди (posts_queue, content_revisions, system_flags) — служба news-db в compose
DATABASE_URL=postgresql://news:PASSWORD@news-db:5432/news

# Расписание публикаций (MSK) и лимиты
PUBLISH_SLOTS=09:00,13:00,19:00
MAX_POSTS_PER_DAY=2
APPROVAL_TIMEOUT_HOURS=24
APPROVAL_ESCALATION_HOURS=48
