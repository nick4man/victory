# Скопировать в .env рядом со скриптами и заполнить. .env в git не попадает
# (см. .gitignore).

# --- Куда отправлять наблюдения и с каким токеном ---
# Токен тот же, что ZHK_INGEST_TOKEN в Rails — реальное значение живёт там,
# здесь только форма. Прод: https://victory62.org
VICTORY_BASE_URL=
ZHK_INGEST_TOKEN=

# --- User-Agent будущего обхода внешних источников (ERZ и т.п.) ---
# Обход обязан быть представленным контактным адресом. Этой задачей ещё не
# используется — задел под сборщик (задачи 9-10).
CRAWLER_CONTACT=
