# Куда отправлять наблюдения и с каким токеном (тот же секрет, что
# ZHK_INGEST_TOKEN в Rails — .env.example там, а не здесь, задаёт реальное
# значение).
VICTORY_BASE_URL=https://victory62.org
ZHK_INGEST_TOKEN=

# Контакт в User-Agent для будущего обхода внешних источников (ERZ и
# т.п.) — обход обязан быть представленным. Этой задачей ещё не
# используется, задел под сборщик.
CRAWLER_CONTACT=info@victory62.org
