# Скопировать в .env рядом со скриптами и заполнить. .env в git не попадает
# (см. .gitignore).

# --- Куда отправлять наблюдения и с каким токеном ---
# Токен тот же, что ZHK_INGEST_TOKEN в Rails — реальное значение живёт там,
# здесь только форма. Прод: https://victory62.org
VICTORY_BASE_URL=
ZHK_INGEST_TOKEN=

# --- User-Agent обхода внешних источников (ЕРЗ, сайты застройщиков) ---
# Обход обязан быть представленным контактным адресом — уходит буквально
# в заголовок User-Agent (sources/base.py:polite_get). Без значения run.py
# подставит дефолт info@victory62.org.
CRAWLER_CONTACT=
