| {{ d.purchase_date }} | {{ "{:,.0f}".format(d.purchase_price / result.area_sqm).replace(",", " ") }} руб | {{ "+" if d.delta_pct > 0 else "" }}{{ d.delta_pct }}% | {{ "%.2f"|format(d.ei_at_that_time) }} |
{% endfor %}
{% if retro.developer_accuracy_pct is not none %}
**Точность прогнозов застройщика:** {{ "%.1f"|format(retro.developer_accuracy_pct) }}%
