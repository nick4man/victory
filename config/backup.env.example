# Образец конфигурации бэкапов. Реальный файл — /etc/victory-backup/backup.env
# (владелец q, 0600). Этот файл коммитится, реальный — никогда.
#
# Дизайн: docs/superpowers/specs/2026-08-09-backups-design.md

# Куда складывать локальные копии. ВАЖНО: subvol `/`, не `/home` — storage/
# живёт на /home, и копия рядом с оригиналом не защищает от потери тома.
BACKUP_ROOT=/var/backups/victory

# Прод: контейнер и база. RAILS_ENV=development в проде — это не опечатка,
# см. CLAUDE.md.
DB_CONTAINER=victory-db-1
DB_NAME=viktory_realty_development
DB_USER=postgres

# Корень приложения — источник storage/ и секретов.
APP_ROOT=/home/q/victory

# Файл с паролем gpg (владелец q, 0600). Копия пароля обязана лежать ВНЕ сервера:
# рядом с бэкапом он бесполезен, потерянный — делает копии нерасшифруемыми.
PASSPHRASE_FILE=/etc/victory-backup/passphrase

# Сколько копий держим.
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6

# Offsite. Пока нет ключей S3 — оставить 0: локальный слой работает без него.
OFFSITE_ENABLED=0
OFFSITE_REMOTE=victory-crypt:victory-backups

# Telegram: провалы шлём всегда, сводку — раз в неделю.
TELEGRAM_BOT_TOKEN=
TELEGRAM_STAFF_CHAT_ID=
