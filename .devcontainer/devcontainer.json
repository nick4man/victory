{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "victory62 (Rails 8.1 / Ruby 3.4.10 / PostGIS + pgvector)",

  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/victory",

  // Базу и Redis гасим вместе с Codespace — они одноразовые, данные в них
  // держать незачем.
  "shutdownAction": "stopCompose",

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  // SSH-сервер нужен `gh codespace ssh` / `gh codespace cp`: без него в
  // Codespace не зайти из терминала, только через VS Code в браузере, — а
  // агенту (Claude Code) отлаживать и гонять спеки нечем. Node — потому что
  // служебный агент Codespaces поднимает SSH через `node` внутри контейнера;
  // в slim-образе Rails его нет, и ssh висит на «exec: node: not found».
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },

  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Rails",
      "onAutoForward": "notify"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "Shopify.ruby-lsp",
        "castwide.solargraph",
        "misogi.ruby-rubocop",
        "bradlc.vscode-tailwindcss",
        "eamodio.gitlens"
      ],
      "settings": {
        "files.eol": "\n",
        "editor.formatOnSave": false,
        "ruby.rubocop.useBundler": true,
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  "remoteUser": "root"
}
