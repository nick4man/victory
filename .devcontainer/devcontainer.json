{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "victory62 (Rails 8.1 / Ruby 3.4.10 / PostGIS + pgvector)",

  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/victory",

  // Базу и Redis гасим вместе с Codespace — они одноразовые, данные в них
  // держать незачем.
  "shutdownAction": "stopCompose",

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Rails",
      "onAutoForward": "notify"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "Shopify.ruby-lsp",
        "castwide.solargraph",
        "misogi.ruby-rubocop",
        "bradlc.vscode-tailwindcss",
        "eamodio.gitlens"
      ],
      "settings": {
        "files.eol": "\n",
        "editor.formatOnSave": false,
        "ruby.rubocop.useBundler": true,
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  "remoteUser": "root"
}
