# Staging-окружение (compose-проект victory-staging). Боевой файл —
# /home/q/victory/.env.staging, в git НЕ коммитить. Все секреты генерируются
# заново, отдельно от продских: staging защищён basic-auth на Traefik, но
# это не повод размножать боевые ключи.

# --- Рельса ----------------------------------------------------------------
# Свой, НЕ продский: openssl rand -hex 64
SECRET_KEY_BASE=
# Свой, НЕ продский: openssl rand -hex 24. Нужен bin/smoke (admin health).
ADMIN_TOKEN=

APP_DOMAIN=staging.dev.victory62.org
APP_URL=https://staging.dev.victory62.org

# --- Compose-интерполяция базового docker-compose.yml ----------------------
# Эти переменные читает сам compose (--env-file .env.staging), до контейнера.
WEB_PORT=3002
# 0.0.0.0 — пока Traefik роутера ходит с другого адреса; сужение до
# внутреннего интерфейса — отдельная задача (архитектурный документ, раздел 7).
WEB_BIND=0.0.0.0
# Свой storage: продские клиентские документы на staging не монтируем.
STORAGE_DIR=/home/q/victory-staging-storage

# --- БД staging (свой контейнер victory-staging-db-1) ----------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=viktory_realty_staging
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=viktory_realty_staging
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

REDIS_URL=redis://redis:6379/0

# --- Внешние интеграции ВЫКЛЮЧЕНЫ явными заглушками -------------------------
# Классы требуют непустые значения уже при загрузке приложения; значения
# намеренно «не-токенные», чтобы не срабатывал secret-scan и чтобы в логах
# было видно, что интеграция выключена.
TELEGRAM_BOT_TOKEN=disabled-in-staging
OMNIROUTE_BASE_URL=http://llm.invalid/v1
OMNIROUTE_API_KEY=disabled-in-staging
TOPNLAB_API_KEY=disabled-in-staging
SMTP_PASSWORD=disabled-in-staging
ZHK_INGEST_TOKEN=disabled-in-staging
SENTRY_DSN=
