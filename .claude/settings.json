{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(rclone delete *)",
      "Bash(rclone deletefile *)",
      "Bash(rclone purge *)",
      "Edit(//home/q/victory/**)",
      "Write(//home/q/victory/**)",
      "Bash(./sync-check.sh:*)",
      "Bash(bash sync-check.sh:*)",
      "Bash(sh sync-check.sh:*)",
      "Bash(services/urgent-news-collector/sync-check.sh:*)",
      "Bash(./upstream-sync.sh:*)",
      "Bash(bash upstream-sync.sh:*)",
      "Bash(services/audit-engine/upstream-sync.sh:*)",
      "Write(/opt/.openclaw/.openclaw/**)",
      "Edit(/opt/.openclaw/.openclaw/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-edit-lock.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-lock.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/plan-sync.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-rubocop.sh"
          }
        ]
      }
    ]
  }
}
