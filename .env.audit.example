# Audit-engine sidecar configuration. Copy to .env.audit (in .gitignore).
#
# All variables are loaded by docker-compose.audit.yml via env_file directive.
# The AUDIT_DB_PASSWORD must also be available as a docker-compose interpolation
# var, so it is referenced from the same .env.audit (compose reads both).

# Postgres credentials for the audit-engine's own database (re_audit).
# Generate with: openssl rand -hex 24
AUDIT_DB_PASSWORD=

# Comma-separated list of Bearer tokens accepted by the engine API.
# When set, requests must send `X-Audit-Token: <one-of-them>` or
# `Authorization: Bearer <one-of-them>`. If empty, auth is DISABLED
# (backwards-compat mode in upstream — do NOT use in production).
#
# Generate one per consumer with: openssl rand -hex 32
AUDIT_API_TOKENS=

# Disable Nextcloud upload of PDF reports (engine default tries to upload
# via rclone). Our victory62 deployment does not have that remote configured.
NEXTCLOUD_AUTO_UPLOAD=false

# CB РФ macro data: engine pulls via APScheduler cron. If your network blocks
# https://cbr.ru, set a proxy or pre-populate the `macro_data` table manually.
# (No env override needed by default — leave commented unless your CB-RF
# scraper needs auth.)
# CBR_PROXY_URL=

# Optional: override the default working directory for generated PDFs.
# AUDIT_REPORTS_DIR=/app/reports
