<% content_for :title, 'Партнёрский портал — Вход — АН Виктори' %>

<section class="px-6 lg:px-12 py-16 lg:py-24 bg-background min-h-screen">
  <div class="max-w-md mx-auto">
    <p class="text-xs tracking-[0.3em] text-muted-foreground uppercase mb-3">Портал партнёра</p>
    <h1 class="text-3xl lg:text-4xl font-light tracking-tight text-foreground mb-3">
      Вход для агентств
    </h1>
    <p class="text-sm text-muted-foreground leading-relaxed mb-8">
      Раздел для агентств-партнёров АН «Виктори». Здесь вы видите лиды,
      переданные нами на ваши объекты, и статус каждой передачи.
    </p>

    <%= form_with url: partners_request_link_path, method: :post, local: true, class: 'space-y-5' do %>
      <div>
        <label class="text-xs tracking-[0.3em] text-muted-foreground mb-2 block uppercase">
          Email агентства
        </label>
        <%= email_field_tag :email, @email_prefill, required: true,
              class: 'w-full bg-transparent border-b border-border focus:border-foreground focus:outline-none text-foreground py-2',
              placeholder: 'partner@example.com' %>
      </div>

      <%= submit_tag 'Отправить ссылку',
            class: 'w-full px-6 py-3 bg-foreground text-background text-xs tracking-[0.3em] uppercase hover:bg-foreground/90 transition-colors cursor-pointer' %>
    <% end %>

    <p class="text-[10px] text-muted-foreground/60 mt-8 leading-relaxed">
      Email должен совпадать с зарегистрированным у нас (settings → contact_email).
      Если ваше агентство ещё не в нашей сети — свяжитесь с менеджером АН «Виктори»
      для подключения.
    </p>
  </div>
</section>
