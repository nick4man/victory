<% content_for :title, "Портал партнёра — #{@partner_agency.name}" %>

<section class="px-6 lg:px-12 py-12 bg-background">
  <div class="max-w-6xl mx-auto">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-10">
      <div>
        <p class="text-xs tracking-[0.3em] text-muted-foreground uppercase mb-2">Партнёрский портал</p>
        <h1 class="text-3xl lg:text-4xl font-light tracking-tight text-foreground">
          <%= @partner_agency.name %>
        </h1>
        <p class="text-xs text-muted-foreground mt-2">
          <%= @partner_agency.contact_email.presence || @partner_agency.slug %>
          <% if @partner_agency.default_commission_rate %>
            · базовая ставка: <%= (@partner_agency.default_commission_rate * 100).to_i %>%
          <% end %>
        </p>
      </div>
      <%= button_to 'Выйти', partners_logout_path, method: :delete,
            class: 'text-xs tracking-[0.3em] uppercase text-muted-foreground hover:text-foreground underline-offset-4 hover:underline transition-colors' %>
    </div>

    <%# Финансы — главное что хочет видеть партнёр %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-10">
      <div class="border border-emerald-500/40 bg-emerald-500/5 px-5 py-4">
        <p class="text-[10px] tracking-[0.2em] uppercase text-muted-foreground">Получено</p>
        <p class="text-3xl font-light text-foreground mt-1">
          <%= number_with_delimiter(@earned.to_i, delimiter: ' ') %> ₽
        </p>
      </div>
      <div class="border border-amber-500/40 bg-amber-500/5 px-5 py-4">
        <p class="text-[10px] tracking-[0.2em] uppercase text-muted-foreground">В ожидании</p>
        <p class="text-3xl font-light text-foreground mt-1">
          ≈ <%= number_with_delimiter(@pending.to_i, delimiter: ' ') %> ₽
        </p>
      </div>
    </div>

    <%# Counts strip %>
    <div class="grid grid-cols-3 md:grid-cols-6 gap-3 mb-10">
      <% [
        [:all, 'Всего'], [:pending, '⏳ Ожид'], [:forwarded, '↗ Передано'],
        [:in_progress, '⚙ В работе'], [:closed_won, '✓ Закрыто'], [:closed_lost, '✗ Отказ']
      ].each do |key, label| %>
        <%= link_to partners_path(status: key == :all ? nil : key.to_s),
              class: "border border-border bg-card px-3 py-2 #{params[:status].to_s == key.to_s || (key == :all && params[:status].blank?) ? 'border-foreground' : ''}" do %>
          <p class="text-[10px] tracking-[0.2em] uppercase text-muted-foreground"><%= label %></p>
          <p class="text-xl font-light text-foreground mt-1"><%= @counts[key] %></p>
        <% end %>
      <% end %>
    </div>

    <%# Referrals list %>
    <% if @referrals.empty? %>
      <div class="border border-border bg-card p-8 text-center">
        <p class="text-sm text-muted-foreground">
          Пока нет переданных лидов. Они появятся здесь когда покупатель оставит
          заявку через наш сайт на один из ваших объектов.
        </p>
      </div>
    <% else %>
      <div class="space-y-3">
        <% @referrals.each do |r| %>
          <%
            inq = r.inquiry
            el  = r.external_listing
            status_css = case r.status
                        when 'pending'     then 'border-amber-500/40 text-amber-200'
                        when 'forwarded',
                             'in_progress' then 'border-blue-500/40 text-blue-200'
                        when 'closed_won'  then 'border-emerald-500/40 text-emerald-200'
                        when 'closed_lost' then 'border-rose-500/40 text-rose-200'
                        else 'border-border text-muted-foreground'
                        end
          %>
          <article class="border border-border bg-card p-5 grid grid-cols-1 lg:grid-cols-[140px_2fr_1fr] gap-4 items-start">
            <div>
              <span class="inline-block px-2 py-1 text-[10px] tracking-[0.2em] uppercase border <%= status_css %>">
                <%= r.status %>
              </span>
              <p class="text-[10px] text-muted-foreground/70 uppercase mt-2 tracking-[0.2em]">
                <%= I18n.l(r.created_at, format: '%d.%m.%y') rescue r.created_at.to_date %>
              </p>
            </div>
            <div>
              <% if inq %>
                <p class="text-sm text-foreground mb-1">
                  <%= inq.name.presence || 'Клиент' %>
                  <% if r.forwarded_at && inq.phone.present? %>
                    <span class="text-muted-foreground">· <%= inq.phone %></span>
                  <% end %>
                </p>
              <% end %>
              <% if el %>
                <p class="text-xs text-muted-foreground truncate">
                  <%= el.title.to_s.truncate(90) %>
                </p>
                <p class="text-[11px] text-muted-foreground/70 mt-0.5">
                  <%= el.address.to_s.truncate(80) %>
                </p>
              <% end %>
            </div>
            <div class="text-right">
              <% if r.final_commission_amount.present? %>
                <p class="text-sm text-emerald-300">
                  <%= number_with_delimiter(r.final_commission_amount.to_i, delimiter: ' ') %> ₽
                </p>
                <p class="text-[10px] text-muted-foreground/70">фактически</p>
              <% elsif r.estimated_commission.to_f.positive? %>
                <p class="text-sm text-foreground">
                  ≈ <%= number_with_delimiter(r.estimated_commission.to_i, delimiter: ' ') %> ₽
                </p>
                <p class="text-[10px] text-muted-foreground/70">
                  <% if r.commission_rate %><%= (r.commission_rate * 100).to_i %>% от цены<% end %>
                </p>
              <% end %>
            </div>
          </article>
        <% end %>
      </div>

      <% if @referrals.respond_to?(:total_pages) && @referrals.total_pages > 1 %>
        <div class="mt-10 flex justify-center">
          <%= paginate @referrals, theme: 'plain' rescue nil %>
        </div>
      <% end %>
    <% end %>

    <p class="text-xs text-muted-foreground/60 mt-10 leading-relaxed max-w-2xl">
      Все статус-изменения вносит АН «Виктори». Если хотите подтвердить получение
      лида / закрытие сделки — напишите вашему менеджеру (контакт — в подписанном
      соглашении). Здесь — только для просмотра.
    </p>
  </div>
</section>
