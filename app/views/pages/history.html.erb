<% content_for :title, "История компании" %>

<div class="bg-white">
  <!-- Hero section -->
  <div class="relative bg-gradient-to-r from-primary-600 to-primary-800 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
          История компании
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-xl text-primary-100">
          Более 14 лет на рынке недвижимости
        </p>
      </div>
    </div>
  </div>

  <!-- Timeline -->
  <div class="py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="relative">
        <!-- Vertical line -->
        <div class="absolute left-1/2 transform -translate-x-px h-full w-0.5 bg-primary-200"></div>

        <div class="space-y-12">
          <% @timeline.each_with_index do |event, index| %>
          <div class="relative flex items-start <%= index.even? ? 'flex-row' : 'flex-row-reverse' %>">
            <!-- Content -->
            <div class="w-5/12 <%= index.even? ? 'text-right pr-8' : 'text-left pl-8' %>">
              <div class="bg-white border border-gray-200 rounded-lg p-5 shadow-sm hover:shadow-md transition">
                <span class="inline-block px-3 py-1 bg-primary-100 text-primary-700 text-sm font-bold rounded-full mb-2">
                  <%= event[:year] %>
                </span>
                <h3 class="text-lg font-semibold text-gray-900"><%= event[:title] %></h3>
                <p class="mt-2 text-gray-500 text-sm"><%= event[:description] %></p>
              </div>
            </div>

            <!-- Circle dot -->
            <div class="absolute left-1/2 transform -translate-x-1/2 flex items-center justify-center">
              <div class="h-4 w-4 rounded-full bg-primary-500 border-2 border-white shadow"></div>
            </div>

            <!-- Empty side -->
            <div class="w-5/12"></div>
          </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- CTA -->
  <div class="bg-gray-50 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-lg bg-primary-700 px-6 py-12 text-center sm:px-12">
        <h2 class="text-3xl font-extrabold text-white">
          Стань частью нашей истории
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-lg text-primary-100">
          Тысячи клиентов уже доверились нам. Присоединяйтесь!
        </p>
        <div class="mt-8 flex justify-center gap-4">
          <%= link_to properties_path, class: "inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-primary-700 bg-white hover:bg-primary-50" do %>
            Смотреть каталог
          <% end %>
          <%= link_to contacts_path, class: "inline-flex items-center px-6 py-3 border border-white text-base font-medium rounded-md text-white hover:bg-primary-600" do %>
            Связаться с нами
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
