<%
  # Public services catalog backed by ServiceType (db/seeds/service_types.rb).
  # CTA buttons open a modal that submits to /forms/service_request → creates Inquiry.
  icon_paths = {
    'banknotes' => %(<rect x="6" y="14" width="36" height="20" rx="1" stroke="currentColor" stroke-width="1.5" fill="none"/><circle cx="24" cy="24" r="6" stroke="currentColor" stroke-width="1.5" fill="none"/><line x1="6" y1="20" x2="42" y2="20" stroke="currentColor" stroke-width="1"/>),
    'scale'     => %(<line x1="24" y1="8" x2="24" y2="40" stroke="currentColor" stroke-width="1.5"/><line x1="14" y1="40" x2="34" y2="40" stroke="currentColor" stroke-width="1.5"/><circle cx="24" cy="14" r="2" fill="currentColor"/><path d="M14 22L8 32L20 32L14 22Z" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M34 22L28 32L40 32L34 22Z" stroke="currentColor" stroke-width="1.5" fill="none"/>),
    'chart'     => %(<line x1="8" y1="40" x2="40" y2="40" stroke="currentColor" stroke-width="1.5"/><line x1="8" y1="8" x2="8" y2="40" stroke="currentColor" stroke-width="1.5"/><polyline points="12 32 18 24 24 28 32 18 40 14" stroke="currentColor" stroke-width="1.5" fill="none"/>),
    'clipboard' => %(<rect x="12" y="10" width="24" height="32" rx="1" stroke="currentColor" stroke-width="1.5" fill="none"/><rect x="18" y="6" width="12" height="6" stroke="currentColor" stroke-width="1.5" fill="none"/><line x1="16" y1="20" x2="32" y2="20" stroke="currentColor" stroke-width="1"/><line x1="16" y1="26" x2="32" y2="26" stroke="currentColor" stroke-width="1"/><line x1="16" y1="32" x2="28" y2="32" stroke="currentColor" stroke-width="1"/>),
    'megaphone' => %(<path d="M10 20L36 12L36 36L10 28Z" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M10 20L10 28L14 32L14 18Z" stroke="currentColor" stroke-width="1.5" fill="none"/><line x1="36" y1="20" x2="42" y2="18" stroke="currentColor" stroke-width="1"/><line x1="36" y1="24" x2="42" y2="24" stroke="currentColor" stroke-width="1"/><line x1="36" y1="28" x2="42" y2="30" stroke="currentColor" stroke-width="1"/>),
    'key'       => %(<circle cx="16" cy="24" r="8" stroke="currentColor" stroke-width="1.5" fill="none"/><line x1="24" y1="24" x2="40" y2="24" stroke="currentColor" stroke-width="1.5"/><line x1="34" y1="24" x2="34" y2="30" stroke="currentColor" stroke-width="1.5"/><line x1="40" y1="24" x2="40" y2="32" stroke="currentColor" stroke-width="1.5"/>)
  }
%>

<% content_for :title, "Услуги — АН Виктори" %>

<%# Service ItemList — declares each line of business as a Schema.org
    Service entity linked to the agency via provider.@id. Drives the
    services-grid rich snippet that Google shows for business queries
    like "услуги риэлтора Рязань", and Yandex uses for its sidebar card. %>
<% content_for :head do %>
  <% services_catalog = [
    { name: 'Ипотека и кредитование',         service_type: 'FinancialService',  description: 'Подбор ипотечной программы, сбор документов, помощь с одобрением банка.' },
    { name: 'Юридическое сопровождение',       service_type: 'LegalService',      description: 'Проверка чистоты сделки, подготовка договора, регистрация перехода права.' },
    { name: 'Профессиональная оценка',          service_type: 'AssessmentService', description: 'Онлайн-оценка квартиры или дома по рыночным аналогам.' },
    { name: 'Технический осмотр объекта',       service_type: 'InspectionService', description: 'Выезд эксперта на объект для оценки технического состояния.' },
    { name: 'Помощь в продаже',                 service_type: 'BrokerageService',  description: 'Подготовка объекта к продаже, маркетинг, показы, переговоры.' },
    { name: 'Подбор арендатора',                service_type: 'BrokerageService',  description: 'Поиск и проверка арендаторов, заключение договора аренды.' }
  ] %>
  <script type="application/ld+json">
  <%= raw({
    '@context' => 'https://schema.org',
    '@type' => 'ItemList',
    'name' => 'Услуги АН Виктори',
    'itemListElement' => services_catalog.each_with_index.map { |svc, i|
      {
        '@type' => 'ListItem',
        'position' => i + 1,
        'item' => {
          '@type' => 'Service',
          'name' => svc[:name],
          'description' => svc[:description],
          'serviceType' => svc[:service_type],
          'provider' => { '@id' => "#{AgencyInfo::WEBSITE_URL}/#agent" },
          'areaServed' => [
            { '@type' => 'City', 'name' => AgencyInfo::ADDRESS_CITY },
            { '@type' => 'AdministrativeArea', 'name' => AgencyInfo::ADDRESS_REGION }
          ]
        }
      }
    }
  }.to_json) %>
  </script>
<% end %>

<section class="px-6 lg:px-12 pt-32 pb-12 bg-background">
  <div class="max-w-6xl mx-auto">
    <p class="text-sm tracking-[0.4em] text-muted-foreground mb-4">УСЛУГИ</p>
    <h1 class="text-4xl lg:text-5xl font-light tracking-wide text-foreground mb-6">Комплексное сопровождение</h1>
    <p class="text-base text-muted-foreground leading-relaxed max-w-3xl">
      От подбора объекта и ипотеки до юридического сопровождения и помощи в продаже —
      все услуги под одной крышей с командой экспертов.
    </p>
  </div>
</section>

<section class="px-6 lg:px-12 pb-24 bg-background">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-border">
      <% @services.each do |service| %>
        <article class="bg-background p-8 flex flex-col">
          <div class="mb-6">
            <svg viewBox="0 0 48 48" fill="none" class="w-12 h-12 text-foreground">
              <%= (icon_paths[service.icon] || icon_paths['clipboard']).html_safe %>
            </svg>
          </div>
          <h3 class="text-lg font-medium text-foreground mb-3"><%= service.title %></h3>
          <p class="text-sm text-muted-foreground leading-relaxed mb-6 flex-1"><%= service.description %></p>
          <% if service.target_path.present? %>
            <%= link_to service.target_path,
                  class: "self-start inline-flex items-center gap-2 px-5 py-2 border border-foreground text-foreground hover:bg-foreground hover:text-background transition-colors text-sm" do %>
              <%= service.cta_label.presence || 'Подробнее' %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            <% end %>
          <% else %>
            <button type="button"
                    data-service-request="<%= service.slug %>"
                    data-service-title="<%= service.title %>"
                    class="self-start inline-flex items-center gap-2 px-5 py-2 border border-foreground text-foreground hover:bg-foreground hover:text-background transition-colors text-sm">
              <%= service.cta_label.presence || 'Подать заявку' %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>
          <% end %>
        </article>
      <% end %>
    </div>

    <% if @services.empty? %>
      <div class="bg-card border border-border p-12 text-center text-muted-foreground">
        Каталог услуг временно пуст. <%= link_to 'Свяжитесь с нами напрямую', contacts_path, class: 'text-foreground underline' %>.
      </div>
    <% end %>
  </div>
</section>

<!-- Service request modal -->
<div data-service-modal class="hidden fixed inset-0 z-50 flex items-center justify-center bg-foreground/40 backdrop-blur-sm px-4">
  <div class="bg-background border border-border max-w-md w-full p-8 relative">
    <button type="button" data-service-modal-close
            class="absolute top-4 right-4 text-muted-foreground hover:text-foreground transition-colors">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>

    <p class="text-xs tracking-[0.3em] text-muted-foreground mb-2">ЗАЯВКА</p>
    <h3 class="text-2xl font-light tracking-wide text-foreground mb-6" data-service-modal-title>—</h3>

    <%= form_with url: forms_service_request_path, method: :post, local: true, class: "space-y-4", data: { service_modal_form: true } do |f| %>
      <%= f.hidden_field :service_slug, data: { service_modal_slug: true } %>
      <input type="text" name="name" required placeholder="Ваше имя"
             class="w-full h-11 px-4 bg-background border border-border text-foreground placeholder:text-muted-foreground focus:border-foreground focus:outline-none transition-colors">
      <input type="tel" name="phone" required placeholder="+7 (___) ___-__-__"
             class="w-full h-11 px-4 bg-background border border-border text-foreground placeholder:text-muted-foreground focus:border-foreground focus:outline-none transition-colors">
      <input type="email" name="email" placeholder="email@example.com (необязательно)"
             class="w-full h-11 px-4 bg-background border border-border text-foreground placeholder:text-muted-foreground focus:border-foreground focus:outline-none transition-colors">
      <textarea name="message" rows="3" placeholder="Комментарий (необязательно)"
                class="w-full px-4 py-3 bg-background border border-border text-foreground placeholder:text-muted-foreground focus:border-foreground focus:outline-none transition-colors"></textarea>
      <button type="submit" class="w-full h-11 bg-foreground text-background hover:bg-foreground/90 transition-colors text-sm">
        Отправить заявку
      </button>
      <p class="text-xs text-muted-foreground">
        Нажимая «Отправить», вы соглашаетесь с
        <%= link_to 'политикой конфиденциальности', privacy_path, target: '_blank', class: 'underline hover:text-foreground' %>.
      </p>
    <% end %>
  </div>
</div>

<script>
  (function () {
    const modal = document.querySelector('[data-service-modal]');
    if (!modal) return;
    const titleEl = modal.querySelector('[data-service-modal-title]');
    const slugEl = modal.querySelector('[data-service-modal-slug]');
    const closeEl = modal.querySelector('[data-service-modal-close]');

    function open(slug, title) {
      titleEl.textContent = title;
      slugEl.value = slug;
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
    function close() {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }
    document.querySelectorAll('[data-service-request]').forEach(btn => {
      btn.addEventListener('click', () => open(btn.dataset.serviceRequest, btn.dataset.serviceTitle));
    });
    closeEl.addEventListener('click', close);
    modal.addEventListener('click', e => { if (e.target === modal) close(); });
    document.addEventListener('keydown', e => { if (e.key === 'Escape' && !modal.classList.contains('hidden')) close(); });
  })();
</script>
