<% content_for :title, "FAQ — АН Виктори" %>

<section class="px-6 lg:px-12 py-24 lg:py-32 bg-background">
  <div class="max-w-3xl mx-auto">
    <p class="text-sm tracking-[0.4em] text-muted-foreground mb-4">ВОПРОСЫ И ОТВЕТЫ</p>
    <h1 class="text-4xl lg:text-5xl font-light tracking-wider text-foreground mb-16">FAQ</h1>

    <div class="flex flex-col">
      <% [
        ["Как происходит покупка квартиры через ваше агентство?", "Подбираем объекты по вашим критериям, организуем показы, проверяем юридическую чистоту, сопровождаем сделку до получения ключей."],
        ["Сколько стоят ваши услуги?",                              "Комиссия — 3% от стоимости сделки при покупке. Онлайн-оценка и первичная консультация — бесплатно."],
        ["Работаете ли с ипотекой?",                                "Да. Помогаем подобрать программу, собрать документы и получить одобрение банка."],
        ["Можно ли посмотреть объект онлайн?",                      "Да, мы организуем 3D-тур или видеосвязь с агентом прямо на объекте."],
        ["Как быстро вы подбираете объект?",                        "В среднем — 7–14 дней с момента вашей заявки. Точные сроки зависят от сегмента."]
      ].each_with_index do |(q, a), i| %>
        <details class="group border-t border-border <%= 'border-b' if i == 4 %>">
          <summary class="flex items-center justify-between py-6 cursor-pointer list-none">
            <span class="text-base tracking-wider text-foreground pr-8"><%= q %></span>
            <svg class="w-5 h-5 text-muted-foreground group-open:rotate-45 transition-transform shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
          </summary>
          <p class="pb-6 text-sm text-muted-foreground leading-relaxed pr-8"><%= a %></p>
        </details>
      <% end %>
    </div>
  </div>
</section>
