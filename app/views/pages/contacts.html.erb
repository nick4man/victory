<% content_for :title, "Контакты — АН Виктори" %>

<%# Schema.org LocalBusiness with parking, accessibility, and payment hints
    — extends the global RealEstateAgent JSON-LD with /contacts-specific
    facts that Google uses for local-pack 3-pack eligibility (separate
    from agency-wide rankings). hasMap points to the embedded map service
    so the entity links to actual map data. %>
<% content_for :head do %>
  <script type="application/ld+json">
  <%= raw({
    '@context'      => 'https://schema.org',
    '@type'         => 'RealEstateAgent',
    '@id'           => "#{AgencyInfo::WEBSITE_URL}/contacts#localbusiness",
    'name'          => AgencyInfo::NAME,
    'image'         => "#{request.protocol}#{request.host_with_port}/og-default.jpg",
    'url'           => "#{AgencyInfo::WEBSITE_URL}/contacts",
    'telephone'     => [AgencyInfo::PHONE_PRIMARY, AgencyInfo::PHONE_BACKUP].compact,
    'email'         => AgencyInfo::EMAIL,
    'priceRange'    => '₽₽',
    'address' => {
      '@type'           => 'PostalAddress',
      'streetAddress'   => AgencyInfo::ADDRESS_STREET,
      'addressLocality' => AgencyInfo::ADDRESS_CITY,
      'addressRegion'   => AgencyInfo::ADDRESS_REGION,
      'postalCode'      => AgencyInfo::ADDRESS_ZIP,
      'addressCountry'  => 'RU'
    },
    'geo' => {
      '@type'    => 'GeoCoordinates',
      'latitude' => AgencyInfo::GEO_LAT,
      'longitude'=> AgencyInfo::GEO_LNG
    },
    'hasMap' => "https://yandex.ru/maps/?ll=#{AgencyInfo::GEO_LNG},#{AgencyInfo::GEO_LAT}&z=17",
    'openingHoursSpecification' => [
      { '@type' => 'OpeningHoursSpecification', 'dayOfWeek' => %w[Monday Tuesday Wednesday Thursday Friday], 'opens' => '09:00', 'closes' => '21:00' },
      { '@type' => 'OpeningHoursSpecification', 'dayOfWeek' => %w[Saturday Sunday],                          'opens' => '10:00', 'closes' => '19:00' }
    ],
    'paymentAccepted'      => 'Наличные, банковский перевод, банковская карта, ипотека',
    'currenciesAccepted'   => 'RUB',
    'isAccessibleForFree'  => true,
    'publicAccess'         => true,
    'areaServed' => [
      { '@type' => 'City',                'name' => AgencyInfo::ADDRESS_CITY },
      { '@type' => 'AdministrativeArea',  'name' => AgencyInfo::ADDRESS_REGION }
    ],
    'amenityFeature' => [
      { '@type' => 'LocationFeatureSpecification', 'name' => 'Парковка для клиентов', 'value' => true },
      { '@type' => 'LocationFeatureSpecification', 'name' => 'Бесплатная консультация', 'value' => true },
      { '@type' => 'LocationFeatureSpecification', 'name' => 'Сопровождение сделки',  'value' => true }
    ]
  }.to_json) %>
  </script>
<% end %>

<section class="px-6 lg:px-12 py-24 lg:py-32 bg-background">
  <div class="max-w-5xl mx-auto">
    <p class="text-sm tracking-[0.4em] text-muted-foreground mb-4">КОНТАКТЫ</p>
    <h1 class="text-4xl lg:text-5xl font-light tracking-wider text-foreground mb-16">СВЯЖИТЕСЬ С НАМИ</h1>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      <div class="flex flex-col gap-8">
        <div>
          <p class="text-xs tracking-[0.3em] text-muted-foreground mb-3">ТЕЛЕФОНЫ</p>
          <a href="<%= agency_phone_tel %>" class="block text-2xl font-light tracking-wider text-foreground hover:text-muted-foreground transition-colors"><%= agency_phone_primary %></a>
          <a href="<%= agency_phone_tel(agency_phone_backup) %>" class="block mt-2 text-lg tracking-wider text-muted-foreground hover:text-foreground transition-colors"><%= agency_phone_backup %></a>
        </div>
        <div>
          <p class="text-xs tracking-[0.3em] text-muted-foreground mb-3">EMAIL</p>
          <a href="mailto:<%= agency_email %>" class="text-lg tracking-wider text-foreground hover:text-muted-foreground transition-colors"><%= agency_email %></a>
        </div>
        <div>
          <p class="text-xs tracking-[0.3em] text-muted-foreground mb-3">АДРЕС</p>
          <p class="text-base tracking-wider text-foreground">г. <%= AgencyInfo::ADDRESS_CITY %>, <%= AgencyInfo::ADDRESS_STREET %></p>
          <p class="text-base tracking-wider text-muted-foreground"><%= AgencyInfo::ADDRESS_REGION %>, <%= AgencyInfo::ADDRESS_ZIP %></p>
        </div>
        <div>
          <p class="text-xs tracking-[0.3em] text-muted-foreground mb-3">РЕЖИМ РАБОТЫ</p>
          <p class="text-base tracking-wider text-foreground">Пн–Пт: 9:00 – 21:00</p>
          <p class="text-base tracking-wider text-foreground">Сб–Вс: 10:00 – 19:00</p>
          <p class="text-xs tracking-wider text-muted-foreground/80 mt-1">МСК</p>
        </div>
      </div>

      <%= form_with url: send_contact_form_path, method: :post, class: "flex flex-col gap-6" do |f| %>
        <div>
          <label class="text-xs tracking-[0.3em] text-muted-foreground mb-3 block">ИМЯ</label>
          <%= f.text_field :name, required: true, class: "w-full bg-transparent border-b border-border py-3 text-foreground tracking-wider focus:border-foreground focus:outline-none transition-colors" %>
        </div>
        <div>
          <label class="text-xs tracking-[0.3em] text-muted-foreground mb-3 block">ТЕЛЕФОН</label>
          <%= f.telephone_field :phone, required: true, class: "w-full bg-transparent border-b border-border py-3 text-foreground tracking-wider focus:border-foreground focus:outline-none transition-colors" %>
        </div>
        <div>
          <label class="text-xs tracking-[0.3em] text-muted-foreground mb-3 block">EMAIL</label>
          <%= f.email_field :email, class: "w-full bg-transparent border-b border-border py-3 text-foreground tracking-wider focus:border-foreground focus:outline-none transition-colors" %>
        </div>
        <div>
          <label class="text-xs tracking-[0.3em] text-muted-foreground mb-3 block">СООБЩЕНИЕ</label>
          <%= f.text_area :message, rows: 4, class: "w-full bg-transparent border-b border-border py-3 text-foreground tracking-wider focus:border-foreground focus:outline-none transition-colors resize-none" %>
        </div>
        <%= f.submit "ОТПРАВИТЬ", class: "self-start mt-4 px-8 py-4 text-sm tracking-[0.3em] bg-foreground text-background hover:bg-foreground/90 transition-colors cursor-pointer" %>
      <% end %>
    </div>
  </div>
</section>

<%# Local FAQ block — emits Schema.org FAQPage JSON-LD alongside the
    visible <details> accordion, so /contacts becomes eligible for rich
    snippets on Q-and-A queries like "часы работы агентство недвижимости
    Рязань", "комиссия АН Виктори". %>
<section class="px-6 lg:px-12 py-16 lg:py-24 bg-background border-t border-border">
  <div class="max-w-3xl mx-auto">
    <h2 class="text-2xl lg:text-3xl font-light tracking-wider text-foreground mb-8 uppercase">Частые вопросы</h2>
    <%= faq_section([
      ['Где находится офис АН Виктори в Рязани?',
       'Наш офис расположен по адресу: г. Рязань, ул. Горького, 86. Вход со двора. Парковка для клиентов есть рядом.'],
      ['В каком режиме работаете?',
       'Понедельник–пятница: с 9:00 до 21:00. Суббота–воскресенье: с 10:00 до 19:00. Время московское. Звонок и приём по записи.'],
      ['Можно ли вызвать агента на объект?',
       'Да. Выезд агента по Рязани и ближнему пригороду бесплатно. По области — по согласованию.'],
      ['Сколько стоит первичная консультация?',
       'Первичная консультация по подбору, оценке или ипотечной программе — бесплатно, без обязательств.'],
      ['Как с вами связаться вне рабочего времени?',
       'Оставьте заявку через форму на сайте или мессенджер на номере +7-920-978-05-08 — перезвоним в начале следующего рабочего часа.']
    ]) %>
  </div>
</section>
