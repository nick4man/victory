<% content_for :title, "Наша команда" %>

<div class="bg-white">
  <!-- Hero section -->
  <div class="relative bg-gradient-to-r from-primary-600 to-primary-800 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
          Наша команда
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-xl text-primary-100">
          Профессиональные агенты, которым можно доверять
        </p>
      </div>
    </div>
  </div>

  <!-- Agents grid -->
  <div class="py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <% if @agents.any? %>
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          <% @agents.each do |agent| %>
          <div class="bg-white border border-gray-200 rounded-lg overflow-hidden hover:shadow-lg transition">
            <div class="h-48 bg-gradient-to-br from-primary-400 to-primary-600 flex items-center justify-center">
              <span class="text-6xl text-white font-bold"><%= agent.first_name&.first&.upcase || '?' %></span>
            </div>
            <div class="p-6">
              <h3 class="text-lg font-semibold text-gray-900"><%= agent.full_name %></h3>
              <p class="text-sm text-primary-600 mt-1">Агент по недвижимости</p>
              <% if agent.phone.present? %>
              <p class="mt-3 text-sm text-gray-600">
                <span class="font-medium">Телефон:</span>
                <a href="tel:<%= agent.phone.gsub(/\D/, '') %>" class="text-primary-600 hover:underline"><%= agent.phone %></a>
              </p>
              <% end %>
              <% if agent.email.present? %>
              <p class="mt-1 text-sm text-gray-600">
                <span class="font-medium">Email:</span>
                <a href="mailto:<%= agent.email %>" class="text-primary-600 hover:underline"><%= agent.email %></a>
              </p>
              <% end %>
              <div class="mt-4 flex items-center gap-4 text-sm text-gray-500">
                <span><%= pluralize(agent.properties.active.count, 'объект', 'объекта', 'объектов') %></span>
              </div>
            </div>
          </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-16 text-gray-500">
          <p class="text-xl">Информация о команде обновляется</p>
          <p class="mt-2">Пожалуйста, зайдите позже.</p>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Join team CTA -->
  <div class="bg-gray-50 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-lg bg-primary-700 px-6 py-12 text-center sm:px-12">
        <h2 class="text-3xl font-extrabold text-white">
          Хотите стать частью нашей команды?
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">
          Мы всегда рады талантливым специалистам. Свяжитесь с нами.
        </p>
        <div class="mt-8">
          <%= link_to contacts_path, class: "inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-primary-700 bg-white hover:bg-primary-50" do %>
            Написать нам
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
