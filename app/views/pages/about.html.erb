<% content_for :title, "О компании — АН Виктори" %>
<% content_for :seo_description, 'АН «Виктори» — агентство недвижимости в Рязани с 2008 года. Покупка, продажа, аренда квартир, домов, коммерческой недвижимости. Юридическое сопровождение, ипотечный консалтинг, опыт 18 лет на рынке.' %>

<%= render 'shared/breadcrumb', items: [
  ['Главная', root_path],
  ['О компании', nil]
] %>

<section class="px-6 lg:px-12 py-12 lg:py-16 bg-background">
  <div class="max-w-5xl mx-auto">
    <p class="text-sm tracking-[0.4em] text-muted-foreground mb-4">О КОМПАНИИ</p>
    <h1 class="text-5xl md:text-6xl lg:text-7xl font-light tracking-wider text-foreground mb-12 leading-tight">
      АН ВИКТОРИ<br>НЕДВИЖИМОСТЬ В РЯЗАНИ
    </h1>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-24 mb-24">
      <div>
        <p class="text-base text-muted-foreground leading-relaxed mb-6">
          АН «Виктори» — рязанское агентство недвижимости. Помогаем клиентам покупать, продавать, арендовать и оценивать квартиры, дома, участки и коммерческую недвижимость в Рязани и области.
        </p>
        <p class="text-base text-muted-foreground leading-relaxed">
          Команда профильных агентов, своя база сделок, договоры и сопровождение под ключ. Работаем по принципу: каждая сделка — рекомендация и повторное обращение.
        </p>
      </div>
      <% processed = @metrics[:processed_requests].to_i.positive? ? @metrics[:processed_requests] : @metrics[:completed_deals] %>
      <div class="grid grid-cols-2 gap-8">
        <% [
          [@metrics[:years_on_market],                            "лет на рынке"],
          [Property.in_advertising.count,                         "объектов в рекламе"],
          [number_with_delimiter(processed),                      "обработано клиентских запросов"],
          [@metrics[:total_volume_human].presence || 'Рязань',    @metrics[:total_volume_human].present? ? "объём продаж" : "и область"]
        ].each do |v, l| %>
          <div>
            <p class="text-4xl lg:text-5xl font-light tracking-wider text-foreground mb-2"><%= v %></p>
            <p class="text-xs tracking-widest text-muted-foreground uppercase"><%= l %></p>
          </div>
        <% end %>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16">
      <% [
        ["ПОДБОР",       "Знаем рязанский рынок: каждый район, новостройки, частные секторы. Подбираем под бюджет и задачу.", properties_path, "Открыть каталог"],
        ["ОЦЕНКА",       "Онлайн-оценка по нашей базе фактических сделок. Адекватная цена под продажу или ипотечный отчёт. Инвест-аудит для покупателей.", valuations_path, "Оценить онлайн"],
        ["ИПОТЕКА",      "Партнёрство с банками, расчёт платежа и помощь с пакетом документов. Льготные программы тоже.", services_mortgage_calculator_path, "Рассчитать"],
        ["СОПРОВОЖДЕНИЕ","Проверка чистоты объекта, договор, регистрация в Росреестре. Сделка с минимумом шагов от клиента.", services_legal_services_path, "Подробнее"]
      ].each do |t, b, link_url, link_label| %>
        <div>
          <h3 class="text-lg tracking-widest text-foreground mb-4"><%= t %></h3>
          <p class="text-sm text-muted-foreground leading-relaxed mb-3"><%= b %></p>
          <%= link_to link_label + " →", link_url, class: "inline-block text-xs tracking-[0.3em] text-foreground border-b border-foreground/30 hover:border-foreground transition-colors" %>
        </div>
      <% end %>
    </div>

    <div class="mt-24 flex flex-wrap gap-6">
      <%= link_to team_path,    class: "px-8 py-4 text-sm tracking-[0.3em] border border-border text-foreground hover:bg-foreground hover:text-background transition-colors" do %>КОМАНДА<% end %>
      <%= link_to history_path, class: "px-8 py-4 text-sm tracking-[0.3em] border border-border text-foreground hover:bg-foreground hover:text-background transition-colors" do %>ИСТОРИЯ<% end %>
    </div>
  </div>
</section>

<%= render 'shared/reviews_strip', reviews: @reviews, aggregate: @metrics %>
