<% content_for :title, 'Вход — Админка | АН Виктори' %>

<section class="min-h-[80vh] flex items-center justify-center px-6 py-20 bg-background">
  <div class="w-full max-w-md">
    <p class="text-[10px] tracking-[0.4em] text-muted-foreground mb-4 text-center">АДМИНИСТРИРОВАНИЕ</p>
    <h1 class="text-2xl lg:text-3xl font-light tracking-tight text-foreground text-center mb-8">
      Вход в админку
    </h1>

    <% if flash[:alert].present? %>
      <div class="mb-6 px-4 py-3 border border-red-500/40 bg-red-500/5 text-sm text-red-300">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with url: admin_login_path, method: :post, local: true, class: 'space-y-5' do |f| %>
      <%= hidden_field_tag :return_to, @return_to if @return_to.present? %>
      <div>
        <label for="token" class="block text-[10px] tracking-[0.3em] text-muted-foreground mb-2">ADMIN_TOKEN</label>
        <%= password_field_tag :token, nil,
              autocomplete: 'off',
              autofocus: true,
              class: 'w-full px-4 py-3 bg-card border border-border text-foreground placeholder:text-muted-foreground focus:border-foreground/60 focus:outline-none transition-colors font-mono text-sm' %>
      </div>
      <%= submit_tag 'ВОЙТИ',
            class: 'w-full px-6 py-3 text-xs tracking-[0.3em] bg-foreground text-background hover:bg-foreground/85 transition-colors cursor-pointer' %>
    <% end %>

    <p class="mt-8 text-xs text-muted-foreground/70 text-center leading-relaxed">
      Введите значение переменной <code class="font-mono">ADMIN_TOKEN</code> с сервера.
      Cookie с дайджестом будет храниться в сессии до закрытия браузера.
    </p>
  </div>
</section>
