<% content_for :title, 'Партнёрские агентства — Админ — АН Виктори' %>

<section class="px-6 lg:px-12 py-12 bg-background">
  <div class="max-w-7xl mx-auto">
    <p class="text-sm tracking-[0.4em] text-muted-foreground mb-4">АДМИН</p>
    <h1 class="text-3xl lg:text-4xl font-light tracking-wider text-foreground uppercase mb-2">
      Партнёрские агентства
    </h1>
    <p class="text-sm text-muted-foreground mb-8 max-w-2xl">
      Counterparties для commission tracking. `feed_source_key` матчится с ExternalListing.source_id —
      когда лид приходит на чужой объект, Referrals::AutoCreator находит агентство и создаёт Referral
      со status=pending.
    </p>

    <%# Counts strip + filter %>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-8">
      <% [
        [nil,        'Всего',         @counts[:all],      'border-border bg-card'],
        ['active',   '✓ Активные',    @counts[:active],   'border-emerald-500/40 bg-emerald-500/5'],
        ['inactive', '⏸ Не активные', @counts[:inactive], 'border-amber-500/40 bg-amber-500/5'],
        ['blocked',  '⛔ Заблокировано', @counts[:blocked], 'border-rose-500/40 bg-rose-500/5']
      ].each do |key, label, count, css| %>
        <%= link_to admin_partner_agencies_path(status: key),
              class: "border px-4 py-3 transition-colors hover:bg-muted/40 #{css} #{'ring-1 ring-foreground' if @status == key}" do %>
          <p class="text-[10px] tracking-[0.2em] uppercase text-muted-foreground"><%= label %></p>
          <p class="text-2xl font-light text-foreground mt-1"><%= count %></p>
        <% end %>
      <% end %>
    </div>

    <div class="flex justify-end mb-6">
      <%= link_to '+ Новое агентство', new_admin_partner_agency_path,
            class: 'h-11 px-6 inline-flex items-center bg-foreground text-background text-xs tracking-[0.2em] uppercase hover:bg-foreground/90 transition-colors' %>
    </div>

    <% if @partner_agencies.empty? %>
      <div class="border border-border bg-card p-8 text-center text-muted-foreground">
        Пусто. <%= link_to 'Создать первое', new_admin_partner_agency_path, class: 'underline hover:text-foreground' %>.
      </div>
    <% else %>
      <div class="overflow-x-auto border border-border">
        <table class="w-full text-sm">
          <thead class="bg-muted/40">
            <tr class="text-[10px] tracking-[0.2em] uppercase text-muted-foreground">
              <th class="text-left px-4 py-3">Название</th>
              <th class="text-left px-4 py-3">Slug</th>
              <th class="text-left px-4 py-3">Статус</th>
              <th class="text-right px-4 py-3">Комиссия</th>
              <th class="text-left px-4 py-3">Контакт</th>
              <th class="text-left px-4 py-3">Feed key</th>
              <th class="text-right px-4 py-3">Referrals</th>
              <th class="px-4 py-3"></th>
            </tr>
          </thead>
          <tbody>
            <% @partner_agencies.each do |a| %>
              <tr class="border-t border-border hover:bg-muted/20">
                <td class="px-4 py-3 text-foreground"><%= a.name %></td>
                <td class="px-4 py-3 text-muted-foreground font-mono text-xs"><%= a.slug %></td>
                <td class="px-4 py-3">
                  <% css = { 'active' => 'text-emerald-600', 'inactive' => 'text-amber-600', 'blocked' => 'text-rose-600' }[a.status] %>
                  <span class="text-xs tracking-[0.1em] uppercase <%= css %>">
                    <%= { 'active' => 'Active', 'inactive' => 'Inactive', 'blocked' => 'Blocked' }[a.status] %>
                  </span>
                </td>
                <td class="px-4 py-3 text-right text-foreground">
                  <%= a.default_commission_rate.present? ? "#{(a.default_commission_rate * 100).round(2)}%" : '—' %>
                </td>
                <td class="px-4 py-3 text-muted-foreground text-xs">
                  <% if a.contact_person.present? %><%= a.contact_person %><br><% end %>
                  <% if a.contact_email.present? %><%= mail_to a.contact_email, a.contact_email, class: 'underline hover:text-foreground' %><% end %>
                </td>
                <td class="px-4 py-3 text-muted-foreground font-mono text-xs"><%= a.feed_source_key.presence || '—' %></td>
                <td class="px-4 py-3 text-right text-muted-foreground"><%= a.referrals.count %></td>
                <td class="px-4 py-3 text-right whitespace-nowrap">
                  <%= link_to 'Edit', edit_admin_partner_agency_path(a),
                        class: 'text-xs tracking-[0.1em] uppercase text-muted-foreground hover:text-foreground' %>
                  <%= button_to 'Удалить', admin_partner_agency_path(a),
                        method: :delete,
                        data: { confirm: "Soft-delete агентство «#{a.name}»? Существующие Referral'ы останутся, но связь обнулится." },
                        class: 'ml-3 text-xs tracking-[0.1em] uppercase text-rose-600 hover:text-rose-700' %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</section>
