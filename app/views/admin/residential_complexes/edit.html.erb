<% content_for :title, "Админка · #{@complex.display_name} — АН Виктори" %>

<section class="px-6 lg:px-12 pt-28 pb-20 bg-background min-h-screen">
  <div class="max-w-5xl mx-auto">
    <nav class="text-xs tracking-[0.2em] uppercase text-muted-foreground mb-6">
      <%= link_to '← К списку ЖК', admin_residential_complexes_path, class: 'hover:text-foreground' %>
    </nav>

    <p class="text-[11px] tracking-[0.4em] text-muted-foreground mb-2">АДМИНКА · РЕДАКТИРОВАНИЕ</p>
    <h1 class="text-3xl lg:text-4xl font-light tracking-tight text-foreground mb-2"><%= @complex.display_name %></h1>
    <%# Ссылка живая с Фазы 3. У черновика она отдаст 404 — публичные
        страницы смотрят только на опубликованные ЖК, — поэтому подпись
        про это предупреждает, а не оставляет редактора гадать. %>
    <p class="text-xs text-muted-foreground mb-8">
      <%= link_to @complex.public_path, zhk_path(@complex), class: 'underline hover:no-underline',
                  target: '_blank', rel: 'noopener' %>
      <% if @complex.published? %>
        — открыть на сайте
      <% else %>
        — черновик, по ссылке пока 404: страница появится после публикации
      <% end %>
    </p>

    <%= render 'form', complex: @complex %>
  </div>
</section>
