<%# Shared form for admin/articles new + edit. %>
<%= form_with model: [:admin, @article],
              url: @article.persisted? ? admin_article_path(@article) : admin_articles_path(),
              local: true,
              class: "space-y-6" do |f| %>
  <% if @article.errors.any? %>
    <div class="border border-destructive/40 bg-destructive/5 p-4 text-sm text-destructive">
      <ul class="list-disc pl-5">
        <% @article.errors.full_messages.each do |m| %><li><%= m %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :title, "Заголовок *", class: "block text-xs tracking-[0.2em] text-muted-foreground mb-2" %>
    <%= f.text_field :title, required: true,
          class: "w-full h-12 px-4 bg-background border border-border text-foreground focus:border-foreground focus:outline-none transition-colors" %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div>
      <%= f.label :category, "Категория", class: "block text-xs tracking-[0.2em] text-muted-foreground mb-2" %>
      <%= f.select :category,
            Article::CATEGORIES.map { |c| [c.humanize, c] },
            {}, class: "w-full h-12 px-4 bg-background border border-border text-foreground" %>
    </div>
    <div>
      <%= f.label :schema_type, "Schema.org type", class: "block text-xs tracking-[0.2em] text-muted-foreground mb-2" %>
      <%= f.select :schema_type,
            Article::SCHEMA_TYPES.map { |s| [s, s] },
            {}, class: "w-full h-12 px-4 bg-background border border-border text-foreground" %>
    </div>
    <div>
      <%= f.label :region, "Регион (опц.)", class: "block text-xs tracking-[0.2em] text-muted-foreground mb-2" %>
      <%= f.text_field :region, placeholder: "ryazan",
            class: "w-full h-12 px-4 bg-background border border-border text-foreground focus:border-foreground focus:outline-none transition-colors" %>
    </div>
  </div>

  <div>
    <%= f.label :slug, "Slug (опц., авто из заголовка)", class: "block text-xs tracking-[0.2em] text-muted-foreground mb-2" %>
    <%= f.text_field :slug,
          class: "w-full h-12 px-4 bg-background border border-border text-foreground focus:border-foreground focus:outline-none transition-colors" %>
  </div>

  <div>
    <%= f.label :excerpt, "Краткое описание", class: "block text-xs tracking-[0.2em] text-muted-foreground mb-2" %>
    <%= f.text_area :excerpt, rows: 2,
          placeholder: "1-2 строки для карточки и meta description (опц., иначе из тела)",
          class: "w-full px-4 py-3 bg-background border border-border text-foreground focus:border-foreground focus:outline-none transition-colors" %>
  </div>

  <div>
    <%= f.label :body, "Тело (Markdown) *", class: "block text-xs tracking-[0.2em] text-muted-foreground mb-2" %>
    <%= f.text_area :body, rows: 18, required: true,
          placeholder: "## Заголовок\n\nАбзац с **жирным** и [ссылкой](https://...).\n\n- Список\n- Пункт",
          class: "w-full px-4 py-3 bg-background border border-border text-foreground font-mono text-sm focus:border-foreground focus:outline-none transition-colors" %>
    <p class="text-[10px] text-muted-foreground/70 mt-1">
      Поддерживается Markdown: ##/###, **bold**, *italic*, [ссылки](url), списки, цитаты, таблицы. HTML-рендер автоматически.
    </p>
  </div>

  <% unless @article.persisted? %>
    <div class="space-y-3">
      <label class="flex items-center gap-2 text-sm text-muted-foreground">
        <%= check_box_tag :publish, '1', true,
              class: "w-4 h-4 bg-background border-border" %>
        Опубликовать сразу (иначе сохранится как черновик)
      </label>
      <label class="flex items-center gap-2 text-sm text-muted-foreground">
        <%= check_box_tag :publish_to_telegram, '1', false,
              class: "w-4 h-4 bg-background border-border" %>
        Также опубликовать в Telegram-канал <span class="text-foreground font-medium">@rznvictory</span>
      </label>
    </div>
  <% else %>
    <div>
      <%= f.label :published_at, "Дата публикации (пустая = черновик)", class: "block text-xs tracking-[0.2em] text-muted-foreground mb-2" %>
      <%= f.datetime_local_field :published_at,
            value: @article.published_at&.strftime('%Y-%m-%dT%H:%M'),
            class: "px-4 py-2 bg-background border border-border text-foreground" %>
    </div>

    <%# Telegram dispatch — once posted, the message_id is stored in
        metadata so we won't ever try to double-post the same article. %>
    <% tg_msg_id = @article.metadata.is_a?(Hash) ? @article.metadata['telegram_message_id'] : nil %>
    <div class="pt-3 border-t border-border">
      <p class="text-[10px] tracking-[0.3em] text-muted-foreground mb-3">TELEGRAM @RZNVICTORY</p>
      <% if tg_msg_id.present? %>
        <p class="text-sm text-foreground">
          ✓ Опубликовано в @rznvictory (msg #<%= tg_msg_id %>)
          <% if (ts = @article.metadata['telegram_published_at']).present? %>
            <span class="text-xs text-muted-foreground ml-2">
              <%= l(Time.parse(ts), format: :long) rescue ts %>
            </span>
          <% end %>
        </p>
      <% else %>
        <%= button_to 'Опубликовать в Telegram-канал @rznvictory',
              publish_to_telegram_admin_article_path(@article),
              method: :post,
              data: { turbo_confirm: 'Запостить эту статью в @rznvictory сейчас?' },
              class: 'px-5 py-2.5 text-xs tracking-[0.25em] border border-foreground/40 text-foreground hover:bg-foreground hover:text-background transition-colors cursor-pointer',
              form: { class: 'inline' } %>
        <p class="text-xs text-muted-foreground mt-2">
          Пост уйдёт от @victory62_bot. Если в метаданных есть image_url — будет sendPhoto с подписью, иначе обычный текст. Хэштеги из metadata.hashtags подпишутся в конец.
        </p>
      <% end %>
    </div>
  <% end %>

  <div class="flex flex-wrap items-center gap-3 pt-4 border-t border-border">
    <%= f.submit(@article.persisted? ? "СОХРАНИТЬ" : "СОЗДАТЬ",
          class: "px-6 py-3 text-xs tracking-[0.25em] bg-foreground text-background hover:bg-foreground/85 transition-colors cursor-pointer") %>
    <%= link_to "← К списку", admin_articles_path(),
          class: "text-xs tracking-[0.25em] text-muted-foreground hover:text-foreground" %>
    <% if @article.persisted? %>
      <%= button_to "УДАЛИТЬ",
            admin_article_path(@article),
            method: :delete,
            class: "ml-auto px-4 py-3 text-xs tracking-[0.25em] border border-destructive/50 text-destructive hover:bg-destructive hover:text-background transition-colors cursor-pointer",
            form: { class: "inline" },
            data: { turbo_confirm: "Удалить статью безвозвратно?" } %>
    <% end %>
  </div>
<% end %>
