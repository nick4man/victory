<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>Статус сделки обновлён</title>
</head>
<body style="margin:0;padding:0;background:#f6f6f4;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;color:#1a1a1a;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f6f6f4;padding:48px 16px;">
    <tr>
      <td align="center">
        <table role="presentation" width="540" cellpadding="0" cellspacing="0" style="background:#ffffff;max-width:540px;border:1px solid #e5e5e0;">
          <tr>
            <td style="padding:48px 48px 32px;">
              <p style="margin:0 0 32px;font-size:12px;letter-spacing:0.3em;text-transform:uppercase;color:#888;">
                <%= AgencyInfo::NAME %>
              </p>
              <h1 style="margin:0 0 16px;font-size:28px;font-weight:300;letter-spacing:-0.02em;line-height:1.2;">
                Статус вашей сделки обновлён
              </h1>
              <p style="margin:0 0 24px;font-size:15px;line-height:1.6;color:#444;">
                Здравствуйте<%= @user.first_name.present? ? ", #{@user.first_name}" : '' %>.
                Агент перевёл вашу сделку на новый этап.
              </p>

              <table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;margin:0 0 32px;border:1px solid #e5e5e0;">
                <tr>
                  <td style="padding:16px 20px;background:#fafaf8;border-bottom:1px solid #e5e5e0;">
                    <p style="margin:0;font-size:11px;letter-spacing:0.2em;text-transform:uppercase;color:#888;">Новый этап</p>
                    <p style="margin:6px 0 0;font-size:18px;font-weight:500;letter-spacing:-0.01em;">
                      <%= @new_stage_label.upcase %>
                    </p>
                  </td>
                </tr>
                <% if @prev_stage_label.present? %>
                  <tr>
                    <td style="padding:14px 20px;">
                      <p style="margin:0;font-size:12px;color:#888;line-height:1.5;">
                        Предыдущий этап: <span style="color:#444;"><%= @prev_stage_label %></span>
                      </p>
                    </td>
                  </tr>
                <% end %>
              </table>

              <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 0 32px;">
                <tr>
                  <td>
                    <a href="<%= @cabinet_url %>" style="display:inline-block;padding:14px 32px;background:#1a1a1a;color:#ffffff;text-decoration:none;font-size:13px;letter-spacing:0.2em;text-transform:uppercase;">
                      Открыть кабинет
                    </a>
                  </td>
                </tr>
              </table>

              <hr style="border:none;border-top:1px solid #e5e5e0;margin:32px 0;">
              <p style="margin:0;font-size:12px;line-height:1.5;color:#888;">
                В личном кабинете доступна вся история этапов, контакт агента и
                связанные с объектом документы. Уведомление автоматическое —
                ответить на него нельзя, но в кабинете есть чат с агентом.
              </p>
            </td>
          </tr>
          <tr>
            <td style="padding:24px 48px;background:#fafaf8;border-top:1px solid #e5e5e0;">
              <p style="margin:0;font-size:11px;line-height:1.5;color:#888;">
                <%= AgencyInfo::NAME %> · <%= AgencyInfo::PHONE_PRIMARY rescue '' %><br>
                <%= AgencyInfo::WEBSITE_URL %>
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
