<%# Ипотечный калькулятор %>
<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold text-gray-900 mb-6">Ипотечный калькулятор</h1>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <div class="bg-white rounded-lg shadow p-6"
         data-controller="mortgage-calculator">
      <h2 class="text-xl font-bold mb-6">Параметры ипотеки</h2>

      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Стоимость недвижимости (₽)</label>
          <input type="number" id="mc-amount" value="5000000" min="0" step="100000"
                 class="w-full border border-gray-300 rounded-lg px-3 py-2"
                 data-mortgage-calculator-target="amount">
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Первоначальный взнос (₽)</label>
          <input type="number" id="mc-down" value="1000000" min="0" step="100000"
                 class="w-full border border-gray-300 rounded-lg px-3 py-2"
                 data-mortgage-calculator-target="downPayment">
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Процентная ставка (%)</label>
          <input type="number" id="mc-rate" value="8.5" min="0" max="30" step="0.1"
                 class="w-full border border-gray-300 rounded-lg px-3 py-2"
                 data-mortgage-calculator-target="rate">
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Срок кредита (лет)</label>
          <input type="number" id="mc-term" value="20" min="1" max="30"
                 class="w-full border border-gray-300 rounded-lg px-3 py-2"
                 data-mortgage-calculator-target="termYears">
        </div>

        <button type="button"
                class="w-full bg-primary-600 text-white font-semibold py-3 rounded-lg hover:bg-primary-700 transition"
                data-action="click->mortgage-calculator#calculate">
          Рассчитать
        </button>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-xl font-bold mb-6">Результаты расчёта</h2>
      <div id="mortgage-results" class="space-y-4">
        <p class="text-gray-500 text-center py-8">Заполните параметры и нажмите «Рассчитать»</p>
      </div>
    </div>
  </div>
</div>
