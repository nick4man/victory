  <script type="module">
    (function () {
      const $ = (id) => document.getElementById(id);
      const fmt = (n) => Math.round(n).toLocaleString('ru-RU') + ' ₽';

      // Sync deposit amount to mortgage down payment automatically.
      const downEl = $('vs-down');
      const depEl  = $('vs-deposit-amount');
      const inputs = ['vs-price','vs-down','vs-mortgage-rate','vs-years',
                      'vs-deposit-rate','vs-rent','vs-price-growth','vs-rent-growth'];

      function annuityMonthly(loan, annualRate, months) {
        if (loan <= 0) return 0;
        const r = annualRate / 100 / 12;
        if (r === 0) return loan / months;
        return loan * r * Math.pow(1 + r, months) / (Math.pow(1 + r, months) - 1);
      }

      function compute() {
        // Mortgage scenario
        const price       = Math.max(0, Number($('vs-price').value || 0));
        const down        = Math.max(0, Number($('vs-down').value || 0));
        const mortRate    = Math.max(0, Number($('vs-mortgage-rate').value || 0));
        const years       = Math.max(1, Number($('vs-years').value || 1));
        const months      = years * 12;
        const loan        = Math.max(0, price - down);
        const monthly     = annuityMonthly(loan, mortRate, months);
        const totalPaid   = monthly * months;
        const overpay     = totalPaid - loan;
        const priceGrowth = Math.max(0, Number($('vs-price-growth').value || 0)) / 100;
        const flatFuture  = price * Math.pow(1 + priceGrowth, years);
        const mortgageNet = flatFuture - (down + totalPaid);

        // Deposit scenario — sum invested = mortgage down payment
        depEl.value = down;
        const depRate     = Math.max(0, Number($('vs-deposit-rate').value || 0));
        const monthlyDepR = depRate / 100 / 12;
        const depositFuture = down * Math.pow(1 + monthlyDepR, months);
        const rent0       = Math.max(0, Number($('vs-rent').value || 0));
        const rentGrowth  = Math.max(0, Number($('vs-rent-growth').value || 0)) / 100;
        // Sum of geometric series for annual rent, paid monthly.
        let totalRent = 0;
        for (let y = 0; y < years; y++) {
          totalRent += rent0 * Math.pow(1 + rentGrowth, y) * 12;
        }
        const depositNet = depositFuture - totalRent;

        // Render
        $('vs-monthly').textContent     = fmt(monthly);
        $('vs-overpay').textContent     = fmt(overpay);
        $('vs-flat-future').textContent = fmt(flatFuture);
        $('vs-mortgage-net').textContent = fmt(mortgageNet);
        $('vs-deposit-future').textContent = fmt(depositFuture);
        $('vs-total-rent').textContent    = fmt(totalRent);
        $('vs-deposit-net').textContent   = fmt(depositNet);
        $('vs-verdict-years').textContent = years;

        // Verdict
        const diff = mortgageNet - depositNet;
        const verdict = $('vs-verdict');
        const box     = $('vs-verdict-box');
        if (Math.abs(diff) < 100000) {
          verdict.textContent = 'Сценарии примерно равны — разница в пределах 100 000 ₽';
          box.className = box.className.replace(/(bg-\S+|text-\S+)/g, '').trim() + ' bg-foreground text-background';
        } else if (diff > 0) {
          verdict.textContent = `Ипотека выгоднее на ${fmt(diff)}`;
          box.className = box.className.replace(/(bg-\S+|text-\S+)/g, '').trim() + ' bg-emerald-900/30 text-emerald-200 border-emerald-500/30';
        } else {
          verdict.textContent = `Вклад выгоднее на ${fmt(Math.abs(diff))}`;
          box.className = box.className.replace(/(bg-\S+|text-\S+)/g, '').trim() + ' bg-amber-900/30 text-amber-200 border-amber-500/30';
        }
      }

      inputs.forEach((id) => {
        const el = $(id);
        el && el.addEventListener('input', compute);
      });
      compute();
    })();
  </script>
