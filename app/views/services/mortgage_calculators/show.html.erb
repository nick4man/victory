<%# /services/mortgage — Calculator hub
    ──────────────────────────────────
    Three vertical sections: live calculator (left col) + result (right col),
    next-step cross-links to audit/express, 22 bank programs table, FAQ.
    All interactivity is inline vanilla JS — importmap-rails is disabled
    in this project. JSON-LD WebApplication + FAQPage attached for SEO. %>

<%
  fmt_rub  = ->(v) { number_with_delimiter(v.to_i, delimiter: ' '.encode('UTF-8')) }
  fmt_rate = ->(v) { '%.2f' % v.to_f }
  selected_program = @programs.find { |p| p[:id].to_s == @form_state[:program_id].to_s } if @form_state[:program_id]

  product_type_groups = @programs.group_by { |p| p[:product_type_ru] }
                                 .map { |type, items| { type: type, count: items.size } }
                                 .sort_by { |g| -g[:count] }
%>

<section class="px-6 lg:px-12 pt-32 pb-20 bg-background">
  <%# ============================================================
      HERO
      ============================================================ %>
  <div class="max-w-4xl mx-auto text-center mb-16">
    <p class="text-[11px] tracking-[0.4em] text-muted-foreground mb-6">
      ИПОТЕКА · РЯЗАНЬ
    </p>
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-light tracking-tight text-foreground leading-[1.1] mb-6">
      Ипотечный калькулятор
    </h1>
    <p class="text-base lg:text-lg text-muted-foreground max-w-2xl mx-auto leading-relaxed mb-6">
      Рассчитайте ежемесячный платёж и сравните <span class="text-foreground"><%= @programs.size %> программ</span>
      от <span class="text-foreground"><%= @programs.map { |p| p[:bank_name] }.uniq.size %> банков</span> —
      данные обновляются ежедневно.
    </p>
    <% if @macro && @macro[:key_rate] %>
      <p class="text-xs tracking-[0.25em] text-muted-foreground/80">
        <span class="text-foreground"><%= @macro[:key_rate] %>%</span> КЛЮЧЕВАЯ ЦБ
        <span class="mx-2 opacity-50">·</span>
        <span class="text-foreground"><%= @macro[:mortgage_rate] %>%</span> СРЕДНЯЯ ИПОТЕКА
        <% if @macro[:deposit_rate] %>
          <span class="mx-2 opacity-50">·</span>
          <span class="text-foreground"><%= @macro[:deposit_rate] %>%</span> ДЕПОЗИТ
        <% end %>
      </p>
    <% end %>
  </div>

  <%# Property-source banner — appears when ?from_property= prefilled price %>
  <% if @source_property %>
    <div class="max-w-5xl mx-auto mb-8 bg-card border border-border px-6 py-4 flex items-center justify-between flex-wrap gap-3">
      <p class="text-sm text-muted-foreground">
        Расчёт для объекта:
        <span class="text-foreground">«<%= @source_property.title.to_s.truncate(60) %>»</span>
        · <span class="text-foreground"><%= fmt_rub.call(@source_property.price) %>&nbsp;₽</span>
      </p>
      <%= link_to "ОТКРЫТЬ ОБЪЕКТ →", property_path(@source_property),
            class: "text-xs tracking-[0.25em] text-muted-foreground hover:text-foreground" %>
    </div>
  <% end %>

  <%# ============================================================
      CALCULATOR + RESULT — two-column grid, sticky right column
      ============================================================ %>
  <div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-5 gap-5 lg:gap-6 mb-16"
       data-mortgage-calc
       data-default-rate="<%= @macro[:mortgage_rate] || 16.5 %>">

    <%# LEFT — inputs (3/5 col) %>
    <div class="lg:col-span-3 bg-card border border-border p-6 lg:p-8 space-y-6">
      <%# Active-program chip (if user clicked a program below) %>
      <div id="mc-program-chip"
           class="<%= selected_program ? '' : 'hidden' %> flex items-center justify-between bg-secondary px-3 py-2 text-xs">
        <span class="text-muted-foreground">
          Программа: <span class="text-foreground" data-mc-program-label><%= selected_program ? "#{selected_program[:bank_name]} · #{selected_program[:product_name]}" : '' %></span>
        </span>
        <button type="button" data-mc-program-clear class="text-muted-foreground hover:text-foreground" aria-label="Сбросить программу">×</button>
      </div>

      <%# === Price === %>
      <div>
        <div class="flex items-center justify-between mb-2">
          <label for="mc-price" class="text-xs tracking-[0.2em] text-muted-foreground">ЦЕНА ОБЪЕКТА, ₽</label>
        </div>
        <input type="text" id="mc-price" inputmode="numeric"
               value="<%= fmt_rub.call(@form_state[:price]) %>"
               class="w-full h-12 px-4 bg-background border border-border text-foreground text-base focus:border-foreground focus:outline-none transition-colors">
      </div>

      <%# === Down payment (amount + slider %) === %>
      <div>
        <div class="flex items-center justify-between mb-2">
          <label for="mc-down" class="text-xs tracking-[0.2em] text-muted-foreground">ПЕРВЫЙ ВЗНОС, ₽</label>
          <span class="text-xs text-foreground" data-mc-dp-pct><%= @form_state[:down_payment_pct].to_i %>%</span>
        </div>
        <input type="text" id="mc-down" inputmode="numeric"
               value="<%= fmt_rub.call(@form_state[:down_payment]) %>"
               class="w-full h-12 px-4 bg-background border border-border text-foreground text-base focus:border-foreground focus:outline-none transition-colors mb-3">
        <input type="range" id="mc-down-slider" min="0" max="90" step="1"
               value="<%= @form_state[:down_payment_pct].to_i %>"
               class="w-full accent-foreground">
        <div class="flex justify-between text-[10px] text-muted-foreground/70 mt-1 px-0.5">
          <span>0%</span><span>20%</span><span>50%</span><span>90%</span>
        </div>
      </div>

      <%# === Term (slider) === %>
      <div>
        <div class="flex items-center justify-between mb-2">
          <label for="mc-term" class="text-xs tracking-[0.2em] text-muted-foreground">СРОК, ЛЕТ</label>
          <span class="text-xs text-foreground" data-mc-term-display><%= @form_state[:term_years] %></span>
        </div>
        <input type="range" id="mc-term" min="1" max="30" step="1"
               value="<%= @form_state[:term_years] %>"
               class="w-full accent-foreground">
        <div class="flex justify-between text-[10px] text-muted-foreground/70 mt-1 px-0.5">
          <span>5</span><span>10</span><span>15</span><span>20</span><span>25</span><span>30</span>
        </div>
      </div>

      <%# === Rate === %>
      <div>
        <div class="flex items-center justify-between mb-2">
          <label for="mc-rate" class="text-xs tracking-[0.2em] text-muted-foreground">СТАВКА, % ГОДОВЫХ</label>
          <button type="button" data-mc-rate-default
                  class="text-[10px] tracking-[0.25em] text-muted-foreground hover:text-foreground border-b border-border/40">
            ↻ ИЗ ЦБ <%= fmt_rate.call(@macro[:mortgage_rate] || 16.5) %>%
          </button>
        </div>
        <input type="number" id="mc-rate" inputmode="decimal" step="0.1" min="0" max="50"
               value="<%= fmt_rate.call(@form_state[:rate]) %>"
               class="w-full h-12 px-4 bg-background border border-border text-foreground text-base focus:border-foreground focus:outline-none transition-colors">
      </div>
    </div>

    <%# RIGHT — result (2/5 col, sticky on lg+) %>
    <div class="lg:col-span-2 bg-foreground text-background p-6 lg:p-8 lg:sticky lg:top-24 self-start">
      <p class="text-[10px] tracking-[0.4em] text-background/70 mb-4">ЕЖЕМЕСЯЧНЫЙ ПЛАТЁЖ</p>
      <p class="text-4xl md:text-5xl font-light tracking-tight mb-6" data-mc-monthly>—</p>

      <div class="space-y-3 pt-5 border-t border-background/15 text-xs">
        <div class="flex justify-between">
          <span class="text-background/70 tracking-wider">СУММА КРЕДИТА</span>
          <span class="text-background" data-mc-loan>—</span>
        </div>
        <div class="flex justify-between">
          <span class="text-background/70 tracking-wider">ПЕРЕПЛАТА</span>
          <span class="text-background" data-mc-overpay>—</span>
        </div>
        <div class="flex justify-between">
          <span class="text-background/70 tracking-wider">ИТОГО ВЫПЛАТ</span>
          <span class="text-background" data-mc-total>—</span>
        </div>
      </div>

      <p class="mt-6 text-[10px] tracking-[0.2em] text-background/50 leading-relaxed">
        АННУИТЕТНЫЙ ПЛАТЁЖ. РЕАЛЬНАЯ СТАВКА У БАНКА МОЖЕТ ОТЛИЧАТЬСЯ.
      </p>
    </div>
  </div>

  <%# ============================================================
      NEXT-STEP PANEL — ядерные связки
      ============================================================ %>
  <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-5 lg:gap-6 mb-20" data-mc-cross-links>
    <a href="#" data-mc-cross-audit
       class="group bg-card border border-border p-6 lg:p-8 hover:border-foreground/40 transition-colors flex flex-col">
      <p class="text-[10px] tracking-[0.4em] text-muted-foreground mb-2">ДЛЯ ПОКУПАТЕЛЯ</p>
      <h3 class="text-2xl lg:text-3xl font-light tracking-tight text-foreground mb-2 leading-tight">
        Стоит ли вкладывать?
      </h3>
      <p class="text-sm text-muted-foreground flex-1 mb-4">
        Запустим инвест-аудит с этой ставкой и взносом — 1 млн симуляций Монте-Карло, рекомендация «Покупать» или «Подождать».
      </p>
      <div class="flex items-center gap-3 text-sm tracking-[0.2em] text-foreground group-hover:translate-x-1 transition-transform">
        ЗАПУСТИТЬ АУДИТ →
      </div>
    </a>

    <%= link_to new_property_valuation_path,
          class: "group bg-card border border-border p-6 lg:p-8 hover:border-foreground/40 transition-colors flex flex-col" do %>
      <p class="text-[10px] tracking-[0.4em] text-muted-foreground mb-2">ДЛЯ ПРОДАВЦА</p>
      <h3 class="text-2xl lg:text-3xl font-light tracking-tight text-foreground mb-2 leading-tight">
        Сколько стоит мой объект?
      </h3>
      <p class="text-sm text-muted-foreground flex-1 mb-4">
        Бесплатная экспресс-оценка: 5–8 аналогов из каталога + гедоническая модель ценообразования + доверительный интервал.
      </p>
      <div class="flex items-center gap-3 text-sm tracking-[0.2em] text-foreground group-hover:translate-x-1 transition-transform">
        ЗАКАЗАТЬ ОЦЕНКУ →
      </div>
    <% end %>
  </div>

  <%# ============================================================
      PROGRAMS TABLE — 22 bank offers
      ============================================================ %>
  <% if @programs.any? %>
    <div class="max-w-5xl mx-auto mb-20" data-mc-programs>
      <div class="flex items-baseline justify-between flex-wrap gap-3 mb-6">
        <h2 class="text-2xl lg:text-3xl font-light tracking-tight text-foreground">
          Программы банков · <%= @programs.size %>
        </h2>
        <p class="text-xs tracking-[0.25em] text-muted-foreground">
          КЛИК ПО СТРОКЕ — ЗАПОЛНИТЬ КАЛЬКУЛЯТОР
        </p>
      </div>

      <%# Filter chips %>
      <div class="flex flex-wrap gap-2 mb-6" data-mc-filters>
        <button type="button" data-mc-filter="all"
                class="px-3 py-1.5 text-[11px] tracking-[0.2em] border border-foreground text-foreground bg-foreground/5">
          ВСЕ
        </button>
        <% product_type_groups.each do |g| %>
          <button type="button" data-mc-filter="<%= g[:type] %>"
                  class="px-3 py-1.5 text-[11px] tracking-[0.2em] border border-border text-muted-foreground hover:text-foreground hover:border-foreground/60 transition-colors">
            <%= g[:type].upcase %> · <%= g[:count] %>
          </button>
        <% end %>
      </div>

      <%# Table — actually a list of rows for mobile-friendliness %>
      <div class="border border-border divide-y divide-border bg-card">
        <% @programs.each_with_index do |p, idx| %>
          <div class="grid grid-cols-12 gap-3 px-4 py-4 hover:bg-secondary/30 transition-colors cursor-pointer <%= 'hidden' if idx >= 10 %>"
               data-mc-program
               data-mc-program-id="<%= p[:id] %>"
               data-mc-program-type="<%= p[:product_type_ru] %>"
               data-mc-program-rate-min="<%= p[:rate_min] %>"
               data-mc-program-term-min="<%= p[:term_years_min] %>"
               data-mc-program-term-max="<%= p[:term_years_max] %>"
               data-mc-program-dp-min="<%= p[:down_payment_min_pct] %>"
               data-mc-program-label="<%= p[:bank_name] %> · <%= p[:product_name] %>">
            <div class="col-span-12 md:col-span-4 flex flex-col">
              <span class="text-[10px] tracking-[0.3em] text-muted-foreground"><%= p[:product_type_ru].upcase %></span>
              <span class="text-sm text-foreground mt-1"><%= p[:bank_name] %></span>
              <span class="text-xs text-muted-foreground"><%= p[:product_name] %></span>
            </div>
            <div class="col-span-4 md:col-span-2 flex flex-col">
              <span class="text-[10px] tracking-[0.3em] text-muted-foreground">СТАВКА</span>
              <span class="text-sm text-foreground mt-1">
                от <%= fmt_rate.call(p[:rate_min]) %>%
              </span>
            </div>
            <div class="col-span-4 md:col-span-2 flex flex-col">
              <span class="text-[10px] tracking-[0.3em] text-muted-foreground">СРОК</span>
              <span class="text-sm text-foreground mt-1">
                до <%= p[:term_years_max] || 30 %> лет
              </span>
            </div>
            <div class="col-span-4 md:col-span-2 flex flex-col">
              <span class="text-[10px] tracking-[0.3em] text-muted-foreground">ВЗНОС</span>
              <span class="text-sm text-foreground mt-1">
                от <%= p[:down_payment_min_pct]&.to_i || 15 %>%
              </span>
            </div>
            <div class="col-span-12 md:col-span-2 flex items-center justify-end">
              <span class="text-xs tracking-[0.2em] text-muted-foreground group-hover:text-foreground">ВЫБРАТЬ →</span>
            </div>
          </div>
        <% end %>
      </div>

      <% if @programs.size > 10 %>
        <div class="text-center mt-5">
          <button type="button" data-mc-programs-toggle
                  class="text-xs tracking-[0.3em] text-muted-foreground hover:text-foreground border-b border-border/40 pb-1">
            ПОКАЗАТЬ ЕЩЁ <%= @programs.size - 10 %> ПРОГРАММ
          </button>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="max-w-5xl mx-auto mb-20 border border-amber-500/30 bg-amber-500/5 p-6 text-center">
      <p class="text-sm text-amber-300 mb-2">Каталог банковских программ временно недоступен</p>
      <p class="text-xs text-muted-foreground leading-relaxed max-w-xl mx-auto">
        Калькулятор продолжает работать с усреднённой ставкой
        <% if @macro && @macro[:mortgage_rate] %>
          <span class="text-foreground"><%= @macro[:mortgage_rate] %>%</span>
        <% end %>
        — данные ЦБ РФ. Свяжитесь с менеджером для актуальных предложений
        конкретных банков.
      </p>
    </div>
  <% end %>

  <%# ============================================================
      Альтернатива — депозиты / сравнение (на отдельных страницах)
      ============================================================ %>
  <div class="max-w-5xl mx-auto mb-20 grid grid-cols-1 md:grid-cols-2 gap-4">
    <%= link_to services_deposit_path, class: 'block p-6 bg-card border border-border hover:border-foreground transition-colors group' do %>
      <p class="text-[10px] tracking-[0.4em] text-muted-foreground mb-2">АЛЬТЕРНАТИВА</p>
      <p class="text-base text-foreground group-hover:text-muted-foreground transition-colors mb-1">Депозитный калькулятор →</p>
      <p class="text-xs text-muted-foreground leading-relaxed">Что будет, если положить деньги на вклад вместо ипотеки. Доход, капитализация, программы крупнейших банков.</p>
    <% end %>
    <%= link_to services_mortgage_vs_deposit_path, class: 'block p-6 bg-card border border-border hover:border-foreground transition-colors group' do %>
      <p class="text-[10px] tracking-[0.4em] text-muted-foreground mb-2">СРАВНЕНИЕ</p>
      <p class="text-base text-foreground group-hover:text-muted-foreground transition-colors mb-1">Вклад или ипотека →</p>
      <p class="text-xs text-muted-foreground leading-relaxed">Купить квартиру в ипотеку или положить на депозит и снимать? Полный расчёт на 20 лет.</p>
    <% end %>
  </div>

  <% _hide_legacy_inline_deposit_sections = false %>
  <% if _hide_legacy_inline_deposit_sections && @deposit_programs&.any? %>
    <div class="max-w-5xl mx-auto mb-20" id="deposit-programs">
      <div class="bg-card border border-border">
        <div class="px-6 lg:px-8 py-5 lg:py-6 border-b border-border">
          <p class="text-[10px] tracking-[0.4em] text-muted-foreground mb-1">АЛЬТЕРНАТИВА</p>
          <h2 class="text-xl lg:text-2xl font-light tracking-tight text-foreground">
            Депозитные программы · <%= @deposit_programs.size %>
          </h2>
          <p class="text-sm text-muted-foreground mt-2 max-w-2xl">
            Думаете «оставить деньги на вкладе или взять ипотеку?» — вот ставки крупнейших банков.
            Сравните доходность депозита с переплатой по кредиту выше.
          </p>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-background/40 text-[10px] tracking-[0.2em] text-muted-foreground uppercase">
              <tr>
                <th class="text-left p-3">Банк</th>
                <th class="text-left p-3">Программа</th>
                <th class="text-right p-3">Ставка</th>
                <th class="text-left p-3">Срок</th>
                <th class="text-right p-3">От суммы</th>
                <th class="text-left p-3">Условия</th>
                <th class="text-right p-3"></th>
              </tr>
            </thead>
            <tbody>
              <% @deposit_programs.each do |d| %>
                <tr class="border-t border-border hover:bg-background/30 transition-colors"
                    data-deposit-rate="<%= d[:rate_max] %>"
                    data-deposit-term-max="<%= d[:term_months_max] %>"
                    data-deposit-min-amount="<%= d[:min_amount] %>">
                  <td class="p-3 font-medium text-foreground"><%= d[:bank_name] %></td>
                  <td class="p-3 text-foreground"><%= d[:product_name] %></td>
                  <td class="p-3 text-right text-emerald-300 font-medium"><%= d[:rate_max] %>%</td>
                  <td class="p-3 text-muted-foreground whitespace-nowrap"><%= d[:term_months_min] %>–<%= d[:term_months_max] %> мес.</td>
                  <td class="p-3 text-right text-muted-foreground whitespace-nowrap"><%= number_with_delimiter(d[:min_amount], delimiter: ' ') %> ₽</td>
                  <td class="p-3 text-xs text-muted-foreground">
                    <%= d[:capitalization]   ? 'капитализация' : 'без капитализации' %><% if d[:withdraw_allowed] %>, можно снимать<% end %>
                  </td>
                  <td class="p-3 text-right whitespace-nowrap">
                    <% if d[:source_url].present? %>
                      <%= link_to '→', d[:source_url], target: '_blank', rel: 'noopener nofollow',
                            class: 'text-xs text-muted-foreground hover:text-foreground' %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <p class="px-6 py-3 text-[11px] text-muted-foreground/70 border-t border-border">
          Ставки актуальны на <%= I18n.l(@deposit_programs.first[:as_of], format: :long) rescue @deposit_programs.first[:as_of] %>.
          Точные условия и оформление — на сайтах банков.
        </p>
      </div>

      <%# === Депозит-калькулятор === %>
      <div class="mt-8 bg-card border border-border" id="deposit-calculator">
        <div class="px-6 lg:px-8 py-5 lg:py-6 border-b border-border">
          <p class="text-[10px] tracking-[0.4em] text-muted-foreground mb-1">РАСЧЁТ ДОХОДА</p>
          <h3 class="text-lg lg:text-xl font-light tracking-tight text-foreground">Калькулятор депозита</h3>
          <p class="text-xs text-muted-foreground mt-1">
            Клик по строке таблицы выше — программа автоматически подставится в калькулятор.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-0">
          <div class="p-6 lg:p-8 space-y-5">
            <div>
              <label class="text-xs tracking-[0.25em] text-muted-foreground block mb-2">СУММА ВКЛАДА, ₽</label>
              <input type="number" id="dc-amount" value="1000000" min="1000" step="10000"
                     class="w-full px-3 py-2 bg-background border border-border text-foreground focus:border-foreground focus:outline-none text-lg">
            </div>

            <div>
              <div class="flex items-baseline justify-between mb-2">
                <label class="text-xs tracking-[0.25em] text-muted-foreground">СРОК, МЕСЯЦЕВ</label>
                <span class="text-sm text-foreground" id="dc-term-display">12</span>
              </div>
              <input type="range" id="dc-term" min="1" max="36" value="12" step="1"
                     class="w-full accent-foreground">
              <div class="flex justify-between text-[10px] text-muted-foreground mt-1">
                <span>1</span><span>12</span><span>24</span><span>36</span>
              </div>
            </div>

            <div>
              <div class="flex items-baseline justify-between mb-2">
                <label class="text-xs tracking-[0.25em] text-muted-foreground">СТАВКА, %</label>
                <span class="text-sm text-foreground" id="dc-rate-display">16.0%</span>
              </div>
              <input type="number" id="dc-rate" value="16.0" min="1" max="30" step="0.1"
                     class="w-full px-3 py-2 bg-background border border-border text-foreground focus:border-foreground focus:outline-none">
              <p id="dc-program-label" class="text-[11px] text-muted-foreground mt-2 hidden">
                Программа: <span class="text-foreground"></span>
              </p>
            </div>

            <div>
              <label class="inline-flex items-center gap-2 cursor-pointer">
                <input type="checkbox" id="dc-capitalization" checked class="accent-foreground">
                <span class="text-sm text-foreground">Капитализация процентов (ежемесячно)</span>
              </label>
              <p class="text-[11px] text-muted-foreground mt-1">При капитализации проценты прибавляются к телу вклада и в следующем месяце начисляются на бóльшую сумму.</p>
            </div>
          </div>

          <div class="bg-foreground text-background p-6 lg:p-8 lg:min-w-[320px] flex flex-col justify-center">
            <p class="text-xs tracking-[0.3em] mb-2 opacity-70">ИТОГОВАЯ СУММА</p>
            <p class="text-3xl md:text-4xl font-light tracking-tight mb-5" id="dc-final">—</p>
            <div class="grid grid-cols-2 gap-3 text-xs">
              <div>
                <p class="opacity-70 mb-1">Чистый доход</p>
                <p class="text-base" id="dc-profit">—</p>
              </div>
              <div>
                <p class="opacity-70 mb-1">Эффективная %</p>
                <p class="text-base" id="dc-effective">—</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script type="module">
      // Deposit calculator — annuity-style compound growth. Vanilla JS,
      // no Stimulus (project doesn't use it). State lives in the inputs;
      // every change rerenders the right-side summary.
      (function () {
        const $ = (id) => document.getElementById(id);
        const amountEl  = $('dc-amount');
        const termEl    = $('dc-term');
        const termDisp  = $('dc-term-display');
        const rateEl    = $('dc-rate');
        const rateDisp  = $('dc-rate-display');
        const capEl     = $('dc-capitalization');
        const finalEl   = $('dc-final');
        const profitEl  = $('dc-profit');
        const effEl     = $('dc-effective');
        const progLbl   = $('dc-program-label');

        const fmtRub = (n) => Math.round(n).toLocaleString('ru-RU') + ' ₽';

        function compute() {
          const principal = Math.max(0, Number(amountEl.value || 0));
          const months    = Math.max(1, Number(termEl.value || 1));
          const annualPct = Math.max(0, Number(rateEl.value || 0));
          const cap       = capEl.checked;

          let final;
          if (cap) {
            const monthlyRate = annualPct / 100 / 12;
            final = principal * Math.pow(1 + monthlyRate, months);
          } else {
            const years = months / 12;
            final = principal + principal * (annualPct / 100) * years;
          }
          const profit = final - principal;
          const yearsFraction = months / 12;
          const effective = yearsFraction > 0 ? (profit / principal / yearsFraction) * 100 : 0;

          finalEl.textContent = fmtRub(final);
          profitEl.textContent = fmtRub(profit);
          effEl.textContent = effective.toFixed(2) + '%';
          termDisp.textContent = months;
          rateDisp.textContent = annualPct.toFixed(1) + '%';
        }

        [amountEl, termEl, rateEl, capEl].forEach((el) => {
          el && el.addEventListener('input', compute);
        });

        // Click any deposit-table row → preselect rate/term/min-amount.
        document.querySelectorAll('#deposit-programs tr[data-deposit-rate]').forEach((row) => {
          row.style.cursor = 'pointer';
          row.addEventListener('click', (e) => {
            if (e.target.tagName === 'A') return;  // don't hijack external links
            const rate = row.dataset.depositRate;
            const termMax = row.dataset.depositTermMax;
            const minAmount = row.dataset.depositMinAmount;
            if (rate)    rateEl.value = rate;
            if (termMax) termEl.value = Math.min(36, Number(termMax) || 12);
            if (minAmount && Number(amountEl.value) < Number(minAmount)) {
              amountEl.value = minAmount;
            }
            const bank = row.cells[0]?.textContent?.trim();
            const prod = row.cells[1]?.textContent?.trim();
            if (bank && prod && progLbl) {
              progLbl.classList.remove('hidden');
              progLbl.querySelector('span').textContent = `${bank} — ${prod}`;
            }
            compute();
            // Scroll calculator into view so user sees the result update.
            document.getElementById('deposit-calculator')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          });
        });

        compute();
      })();
    </script>
  <% end %>

