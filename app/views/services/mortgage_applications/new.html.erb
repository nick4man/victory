<%# Заявка на ипотеку %>
<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold text-gray-900 mb-6">Заявка на ипотеку</h1>

  <%= form_with url: services_mortgage_applications_path, method: :post, class: "bg-white rounded-lg shadow p-6 max-w-lg" do |f| %>
    <div class="space-y-4">
      <div>
        <%= f.label :name, "Ваше имя", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :name, required: true, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
      </div>
      <div>
        <%= f.label :phone, "Телефон", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.telephone_field :phone, required: true, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
      </div>
      <%= f.submit "Отправить заявку", class: "w-full bg-primary-600 text-white font-semibold py-3 rounded-lg hover:bg-primary-700 cursor-pointer" %>
    </div>
  <% end %>
</div>
