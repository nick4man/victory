<%# Главная страница АН «Виктори» — orchestration only.
    Phase 3 design sprint (29.05.26): 598 LOC → 12 partials + fragment cache.
    Cache discipline:
      * `cache 'key'` — static partials (version-bumpable)
      * `cache ['key', value]` — semi-dynamic с key driven by data freshness
      * `cache collection` — AR relation, invalidates on max(updated_at)
      * NOT cached: cta_form (CSRF token per request)
    Prerequisites: `bin/rails dev:cache` ON в dev; production cache_store = redis. %>
<% content_for :meta_tags do %>
  <%= tag.meta name: 'description', content: 'АН "Виктори" - надежное агентство недвижимости. Купить, продать или снять квартиру в Москве. Помощь с ипотекой и юридическим сопровождением.' %>
<% end %>

<% cache ['home/hero/v1', @statistics[:total_properties]] do %>
  <%= render 'hero', statistics: @statistics %>
<% end %>

<% cache ['home/quick_actions/v1', @statistics[:properties_for_sale], @statistics[:properties_for_rent]] do %>
  <%= render 'quick_actions', statistics: @statistics %>
<% end %>

<%# Cache key includes avg_response_time т.к. partial рендерит этот stat —
    без него обновление маскировалось бы до bump 'v1'. %>
<% cache ['home/why_choose_us/v1', @statistics[:avg_response_time]] do %>
  <%= render 'why_choose_us', statistics: @statistics %>
<% end %>

<%# Cache key включает все 4 счётчика partial'а; иначе stale visible (e.g.
    total_clients update без bump других ключей). %>
<% cache ['home/statistics/v1',
          @statistics[:total_properties], @statistics[:successful_deals],
          @statistics[:total_clients], @statistics[:this_week_new]] do %>
  <%= render 'statistics', statistics: @statistics %>
<% end %>

<%# cache_unless защищает от per-user state leak если Devise re-enable —
    каждый user видит свой favorited?-boolean. При Devise OFF (current state)
    user_signed_in? всегда false → cache работает normally. %>
<% if @featured_properties.present? %>
  <% cache_unless user_signed_in?, ['home/featured/v1', @featured_properties] do %>
    <%= render 'featured_properties', featured: @featured_properties %>
  <% end %>
<% end %>

<% if @latest_properties.present? %>
  <% cache ['home/latest/v1', @latest_properties] do %>
    <%= render 'latest_properties', latest: @latest_properties %>
  <% end %>
<% end %>

<% cache 'home/mortgage_calculator/v1' do %>
  <%= render 'mortgage_calculator' %>
<% end %>

<% if @virtual_tours.present? %>
  <% cache ['home/virtual_tours/v1', @virtual_tours] do %>
    <%= render 'virtual_tours', tours: @virtual_tours %>
  <% end %>
<% end %>

<% if @reviews.present? %>
  <% cache ['home/reviews/v1', @reviews] do %>
    <%= render 'reviews', reviews: @reviews %>
  <% end %>
<% end %>

<%# CTA form — НЕ cached. form_with method: :post эмитит CSRF token
    уникальный per request; кэширование сломает submit (TokenMismatch). %>
<%= render 'cta_form' %>

<% if @blog_posts.present? %>
  <% cache ['home/blog/v1', @blog_posts] do %>
    <%= render 'blog', blog_posts: @blog_posts %>
  <% end %>
<% end %>

<% cache 'home/trust_signals/v1' do %>
  <%= render 'trust_signals' %>
<% end %>

<%# Back-to-top button visibility toggle. Per-page-load inline JS, no Stimulus. %>
<%= content_for :scripts do %>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const backToTopButton = document.getElementById('back-to-top');
      if (backToTopButton) {
        window.addEventListener('scroll', function() {
          if (window.pageYOffset > 300) {
            backToTopButton.classList.remove('hidden');
          } else {
            backToTopButton.classList.add('hidden');
          }
        });
      }
    });
  </script>
<% end %>
