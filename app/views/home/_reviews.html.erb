<%# Customer reviews — 3-column grid. NB: ranks review.user.* — controller
    должен делать Review.includes(:user) (fixed в Commit 3 чтобы N+1 не был
    masked фрагмент-кэшем). %>
<section class="py-16 bg-white">
  <div class="container mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Отзывы наших клиентов</h2>
      <p class="text-xl text-gray-600">Более 1000 довольных клиентов</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <% reviews.take(3).each do |review| %>
        <div class="bg-gray-50 rounded-lg p-6 shadow-sm hover:shadow-md transition">
          <div class="flex items-center mb-4">
            <% 5.times do |i| %>
              <svg class="w-5 h-5 <%= i < review.rating ? 'text-yellow-400' : 'text-gray-300' %>" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            <% end %>
          </div>

          <p class="text-gray-700 mb-4"><%= review.body.truncate(150) %></p>

          <div class="flex items-center">
            <div class="w-10 h-10 bg-gray-300 rounded-full flex items-center justify-center text-gray-600 font-bold mr-3">
              <%= review.user.initials %>
            </div>
            <div>
              <div class="font-semibold text-gray-900"><%= review.user.full_name %></div>
              <div class="text-sm text-gray-500"><%= l(review.created_at, format: :short) %></div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="text-center mt-8">
      <%= link_to "Все отзывы", reviews_path, class: "text-primary-600 hover:text-primary-700 font-semibold" %>
    </div>
  </div>
</section>
