<% content_for :title, @meta_title %>
<% content_for :seo_description, @meta_description %>
<% content_for :canonical, url_for(only_path: false, host: request.host_with_port) %>
<%# OG image — use the hero variant of the first property in the matched
    set so the social-share preview shows actual matching inventory. Falls
    back to the layout's default if the landing is empty. %>
<% if (og_lead = @properties.first) && og_lead.images.attached? %>
  <% content_for :og_image, property_image_url(og_lead.images.first, variant: :hero) %>
<% end %>
<% content_for :head do %>
  <meta name="description" content="<%= @meta_description %>">

  <%# ItemList JSON-LD — exposes the listing as a curated collection so
      Yandex/Google can interpret each result card as a discrete entity
      within the landing's topic, not just inline links. %>
  <script type="application/ld+json">
  <%= raw({
    '@context' => 'https://schema.org',
    '@type' => 'CollectionPage',
    'name' => @h1,
    'description' => @meta_description,
    'url' => url_for(only_path: false, host: request.host_with_port),
    'mainEntity' => {
      '@type' => 'ItemList',
      'numberOfItems' => @total_count,
      'itemListElement' => @properties.each_with_index.map { |p, i|
        { '@type' => 'ListItem', 'position' => i + 1, 'url' => property_url(p), 'name' => p.title }
      }
    }
  }.to_json) %>
  </script>
<% end %>

<% content_slot = [
     "landings/content/#{@intent}_#{@type}_#{@district_slug || @rooms_raw}",
     "landings/content/#{@intent}_#{@type}"
   ].find { |p| lookup_context.exists?(p, [], true) } %>

<!-- Hero / H1 -->
<section class="px-6 lg:px-12 pt-32 pb-12 bg-background">
  <div class="max-w-6xl mx-auto">
    <p class="text-sm tracking-[0.4em] text-muted-foreground mb-4"><%= @intent == 'rent' ? 'АРЕНДА' : 'ПОКУПКА' %></p>
    <h1 class="text-4xl lg:text-5xl font-light tracking-wider text-foreground mb-6 uppercase"><%= @h1 %></h1>
    <p class="text-base text-muted-foreground leading-relaxed max-w-3xl">
      <% if @total_count.positive? %>
        В каталоге АН «Виктори» — <%= @total_count %> <%= @type_def[:plural_genitive] %>
        <%= @district_aliases ? "в районе #{@district_aliases.first}" : 'в Рязани и области' %>.
      <% else %>
        Сейчас в этом разрезе нет активных объектов в каталоге. Оставьте заявку —
        подберём по вашим параметрам, как только появится подходящий вариант.
      <% end %>
    </p>
  </div>
</section>

<!-- Optional editorial content slot (per-landing partial in landings/content/) -->
<% if content_slot %>
  <section class="px-6 lg:px-12 pb-12 bg-background">
    <div class="max-w-4xl mx-auto prose prose-lg text-foreground">
      <%= render content_slot %>
    </div>
  </section>
<% end %>

<!-- Listings -->
<% if @properties.any? %>
  <section class="px-6 lg:px-12 py-12 bg-background">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @properties.each do |property| %>
          <%= render 'properties/property_card', property: property %>
        <% end %>
      </div>
      <% if @total_count > @properties.size %>
        <div class="mt-12 text-center">
          <%= link_to "Смотреть весь каталог →",
                      properties_path(q: {
                        deal_type_eq: (@intent == 'rent' ? 'rent' : 'sale'),
                        district_eq: (@district_aliases&.first),
                        rooms_eq: @rooms
                      }.compact),
                      class: "inline-block text-sm tracking-[0.3em] text-foreground hover:text-muted-foreground transition-colors underline" %>
        </div>
      <% end %>
    </div>
  </section>
<% else %>
  <section class="px-6 lg:px-12 py-12 bg-background">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-sm text-muted-foreground mb-6">Похожие подборки:</p>
      <div class="flex flex-wrap gap-3 justify-center">
        <%= link_to "Все #{@type_def[:plural_genitive]} в Рязани", url_for(only_path: true, district: nil, rooms: nil),
                    class: "px-4 py-2 text-xs tracking-wider border border-border hover:border-foreground transition-colors" if (@district_slug || @rooms_raw) %>
        <%= link_to "Весь каталог →", properties_path,
                    class: "px-4 py-2 text-xs tracking-wider border border-border hover:border-foreground transition-colors" %>
      </div>
    </div>
  </section>
<% end %>
