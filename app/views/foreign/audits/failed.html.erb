<% content_for :title, 'Investment Audit — failed | Victory Real Estate' %>
<% content_for :html_lang, 'en' %>

<section class="px-6 lg:px-12 pt-32 pb-20 bg-background min-h-screen">
  <div class="max-w-2xl mx-auto text-center">
    <p class="text-xs tracking-[0.3em] text-muted-foreground uppercase mb-6">Audit failed</p>
    <h1 class="text-3xl lg:text-4xl font-light tracking-tight text-foreground mb-4">
      We couldn't complete the audit
    </h1>
    <p class="text-base text-muted-foreground leading-relaxed mb-10">
      Something went wrong on our side — likely a temporary issue with our analytics
      engine. Please try again, or contact our advisor for a manual analysis.
    </p>
    <div class="flex flex-col md:flex-row gap-4 justify-center">
      <%= link_to 'Try again', new_foreign_audit_path,
            class: 'inline-block px-8 py-4 bg-foreground text-background text-xs tracking-[0.3em] uppercase hover:bg-foreground/90 transition-colors' %>
      <%= link_to 'Contact advisor', foreign_path + '#contact',
            class: 'inline-block px-8 py-4 border border-border text-foreground text-xs tracking-[0.3em] uppercase hover:border-foreground/60 transition-colors' %>
    </div>
  </div>
</section>
