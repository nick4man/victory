<% content_for :title, t('foreign_audit.meta.title') %>
<% content_for :meta_description, t('foreign_audit.meta.description') %>
<% content_for :html_lang, 'en' %>

<section class="px-6 lg:px-12 py-24 lg:py-32 bg-background min-h-screen">
  <div class="max-w-3xl mx-auto">
    <p class="text-xs tracking-[0.3em] text-muted-foreground uppercase mb-6">
      <%= t('foreign_audit.new.eyebrow') %>
    </p>
    <h1 class="text-4xl lg:text-5xl font-light tracking-tight text-foreground mb-4">
      <%= t('foreign_audit.new.title') %>
    </h1>
    <p class="text-base text-muted-foreground leading-relaxed mb-12 max-w-2xl">
      <%= t('foreign_audit.new.subtitle') %>
    </p>

    <% if flash[:alert] %>
      <div class="mb-6 p-4 border border-red-700/40 bg-red-700/5 text-sm text-red-700">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <% if @valuation&.errors&.any? %>
      <div class="mb-6 p-4 border border-red-700/40 bg-red-700/5 text-sm text-red-700">
        <ul class="list-disc list-inside">
          <% @valuation.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @valuation, url: foreign_audits_path,
          method: :post, local: true,
          html: { class: 'space-y-10' } do |f| %>

      <%# Step 1 — Property %>
      <fieldset class="border-t border-border pt-8">
        <legend class="text-xs tracking-[0.25em] uppercase text-foreground mb-6 pb-2 -mt-3 bg-background px-3 -ml-3">
          <%= t('foreign_audit.new.step1_label') %>
        </legend>
        <div class="space-y-5">
          <div>
            <label for="property_valuation_property_type" class="block text-xs tracking-[0.2em] uppercase text-muted-foreground mb-2">
              <%= t('foreign_audit.new.property_type') %>
            </label>
            <%= f.select :property_type,
                  [
                    ['Apartment', 'apartment'],
                    ['House', 'house'],
                    ['Land', 'land'],
                    ['Commercial', 'commercial'],
                    ['Room', 'room'],
                    ['Garage', 'garage']
                  ],
                  {},
                  class: 'w-full px-4 py-3 bg-transparent border border-border focus:border-foreground outline-none text-base text-foreground' %>
          </div>
          <div>
            <label for="property_valuation_address" class="block text-xs tracking-[0.2em] uppercase text-muted-foreground mb-2">
              <%= t('foreign_audit.new.address') %>
            </label>
            <%= f.text_field :address, required: true,
                  placeholder: 'e.g. Ryazan, Tsentr district, ul. Lenina, 15',
                  class: 'w-full px-4 py-3 bg-transparent border border-border focus:border-foreground outline-none text-base text-foreground placeholder:text-muted-foreground/50' %>
          </div>
          <div>
            <label for="property_valuation_total_area" class="block text-xs tracking-[0.2em] uppercase text-muted-foreground mb-2">
              <%= t('foreign_audit.new.area') %>
            </label>
            <%= f.number_field :total_area, required: true, step: 0.1, min: 1,
                  placeholder: '65',
                  class: 'w-full px-4 py-3 bg-transparent border border-border focus:border-foreground outline-none text-base text-foreground placeholder:text-muted-foreground/50' %>
          </div>
        </div>
      </fieldset>

      <%# Step 2 — Financials %>
      <fieldset class="border-t border-border pt-8">
        <legend class="text-xs tracking-[0.25em] uppercase text-foreground mb-6 pb-2 -mt-3 bg-background px-3 -ml-3">
          <%= t('foreign_audit.new.step2_label') %>
        </legend>
        <div class="space-y-5">
          <div>
            <label for="property_valuation_estimated_price" class="block text-xs tracking-[0.2em] uppercase text-muted-foreground mb-2">
              <%= t('foreign_audit.new.asking_price_rub') %>
            </label>
            <%= f.number_field :estimated_price, required: true, min: 100_000,
                  placeholder: '5,000,000',
                  class: 'w-full px-4 py-3 bg-transparent border border-border focus:border-foreground outline-none text-base text-foreground placeholder:text-muted-foreground/50' %>
            <p class="mt-2 text-xs text-muted-foreground/70 leading-relaxed">
              <%= t('foreign_audit.new.asking_price_help') %>
              <% if @rates && @rates[:usd] %>
                <span class="block mt-1 text-foreground/60">
                  Current rate: 1 USD ≈ <%= @rates[:usd].to_f.round(1) %> RUB
                  <% if @rates[:eur] %>· 1 EUR ≈ <%= @rates[:eur].to_f.round(1) %> RUB<% end %>
                  <% if @rates[:aed] %>· 1 AED ≈ <%= @rates[:aed].to_f.round(2) %> RUB<% end %>
                </span>
              <% end %>
            </p>
          </div>
        </div>
      </fieldset>

      <%# Step 3 — Contact %>
      <fieldset class="border-t border-border pt-8">
        <legend class="text-xs tracking-[0.25em] uppercase text-foreground mb-6 pb-2 -mt-3 bg-background px-3 -ml-3">
          <%= t('foreign_audit.new.step3_label') %>
        </legend>
        <div class="space-y-5">
          <div>
            <label for="property_valuation_name" class="block text-xs tracking-[0.2em] uppercase text-muted-foreground mb-2">
              <%= t('foreign_audit.new.name') %>
            </label>
            <%= f.text_field :name, required: true,
                  placeholder: 'John Smith',
                  class: 'w-full px-4 py-3 bg-transparent border border-border focus:border-foreground outline-none text-base text-foreground placeholder:text-muted-foreground/50' %>
          </div>
          <div>
            <label for="property_valuation_email" class="block text-xs tracking-[0.2em] uppercase text-muted-foreground mb-2">
              <%= t('foreign_audit.new.email') %>
            </label>
            <%= f.email_field :email, required: true,
                  placeholder: 'name@example.com',
                  class: 'w-full px-4 py-3 bg-transparent border border-border focus:border-foreground outline-none text-base text-foreground placeholder:text-muted-foreground/50' %>
          </div>
          <div>
            <label for="property_valuation_phone" class="block text-xs tracking-[0.2em] uppercase text-muted-foreground mb-2">
              <%= t('foreign_audit.new.phone') %>
            </label>
            <%= f.telephone_field :phone, required: true,
                  placeholder: '+1 555 123 4567',
                  class: 'w-full px-4 py-3 bg-transparent border border-border focus:border-foreground outline-none text-base text-foreground placeholder:text-muted-foreground/50' %>
          </div>
        </div>
      </fieldset>

      <div class="border-t border-border pt-8">
        <%= f.submit t('foreign_audit.new.submit'),
              class: 'w-full md:w-auto px-12 py-4 bg-foreground text-background text-xs tracking-[0.3em] uppercase hover:bg-foreground/90 transition-colors cursor-pointer' %>
        <p class="mt-4 text-xs text-muted-foreground/70">
          <%= t('foreign_audit.new.submit_help') %>
        </p>
        <p class="mt-6 text-xs text-muted-foreground/50 leading-relaxed max-w-2xl">
          <%= t('foreign_audit.new.disclaimer') %>
        </p>
      </div>
    <% end %>
  </div>
</section>
