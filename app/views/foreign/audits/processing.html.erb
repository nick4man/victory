<% content_for :title, t('foreign_audit.processing.title') + ' — Victory Real Estate' %>
<% content_for :html_lang, 'en' %>

<%# EN processing page для foreign audit. Mirrors patterns from
    property_valuations/processing.html.erb but в EN locale. Pulls 5 stages
    (vs 4 в express) because Monte Carlo adds heavier load — budget ~45s. %>

<section class="px-6 lg:px-12 pt-32 pb-20 bg-background min-h-screen">
  <div class="max-w-3xl mx-auto text-center"
       data-valuation-token="<%= @valuation.token %>"
       data-valuation-status="<%= @valuation.status %>">
    <p class="text-sm tracking-[0.4em] text-muted-foreground mb-6">
      <%= t('foreign_audit.processing.title').upcase %>
    </p>

    <div class="inline-block animate-spin mb-6">
      <svg class="w-12 h-12 text-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="10" stroke-width="2" opacity="0.2"/>
        <path d="M12 2a10 10 0 0 1 10 10" stroke-width="2"/>
      </svg>
    </div>

    <h1 class="text-3xl lg:text-4xl font-light tracking-tight text-foreground mb-3">
      <%= t('foreign_audit.processing.title') %>
    </h1>
    <p class="text-base text-muted-foreground max-w-xl mx-auto mb-2">
      <%= t('foreign_audit.processing.subtitle') %>
    </p>
    <p class="text-2xl text-foreground font-light mb-10">
      <span id="countdown-label">About</span>
      <span id="countdown-value">~45</span>
      <span id="countdown-unit">seconds left</span>
    </p>

    <ol class="max-w-md mx-auto text-left space-y-3 mb-10" id="stage-list">
      <li class="flex items-start gap-3" data-stage="0" data-stage-from="0" data-stage-to="9">
        <span class="stage-icon flex-shrink-0 w-6 h-6 rounded-full border border-border flex items-center justify-center text-xs text-muted-foreground">1</span>
        <span class="stage-text text-sm text-muted-foreground"><%= t('foreign_audit.processing.stages.comparables') %></span>
      </li>
      <li class="flex items-start gap-3" data-stage="1" data-stage-from="9" data-stage-to="18">
        <span class="stage-icon flex-shrink-0 w-6 h-6 rounded-full border border-border flex items-center justify-center text-xs text-muted-foreground">2</span>
        <span class="stage-text text-sm text-muted-foreground"><%= t('foreign_audit.processing.stages.market_data') %></span>
      </li>
      <li class="flex items-start gap-3" data-stage="2" data-stage-from="18" data-stage-to="30">
        <span class="stage-icon flex-shrink-0 w-6 h-6 rounded-full border border-border flex items-center justify-center text-xs text-muted-foreground">3</span>
        <span class="stage-text text-sm text-muted-foreground"><%= t('foreign_audit.processing.stages.monte_carlo') %></span>
      </li>
      <li class="flex items-start gap-3" data-stage="3" data-stage-from="30" data-stage-to="40">
        <span class="stage-icon flex-shrink-0 w-6 h-6 rounded-full border border-border flex items-center justify-center text-xs text-muted-foreground">4</span>
        <span class="stage-text text-sm text-muted-foreground"><%= t('foreign_audit.processing.stages.visa') %></span>
      </li>
      <li class="flex items-start gap-3" data-stage="4" data-stage-from="40" data-stage-to="45">
        <span class="stage-icon flex-shrink-0 w-6 h-6 rounded-full border border-border flex items-center justify-center text-xs text-muted-foreground">5</span>
        <span class="stage-text text-sm text-muted-foreground"><%= t('foreign_audit.processing.stages.report') %></span>
      </li>
    </ol>

    <p class="text-xs tracking-[0.3em] text-muted-foreground/70 uppercase" id="poll-status">
      Connecting…
    </p>
  </div>
</section>

<noscript>
  <meta http-equiv="refresh" content="10">
</noscript>

<script>
  (function () {
    var token = <%= @valuation.token.to_json.html_safe %>;
    var pollEl = document.getElementById('poll-status');
    var countdownEl = document.getElementById('countdown-value');
    var countdownLabelEl = document.getElementById('countdown-label');
    var countdownUnitEl = document.getElementById('countdown-unit');
    var stages = document.querySelectorAll('#stage-list li[data-stage]');

    var startedAt = Date.now();
    var BUDGET_SEC = 45;
    var INTERVAL_MS = 4000;
    var TICK_MS = 1000;
    var MAX_MS = 180000;

    function setPoll(s) { if (pollEl) pollEl.textContent = s; }

    function updateCountdown() {
      var elapsedSec = Math.round((Date.now() - startedAt) / 1000);
      var remaining = BUDGET_SEC - elapsedSec;
      if (remaining > 0) {
        countdownLabelEl.textContent = 'About';
        countdownEl.textContent = '~' + remaining;
        countdownUnitEl.textContent = remaining === 1 ? 'second left' : 'seconds left';
      } else {
        countdownLabelEl.textContent = 'Almost done';
        countdownEl.textContent = '…';
        countdownUnitEl.textContent = '';
      }
    }

    function updateStages() {
      var elapsedSec = Math.round((Date.now() - startedAt) / 1000);
      var activeFound = false;
      stages.forEach(function (li) {
        var from = parseInt(li.getAttribute('data-stage-from'), 10);
        var to = parseInt(li.getAttribute('data-stage-to'), 10);
        var icon = li.querySelector('.stage-icon');
        var text = li.querySelector('.stage-text');
        if (elapsedSec >= to) {
          icon.textContent = '✓';
          icon.classList.remove('border-border', 'text-muted-foreground');
          icon.classList.add('bg-foreground', 'border-foreground', 'text-background');
          text.classList.remove('text-muted-foreground');
          text.classList.add('text-foreground/70');
          return;
        }
        if (!activeFound && elapsedSec >= from) {
          icon.textContent = '→';
          icon.classList.remove('border-border', 'text-muted-foreground');
          icon.classList.add('border-foreground', 'text-foreground');
          text.classList.remove('text-muted-foreground');
          text.classList.add('text-foreground');
          activeFound = true;
        }
      });
    }

    function tick() {
      updateCountdown();
      updateStages();
    }

    function poll() {
      if (Date.now() - startedAt > MAX_MS) {
        setPoll('Timeout — please refresh the page in a minute.');
        clearInterval(pollTimer);
        clearInterval(tickTimer);
        return;
      }
      fetch('/foreign/audits/' + encodeURIComponent(token) + '/status', {
        headers: { Accept: 'application/json' },
        cache: 'no-store'
      })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (data) {
          if (!data) return;
          if (data.status === 'completed') {
            setPoll('Done — opening report…');
            clearInterval(pollTimer);
            clearInterval(tickTimer);
            stages.forEach(function (li) {
              var icon = li.querySelector('.stage-icon');
              icon.textContent = '✓';
              icon.classList.add('bg-foreground', 'border-foreground', 'text-background');
            });
            setTimeout(function () { window.location.reload(); }, 600);
          } else if (data.status === 'failed') {
            setPoll('Audit failed — redirecting…');
            clearInterval(pollTimer);
            clearInterval(tickTimer);
            setTimeout(function () { window.location.reload(); }, 1500);
          }
        })
        .catch(function (e) { console.warn('[foreign-audit-poll] failed', e); });
    }

    setPoll('Running…');
    tick();
    var tickTimer = setInterval(tick, TICK_MS);
    var pollTimer = setInterval(poll, INTERVAL_MS);
    poll();
  })();
</script>
