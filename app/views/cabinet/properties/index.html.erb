<% content_for :title, 'Мои объекты — личный кабинет АН Виктори' %>

<section class="px-6 lg:px-12 py-16 lg:py-24 bg-background min-h-screen">
  <div class="max-w-6xl mx-auto">
    <p class="text-xs tracking-[0.3em] text-muted-foreground uppercase mb-3">
      Личный кабинет
    </p>
    <h1 class="text-3xl lg:text-4xl font-light tracking-tight text-foreground mb-3">
      Мои объекты
    </h1>
    <p class="text-sm text-muted-foreground leading-relaxed mb-10 max-w-2xl">
      Объекты, привязанные к вашему аккаунту (синхронизированы из CRM
      агентства). Здесь вы видите весь жизненный цикл: на сайте,
      готовится к публикации, продано, скрыто.
    </p>

    <% if @counts[:total].zero? %>
      <div class="border border-border p-8 lg:p-12 bg-card text-center">
        <p class="text-base text-muted-foreground leading-relaxed mb-4">
          У вас пока нет привязанных объектов. Если вы продаёте или
          сдаёте недвижимость через АН «Виктори», свяжитесь с агентом —
          он привяжет объект к вашему кабинету.
        </p>
        <%= link_to 'Связаться с агентом', contacts_path,
              class: 'inline-block px-6 py-3 bg-foreground text-background text-xs tracking-[0.3em] uppercase hover:bg-foreground/90 transition-colors' %>
      </div>
    <% else %>
      <%# Summary counts %>
      <div class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-12">
        <% [
          [:on_site,   '🟢 На сайте',         'border-emerald-500/30 bg-emerald-500/5 text-emerald-300'],
          [:not_ready, '⚠ Готовится',        'border-amber-500/30 bg-amber-500/5 text-amber-300'],
          [:hidden,    '🚫 Скрыто',           'border-rose-500/30 bg-rose-500/5 text-rose-300'],
          [:sold,      '✓ Продано',           'border-zinc-500/30 bg-zinc-500/5 text-zinc-300'],
          [:archived,  '· Архив',             'border-border bg-card text-muted-foreground']
        ].each do |key, label, css| %>
          <div class="border px-4 py-3 <%= css %>">
            <p class="text-[10px] tracking-[0.2em] uppercase opacity-80"><%= label %></p>
            <p class="text-2xl font-light mt-1"><%= @counts[key] %></p>
          </div>
        <% end %>
      </div>

      <%# Per-group sections %>
      <%
        sections = [
          [:on_site,   '🟢 На сайте — публикация активна',
                       'Ваши объекты сейчас видны посетителям victory62.org'],
          [:not_ready, '⚠ Готовится к публикации',
                       'Эти объекты пока не показываются — нужны фото, описание или иной CRM-фикс. Свяжитесь с агентом'],
          [:hidden,    '🚫 Скрыто администратором',
                       'Снято с сайта решением АН (force_archive). Для возобновления — свяжитесь с агентом'],
          [:sold,      '✓ Продано / сделка завершена',
                       'Объекты с завершённой или активной сделкой — больше не на сайте'],
          [:archived,  '· Архив',
                       'Старые записи, не синхронизируются с CRM']
        ]
      %>
      <% sections.each do |key, header, hint| %>
        <% items = @groups[key] || [] %>
        <% next if items.empty? %>

        <section class="mb-12 lg:mb-16 border-t border-border pt-8">
          <h2 class="text-base font-light tracking-tight text-foreground mb-2">
            <%= header %> · <span class="text-muted-foreground">(<%= items.size %>)</span>
          </h2>
          <p class="text-xs text-muted-foreground mb-6 max-w-xl"><%= hint %></p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <% items.each do |p| %>
              <article class="border border-border bg-card p-5 flex flex-col gap-3">
                <div class="flex items-start justify-between gap-3">
                  <div class="flex-1">
                    <%
                      title_parts = [p.property_type&.name]
                      title_parts << "#{p.rooms}-комн" if p.rooms.to_i.positive?
                    %>
                    <p class="text-sm font-light text-foreground leading-snug">
                      <%= title_parts.compact.join(' · ') %>
                    </p>
                    <p class="text-xs text-muted-foreground mt-1"><%= p.address.to_s.truncate(80) %></p>
                  </div>
                  <div class="text-right shrink-0">
                    <p class="text-sm text-foreground"><%= number_with_delimiter(p.price.to_i, delimiter: ' ') %> ₽</p>
                    <% if (area = p.try(:area) || p.try(:total_area)).present? && area.to_f.positive? %>
                      <p class="text-xs text-muted-foreground"><%= area.to_f.round(1) %> м²</p>
                    <% end %>
                  </div>
                </div>

                <%# CRM external advertising status — informational only %>
                <div class="flex items-center gap-2 flex-wrap text-[10px]">
                  <span class="text-muted-foreground/70 tracking-wider uppercase">Внешн. реклама:</span>
                  <% if p.in_ad? %>
                    <span class="px-2 py-0.5 bg-blue-500/10 text-blue-300 border border-blue-500/30">Avito/Cian</span>
                  <% end %>
                  <% if p.in_mls? %>
                    <span class="px-2 py-0.5 bg-purple-500/10 text-purple-300 border border-purple-500/30">MLS</span>
                  <% end %>
                  <% unless p.outbound_advertised? %>
                    <span class="text-muted-foreground/60">— только сайт</span>
                  <% end %>
                </div>

                <%# Blockers — only show если есть %>
                <% blockers = p.publication_blockers %>
                <% if blockers.any? && key == :not_ready %>
                  <div class="text-[11px] text-amber-300/80 border-t border-border pt-2">
                    Чтобы появился на сайте, нужно: <%= blockers.join(' · ') %>
                  </div>
                <% end %>

                <%# D4 UI — sales pipeline (только для on_site/sold/hidden, у not_ready+archived без заявок) %>
                <%= render 'lead_timeline', stage_counts: @stage_pipeline[p.id] || {} %>

                <%# Actions %>
                <div class="flex items-center justify-between gap-2 text-xs border-t border-border pt-3">
                  <% if p.status_active? && p.try(:slug).present? %>
                    <%= link_to 'Посмотреть на сайте →', property_path(p),
                          target: '_blank', rel: 'noopener',
                          class: 'text-emerald-300 hover:text-foreground tracking-wider' %>
                  <% else %>
                    <span class="text-muted-foreground/60 text-[10px]">не доступен публично</span>
                  <% end %>
                  <span class="text-[10px] text-muted-foreground/50">
                    Обновлён: <%= I18n.l(p.updated_at.to_date) rescue p.updated_at.to_date %>
                  </span>
                </div>
              </article>
            <% end %>
          </div>
        </section>
      <% end %>
    <% end %>
  </div>
</section>
