<% content_for :title, "Новый пароль — #{AgencyInfo::NAME}" %>

<section class="px-6 lg:px-12 py-24 lg:py-32 bg-background min-h-screen">
  <div class="max-w-md mx-auto">
    <p class="text-xs tracking-[0.3em] text-muted-foreground uppercase mb-6">Личный кабинет</p>
    <h1 class="text-3xl lg:text-4xl font-light tracking-tight text-foreground mb-3">
      Новый пароль
    </h1>
    <p class="text-sm text-muted-foreground leading-relaxed mb-10">
      Введите новый пароль. Минимум 8 символов.
    </p>

    <% if flash[:alert] %>
      <div class="mb-6 p-4 border border-red-700/40 bg-red-700/5 text-sm text-red-700">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with url: cabinet_password_path, method: :patch, local: true, html: { class: 'space-y-5' } do %>
      <%= hidden_field_tag :token, @token.token %>

      <div>
        <label for="password" class="block text-xs tracking-[0.2em] uppercase text-muted-foreground mb-2">
          Новый пароль
        </label>
        <%= password_field_tag :password, nil, required: true, minlength: 8,
              autocomplete: 'new-password',
              placeholder: 'минимум 8 символов',
              class: 'w-full px-4 py-3 bg-transparent border border-border focus:border-foreground outline-none text-base text-foreground placeholder:text-muted-foreground/50' %>
      </div>

      <div>
        <label for="password_confirmation" class="block text-xs tracking-[0.2em] uppercase text-muted-foreground mb-2">
          Подтвердите пароль
        </label>
        <%= password_field_tag :password_confirmation, nil, required: true, minlength: 8,
              autocomplete: 'new-password',
              placeholder: 'повторите пароль',
              class: 'w-full px-4 py-3 bg-transparent border border-border focus:border-foreground outline-none text-base text-foreground placeholder:text-muted-foreground/50' %>
      </div>

      <button type="submit"
              class="w-full px-6 py-3 bg-foreground text-background text-xs tracking-[0.3em] uppercase hover:bg-foreground/90 transition-colors">
        Установить пароль
      </button>
    <% end %>
  </div>
</section>
