<% content_for :title, "Личный кабинет — #{AgencyInfo::NAME}" %>
<%
  # Linkage logic — связываем records по user_id + email + phone last-10-digits.
  email = cabinet_user.email.to_s.downcase
  phone_digits = cabinet_user.phone.to_s.gsub(/\D/, '').last(10)

  inquiries = Inquiry.where(user_id: cabinet_user.id)
                     .or(Inquiry.where('LOWER(email) = ?', email))
  if phone_digits.length == 10
    inquiries = inquiries.or(Inquiry.where('phone LIKE ?', "%#{phone_digits}"))
  end
  inquiries = inquiries.order(created_at: :desc).limit(20)

  valuations = PropertyValuation.where(user_id: cabinet_user.id)
                                .or(PropertyValuation.where('LOWER(email) = ?', email))
  if phone_digits.length == 10
    valuations = valuations.or(PropertyValuation.where('phone LIKE ?', "%#{phone_digits}"))
  end
  valuations = valuations.order(created_at: :desc).limit(20)

  status_label = {
    'new' => 'Новая', 'contacted' => 'В работе',
    'in_progress' => 'Подбор', 'scheduled' => 'Запланирован показ',
    'completed' => 'Завершено', 'cancelled' => 'Отменено',
    'spam' => 'Закрыто'
  }
  status_color = {
    'new' => 'bg-foreground/10 text-foreground',
    'contacted' => 'bg-amber-500/10 text-amber-700',
    'in_progress' => 'bg-blue-500/10 text-blue-700',
    'scheduled' => 'bg-purple-500/10 text-purple-700',
    'completed' => 'bg-emerald-500/10 text-emerald-700',
    'cancelled' => 'bg-muted text-muted-foreground',
    'spam' => 'bg-muted text-muted-foreground'
  }
  priority_label = { 'urgent' => '🔥 Срочно', 'high' => '⚡ Высокий', 'normal' => '' }
%>

<section class="px-6 lg:px-12 py-16 lg:py-24 bg-background min-h-screen">
  <div class="max-w-5xl mx-auto">
    <header class="flex justify-between items-start mb-16">
      <div>
        <p class="text-xs tracking-[0.3em] text-muted-foreground uppercase mb-4">Личный кабинет</p>
        <h1 class="text-3xl lg:text-4xl font-light tracking-tight text-foreground">
          Здравствуйте<%= ", #{cabinet_user.first_name}" if cabinet_user.first_name.present? %>
        </h1>
        <p class="text-sm text-muted-foreground mt-2">
          Ваши заявки, оценки и история взаимодействий с агентством
        </p>
      </div>
      <div class="flex items-center gap-6">
        <%= link_to cabinet_profile_path,
              class: 'text-xs tracking-[0.2em] uppercase text-muted-foreground hover:text-foreground transition-colors' do %>
          Профиль<% if cabinet_user.tg_user_id.present? %> <span class="text-emerald-500">·TG</span><% end %>
        <% end %>
        <%= button_to cabinet_logout_path, method: :delete,
              class: 'text-xs tracking-[0.2em] uppercase text-muted-foreground hover:text-foreground transition-colors',
              form: { data: { turbo: false } } do %>
          Выйти →
        <% end %>
      </div>
    </header>

    <!-- INQUIRIES -->
    <div class="mb-16" data-cabinet-section="inquiries">
      <div class="flex items-baseline justify-between mb-6">
        <h2 class="text-xl font-light tracking-tight text-foreground">Мои заявки</h2>
        <div class="flex items-center gap-3">
          <span class="text-xs tracking-wider text-muted-foreground" id="cabinet-status-indicator">
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1 animate-pulse"></span>
            обновляется
          </span>
          <span class="text-xs tracking-wider text-muted-foreground"><%= inquiries.length %> всего</span>
        </div>
      </div>
      <% if inquiries.empty? %>
        <div class="border border-border p-6 text-sm text-muted-foreground">
          У вас пока нет активных заявок. Оставьте заявку через
          <%= link_to 'форму на сайте', root_path, class: 'underline hover:text-foreground' %>,
          и она появится здесь.
        </div>
      <% else %>
        <div class="border border-border divide-y divide-border">
          <% inquiries.each do |i| %>
            <%
              # Status timeline stages — order matters. Cancelled/spam = closed states (показываем по-другому).
              stages = %w[new contacted in_progress scheduled completed]
              current_index = stages.index(i.status.to_s) || -1
              terminal_closed = %w[cancelled spam].include?(i.status.to_s)
            %>
            <div class="p-5" data-inquiry-id="<%= i.id %>">
              <div class="flex flex-wrap items-start justify-between gap-3 mb-2">
                <div class="flex items-center gap-3">
                  <span class="text-xs tracking-wider <%= status_color[i.status.to_s] || 'bg-muted text-muted-foreground' %> px-2 py-1" data-inquiry-status>
                    <%= status_label[i.status.to_s] || i.status %>
                  </span>
                  <% if priority_label[i.priority.to_s].present? %>
                    <span class="text-xs tracking-wider text-foreground" data-inquiry-priority>
                      <%= priority_label[i.priority.to_s] %>
                    </span>
                  <% end %>
                  <span class="text-xs text-muted-foreground/70">
                    <%= I18n.t("inquiry_types.#{i.inquiry_type}", default: i.inquiry_type.to_s.humanize) %>
                  </span>
                </div>
                <span class="text-xs text-muted-foreground/70">
                  <%= i.created_at.strftime('%d.%m.%y') %>
                </span>
              </div>

              <%# Status timeline visualizer — 5-stage progress bar. Terminal closed states show as muted "Закрыто". %>
              <% unless terminal_closed %>
                <div class="flex items-center gap-1 mt-3 mb-2">
                  <% stages.each_with_index do |stage, idx| %>
                    <% reached = current_index >= idx %>
                    <% is_current = current_index == idx %>
                    <div class="flex items-center gap-1 flex-1">
                      <span class="<%= reached ? 'bg-foreground' : 'bg-border' %> h-1 flex-1 transition-colors"></span>
                      <% if is_current %>
                        <span class="text-[10px] tracking-widest text-foreground uppercase whitespace-nowrap">
                          <%= status_label[stage] %>
                        </span>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <p class="text-xs text-muted-foreground mt-3">
                  <%= status_label[i.status.to_s] %>
                </p>
              <% end %>

              <% if i.message.present? %>
                <p class="text-sm text-foreground leading-relaxed mt-3"><%= truncate(i.message, length: 200) %></p>
              <% end %>
              <% if i.agent_id.present? %>
                <% agent = User.find_by(id: i.agent_id) %>
                <% if agent %>
                  <p class="text-xs text-muted-foreground mt-3">
                    Ведёт: <%= [agent.first_name, agent.last_name].compact_blank.join(' ').presence || agent.email %>
                  </p>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- VALUATIONS -->
    <div class="mb-16">
      <div class="flex items-baseline justify-between mb-6">
        <h2 class="text-xl font-light tracking-tight text-foreground">Мои оценки</h2>
        <span class="text-xs tracking-wider text-muted-foreground"><%= valuations.length %> всего</span>
      </div>
      <% if valuations.empty? %>
        <div class="border border-border p-6 text-sm text-muted-foreground">
          У вас пока нет онлайн-оценок.
          <%= link_to 'Получить оценку →', new_property_valuation_path, class: 'underline hover:text-foreground' %>
        </div>
      <% else %>
        <div class="grid md:grid-cols-2 gap-4">
          <% valuations.each do |v| %>
            <%= link_to result_property_valuations_path(token: v.token), class: 'block border border-border p-5 hover:border-foreground transition-colors' do %>
              <p class="text-sm text-foreground font-light mb-1">
                <%= truncate(v.address.to_s, length: 60) %>
              </p>
              <p class="text-xs text-muted-foreground mb-3">
                <%= v.total_area %> м² · <%= I18n.t("property_types.#{v.property_type}", default: v.property_type) %>
                <% if v.rooms.present? && v.rooms.positive? %> · <%= v.rooms %>-комн<% end %>
              </p>
              <% if v.estimated_price.present? && v.estimated_price.positive? %>
                <p class="text-lg font-light text-foreground">
                  <%= number_to_currency(v.estimated_price, precision: 0, unit: '₽', format: '%n %u', delimiter: ' ') %>
                </p>
                <% if v.confidence_level.present? %>
                  <p class="text-xs text-muted-foreground mt-1">
                    Достоверность: <%= (v.confidence_level.to_f * 100).round %>%
                  </p>
                <% end %>
              <% else %>
                <p class="text-xs text-amber-700">
                  <%= v.status == 'failed' ? 'Не удалось рассчитать' : 'Рассчитывается…' %>
                </p>
              <% end %>
              <p class="text-xs text-muted-foreground/70 mt-3 tracking-wider">
                <%= v.created_at.strftime('%d.%m.%y') %>
              </p>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- FAVORITES (Phase 2) -->
    <%
      favorite_properties = cabinet_user.favorites
                                        .includes(:property)
                                        .recent
                                        .limit(12)
                                        .map(&:property)
                                        .compact
                                        .reject { |p| p.try(:deleted?) }
    %>
    <div class="mb-16">
      <div class="flex items-baseline justify-between mb-6">
        <h2 class="text-xl font-light tracking-tight text-foreground">Избранное</h2>
        <span class="text-xs tracking-wider text-muted-foreground">
          <%= favorite_properties.size %>
          <% if cabinet_user.favorites.count > favorite_properties.size %>
            из <%= cabinet_user.favorites.count %>
          <% end %>
        </span>
      </div>
      <% if favorite_properties.empty? %>
        <div class="border border-border p-6 text-sm text-muted-foreground">
          Вы пока не сохранили ни одного объекта. Откройте
          <%= link_to 'каталог', properties_path, class: 'underline hover:text-foreground' %>
          и нажмите на сердечко рядом с понравившейся карточкой —
          сохранённые объекты будут отображаться здесь.
        </div>
      <% else %>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
          <% favorite_properties.each do |property| %>
            <%= render 'properties/property_card', property: property, priority_image: false %>
          <% end %>
        </div>
        <% if cabinet_user.favorites.count > favorite_properties.size %>
          <p class="mt-4 text-xs tracking-wider text-muted-foreground">
            <%= link_to 'Открыть все избранные →', cabinet_favorites_path,
                  class: 'underline hover:text-foreground' %>
          </p>
        <% end %>
      <% end %>
    </div>

    <!-- CONTACT -->
    <div class="border-t border-border pt-8">
      <p class="text-xs tracking-[0.3em] text-muted-foreground uppercase mb-3">Связь с агентством</p>
      <p class="text-sm text-foreground">
        <% if (phone = (AgencyInfo::PHONE_PRIMARY rescue nil)).present? %>
          <%= link_to phone, "tel:#{phone}", class: 'hover:text-muted-foreground' %> ·
        <% end %>
        <%= mail_to (AgencyInfo::EMAIL rescue 'info@victory62.org'), nil, class: 'hover:text-muted-foreground' %>
      </p>
    </div>
  </div>
</section>

<%# A7 Phase 2: client-side polling для "real-time-ish" обновлений.
    ActionCable JS infra отключена в проекте — используем простое
    fetch-polling на /cabinet/status.json. На сервере CabinetChannel
    broadcast'ы продолжают fire'иться (ready для WebSocket activation). %>
<script>
(function() {
  var POLL_MS = 10000;
  var lastSnapshot = null;
  var indicator = document.getElementById('cabinet-status-indicator');

  function setIndicator(state, label) {
    if (!indicator) return;
    while (indicator.firstChild) indicator.removeChild(indicator.firstChild);
    var dot = document.createElement('span');
    var colorClass = ({ live: 'bg-emerald-500', updating: 'bg-amber-500', error: 'bg-red-500' })[state] || 'bg-muted';
    dot.className = 'inline-block w-1.5 h-1.5 rounded-full ' + colorClass + ' mr-1' +
                    (state === 'updating' ? ' animate-pulse' : '');
    indicator.appendChild(dot);
    indicator.appendChild(document.createTextNode(label));
  }

  function takeSnapshot(data) {
    return (data.inquiries || []).map(function(i) {
      return i.id + ':' + i.status + ':' + i.priority + ':' + i.updated_at;
    }).concat((data.valuations || []).map(function(v) {
      return 'v' + v.id + ':' + v.status + ':' + v.estimated_price + ':' + v.updated_at;
    })).join('|');
  }

  function poll() {
    setIndicator('updating', 'обновляется');
    fetch('/cabinet/status.json', { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })
      .then(function(r) { return r.ok ? r.json() : null; })
      .then(function(data) {
        if (!data) { setIndicator('error', 'ошибка'); return; }
        var snap = takeSnapshot(data);
        if (lastSnapshot !== null && snap !== lastSnapshot) {
          setIndicator('live', 'обновление…');
          window.location.reload();
          return;
        }
        lastSnapshot = snap;
        setIndicator('live', 'актуально');
      })
      .catch(function(e) {
        console.warn('[cabinet-poll]', e);
        setIndicator('error', 'оффлайн');
      });
  }

  poll();
  setInterval(poll, POLL_MS);
})();
</script>
