<% content_for :title, "Вход в кабинет — #{AgencyInfo::NAME}" %>
<% content_for :meta_description, 'Личный кабинет клиентов и сотрудников АН «Виктори». Вход по email — без пароля.' %>

<section class="px-6 lg:px-12 py-24 lg:py-32 bg-background min-h-screen">
  <div class="max-w-md mx-auto">
    <p class="text-xs tracking-[0.3em] text-muted-foreground uppercase mb-6">Личный кабинет</p>
    <h1 class="text-3xl lg:text-4xl font-light tracking-tight text-foreground mb-3">
      Вход без пароля
    </h1>
    <p class="text-sm text-muted-foreground leading-relaxed mb-10">
      Введите email — мы отправим одноразовую ссылку для входа.
      Ссылка действительна 30 минут и работает один раз.
    </p>

    <% if flash[:notice] %>
      <div class="mb-6 p-4 border border-foreground/20 bg-foreground/5 text-sm text-foreground">
        <%= flash[:notice] %>
      </div>
    <% end %>
    <% if flash[:alert] %>
      <div class="mb-6 p-4 border border-red-700/40 bg-red-700/5 text-sm text-red-700">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with url: cabinet_request_link_path, method: :post, local: true, html: { class: 'space-y-6' } do |f| %>
      <div>
        <label for="identifier" class="block text-xs tracking-[0.2em] uppercase text-muted-foreground mb-2">
          Email
        </label>
        <%= text_field_tag :identifier, params[:identifier], required: true,
              type: 'email',
              autocomplete: 'email',
              placeholder: 'name@example.com',
              class: 'w-full px-4 py-3 bg-transparent border border-border focus:border-foreground outline-none text-base text-foreground placeholder:text-muted-foreground/50' %>
      </div>

      <button type="submit"
              class="w-full px-6 py-3 bg-foreground text-background text-xs tracking-[0.3em] uppercase hover:bg-foreground/90 transition-colors">
        Отправить ссылку
      </button>
    <% end %>

    <p class="mt-12 text-xs text-muted-foreground/60 leading-relaxed">
      Без аккаунта на сайте? Кабинет создаётся автоматически после первой
      заявки или оценки на нашем сайте. Если у вас был контакт с агентством,
      но вход не работает — напишите нам в <%= mail_to (AgencyInfo::EMAIL rescue 'info@victory62.org'), 'поддержку', class: 'underline hover:text-foreground' %>.
    </p>
  </div>
</section>
