<%# Тарифы для собственников %>
<div class="container mx-auto px-4 py-12 max-w-5xl">
  <div class="text-center mb-12">
    <h1 class="text-4xl font-bold text-gray-900 mb-4">Тарифы на размещение</h1>
    <p class="text-xl text-gray-600">Выберите подходящий план для продажи или аренды вашей недвижимости</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    <%# Базовый %>
    <div class="bg-white rounded-2xl shadow-md border border-gray-200 p-8 flex flex-col">
      <div class="mb-6">
        <h2 class="text-2xl font-bold text-gray-900">Базовый</h2>
        <p class="text-gray-500 mt-1">Для быстрого старта</p>
      </div>
      <div class="mb-6">
        <span class="text-4xl font-bold text-gray-900">Бесплатно</span>
      </div>
      <ul class="space-y-3 mb-8 flex-1">
        <li class="flex items-center gap-2 text-gray-700">
          <span class="text-green-500">✓</span> 1 объявление
        </li>
        <li class="flex items-center gap-2 text-gray-700">
          <span class="text-green-500">✓</span> До 5 фотографий
        </li>
        <li class="flex items-center gap-2 text-gray-700">
          <span class="text-green-500">✓</span> Размещение на 30 дней
        </li>
        <li class="flex items-center gap-2 text-gray-500">
          <span class="text-gray-300">✗</span> Выделение в поиске
        </li>
        <li class="flex items-center gap-2 text-gray-500">
          <span class="text-gray-300">✗</span> Продвижение объявления
        </li>
      </ul>
      <%= link_to "Разместить бесплатно", new_sell_listing_path,
          class: "block text-center bg-gray-100 text-gray-800 px-6 py-3 rounded-lg hover:bg-gray-200 font-semibold transition-colors" %>
    </div>

    <%# Стандарт — выделен %>
    <div class="bg-primary-600 rounded-2xl shadow-xl p-8 flex flex-col relative">
      <div class="absolute -top-4 left-1/2 -translate-x-1/2">
        <span class="bg-yellow-400 text-yellow-900 text-xs font-bold px-4 py-1 rounded-full uppercase tracking-wide">
          Популярный
        </span>
      </div>
      <div class="mb-6">
        <h2 class="text-2xl font-bold text-white">Стандарт</h2>
        <p class="text-primary-200 mt-1">Оптимальный выбор</p>
      </div>
      <div class="mb-6">
        <span class="text-4xl font-bold text-white">990 ₽</span>
        <span class="text-primary-200 text-sm"> / месяц</span>
      </div>
      <ul class="space-y-3 mb-8 flex-1">
        <li class="flex items-center gap-2 text-white">
          <span class="text-yellow-300">✓</span> До 5 объявлений
        </li>
        <li class="flex items-center gap-2 text-white">
          <span class="text-yellow-300">✓</span> До 20 фотографий
        </li>
        <li class="flex items-center gap-2 text-white">
          <span class="text-yellow-300">✓</span> Размещение на 90 дней
        </li>
        <li class="flex items-center gap-2 text-white">
          <span class="text-yellow-300">✓</span> Выделение в поиске
        </li>
        <li class="flex items-center gap-2 text-primary-200">
          <span class="text-primary-300">✗</span> Приоритетное продвижение
        </li>
      </ul>
      <%= link_to "Выбрать тариф", new_sell_listing_path,
          class: "block text-center bg-white text-primary-600 px-6 py-3 rounded-lg hover:bg-primary-50 font-semibold transition-colors" %>
    </div>

    <%# Премиум %>
    <div class="bg-white rounded-2xl shadow-md border border-gray-200 p-8 flex flex-col">
      <div class="mb-6">
        <h2 class="text-2xl font-bold text-gray-900">Премиум</h2>
        <p class="text-gray-500 mt-1">Максимальный охват</p>
      </div>
      <div class="mb-6">
        <span class="text-4xl font-bold text-gray-900">2 490 ₽</span>
        <span class="text-gray-500 text-sm"> / месяц</span>
      </div>
      <ul class="space-y-3 mb-8 flex-1">
        <li class="flex items-center gap-2 text-gray-700">
          <span class="text-green-500">✓</span> Неограниченные объявления
        </li>
        <li class="flex items-center gap-2 text-gray-700">
          <span class="text-green-500">✓</span> До 50 фотографий
        </li>
        <li class="flex items-center gap-2 text-gray-700">
          <span class="text-green-500">✓</span> Размещение на 180 дней
        </li>
        <li class="flex items-center gap-2 text-gray-700">
          <span class="text-green-500">✓</span> Выделение в поиске
        </li>
        <li class="flex items-center gap-2 text-gray-700">
          <span class="text-green-500">✓</span> Приоритетное продвижение
        </li>
      </ul>
      <%= link_to "Выбрать Премиум", new_sell_listing_path,
          class: "block text-center bg-gray-900 text-white px-6 py-3 rounded-lg hover:bg-gray-800 font-semibold transition-colors" %>
    </div>
  </div>

  <div class="mt-12 bg-blue-50 rounded-xl p-6 text-center">
    <p class="text-gray-700">Нужна помощь с выбором тарифа?
      <%= link_to "Свяжитесь с нами", contacts_path, class: "text-primary-600 font-semibold hover:underline" %>
    </p>
  </div>
</div>
