<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <% if ENV['YANDEX_MAPS_API_KEY'].present? %>
      <meta name="yandex-maps-api-key" content="<%= ENV['YANDEX_MAPS_API_KEY'] %>">
    <% end %>

    <title><%= content_for?(:title) ? yield(:title) : 'АН «Виктори» — агентство недвижимости в Рязани' %></title>
    <%= yield :meta_tags %>

    <%# Canonical + hreflang — strip query string to avoid duplicate-content signal %>
    <link rel="canonical" href="<%= canonical_url %>">
    <link rel="alternate" hreflang="ru" href="<%= canonical_url %>">
    <link rel="alternate" hreflang="x-default" href="<%= canonical_url %>">

    <%# Open Graph + Twitter Card — drives preview cards in VK, Telegram,
        WhatsApp, Дзен, Facebook and Yandex's social-share carousel. Each
        page can override og_image/og_type via content_for; defaults below
        keep the agency branded if a page forgot to set them. %>
    <%# Standard meta description — Yandex/Google read this BEFORE falling
        back to og:description for the SERP snippet. Sourced from the same
        :seo_description content_for that drives OG/Twitter, so the three
        stay in sync per page. The fallback below mirrors the OG default
        so listings without per-page content_for still get a sensible
        catalog-wide blurb (catalog index, error pages, etc). %>
    <meta name="description" content="<%= content_for?(:seo_description) ? yield(:seo_description) : 'АН «Виктори» — покупка, продажа и аренда квартир, домов, коммерческой недвижимости в Рязани. Онлайн-оценка, ипотека, юридическое сопровождение.' %>">
    <meta property="og:type" content="<%= content_for?(:og_type) ? yield(:og_type) : 'website' %>">
    <meta property="og:locale" content="ru_RU">
    <meta property="og:site_name" content="АН «Виктори»">
    <meta property="og:title" content="<%= content_for?(:title) ? yield(:title) : 'АН «Виктори» — агентство недвижимости в Рязани' %>">
    <meta property="og:description" content="<%= content_for?(:seo_description) ? yield(:seo_description) : 'АН «Виктори» — покупка, продажа и аренда квартир, домов, коммерческой недвижимости в Рязани. Онлайн-оценка, ипотека, юридическое сопровождение.' %>">
    <meta property="og:url" content="<%= canonical_url %>">
    <meta property="og:image" content="<%= og_image_url %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= content_for?(:title) ? yield(:title) : 'АН «Виктори» — агентство недвижимости в Рязани' %>">
    <meta name="twitter:description" content="<%= content_for?(:seo_description) ? yield(:seo_description) : 'Покупка, продажа и аренда недвижимости в Рязани.' %>">
    <meta name="twitter:image" content="<%= og_image_url %>">

    <%# Geo meta — Яндекс особенно ценит для регионального ранжирования %>
    <meta name="geo.region" content="RU-RYA">
    <meta name="geo.placename" content="<%= AgencyInfo::ADDRESS_CITY %>">
    <meta name="geo.position" content="<%= AgencyInfo::GEO_LAT %>;<%= AgencyInfo::GEO_LNG %>">
    <meta name="ICBM" content="<%= AgencyInfo::GEO_LAT %>, <%= AgencyInfo::GEO_LNG %>">

    <%# Search engine ownership verification (set ENV after creating accounts) %>
    <% if ENV['YANDEX_VERIFICATION'].present? %>
      <meta name="yandex-verification" content="<%= ENV['YANDEX_VERIFICATION'] %>">
    <% end %>
    <% if ENV['GOOGLE_SITE_VERIFICATION'].present? %>
      <meta name="google-site-verification" content="<%= ENV['GOOGLE_SITE_VERIFICATION'] %>">
    <% end %>

    <%# Google Fonts loaded async via the print-onload pattern so the
        external stylesheet does not block first paint (was synchronous,
        cost 200-400ms LCP on mobile 4G). Inter@200 dropped — not used
        by any Tailwind class in the project, saves ~8KB transfer. %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <%# crossorigin on preload must match the real fetch (Google Fonts CSS
        is anonymous-CORS); without it the browser treats preload and the
        actual stylesheet load as different requests, the font transfers
        twice, and the preload becomes a wasted round-trip. %>
    <link rel="preload" as="style" crossorigin href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"></noscript>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

    <%# JS infrastructure: importmap-rails is disabled (no config/importmap.rb).
        Per-page interactive code is inlined as <script type="module"> with
        direct CDN imports — see _chat_widget.html.erb, _location_section.html.erb,
        properties/show PhotoSwipe block. %>

    <%# Site-wide JSON-LD: RealEstateAgent (Schema.org) %>
    <%= render 'shared/jsonld_agent' %>
    <%= yield :head %>
    <%# Analytics — Yandex.Metrika + GA4. Fires only in production with ENV present. %>
    <%= render 'shared/analytics' %>
  </head>
  <body class="bg-background text-foreground min-h-screen antialiased">
    <%= render "shared/site_header" %>

    <main class="pt-20">
      <% if flash.any? %>
        <div class="px-6 lg:px-12 pt-6">
          <% flash.each do |type, message| %>
            <div class="border px-4 py-3 text-sm tracking-wider <%= type.to_s == 'alert' ? 'border-destructive text-destructive' : 'border-border text-muted-foreground' %>">
              <%= message %>
            </div>
          <% end %>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <%= render "shared/site_footer" %>
    <%= render "shared/chat_widget" %>
    <%# Pages can append scripts that must run after DOMContentLoaded
        (DaData autocomplete partial, etc.) %>
    <%= yield :body_end %>
  </body>
</html>
