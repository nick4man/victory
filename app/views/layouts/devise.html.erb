<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <title><%= yield(:title).presence || 'АН "Виктори"' %></title>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <script type="module">
      import hotwireTurbo from 'https://cdn.skypack.dev/@hotwired/turbo';
    </script>
    <script src="https://cdn.jsdelivr.net/npm/@hotwired/stimulus@3.2.2/dist/stimulus.umd.js"></script>
    <%= yield :head %>
  </head>

  <body class="min-h-screen bg-gradient-to-br from-primary-50 via-white to-accent-50">
    <%# Flash messages %>
    <% if flash.any? %>
      <div class="fixed top-4 right-4 z-50 space-y-2 max-w-sm">
        <% flash.each do |type, message| %>
          <div class="<%= flash_class(type) %> border px-4 py-3 rounded-lg shadow-lg flex items-start gap-3" role="alert">
            <span class="text-lg leading-none"><%= flash_icon(type) %></span>
            <span class="text-sm flex-1"><%= message %></span>
          </div>
        <% end %>
      </div>
    <% end %>

    <main>
      <%= yield %>
    </main>
  </body>
</html>
