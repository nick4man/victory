<%# Landing page content. <head>/<header>/<footer> are inherited from application.html.erb. %>
<% content_for :title, 'АН «Виктори» — агентство недвижимости в Рязани' %>

<!-- ============================================
     HERO SLIDER — random in-advertising properties (cached 10 min)
     ============================================ -->
<%# Landing's hero is full-screen — pull it above the layout's pt-20 by negating top padding %>
<div class="-mt-20">
<section class="relative h-screen w-full overflow-hidden" id="hero-slider">
    <%
      slides = Rails.cache.fetch('landing/hero_slides_v2', expires_in: 10.minutes) do
        # PG forbids RANDOM() ORDER BY with DISTINCT, so shuffle in Ruby (small N).
        candidates = Property.in_advertising
                             .joins(:images_attachments)
                             .distinct
                             .limit(50)
                             .to_a
        candidates.shuffle.first(6).map do |p|
          first_image = p.images.first
          next nil unless first_image
          {
            subtitle: (p.property_type&.name || I18n.t("deal_types.#{p.deal_type}", default: p.deal_type)).to_s.upcase,
            title:    (p.district.presence || p.address.to_s.split(',').first.to_s.strip).upcase.presence || p.title.upcase,
            area:     (p.area.present? ? "#{ActionController::Base.helpers.number_with_delimiter(p.area.to_f.round(1).to_s.sub(/\.0$/, ''))} м²" : nil),
            price:    (p.price.to_i.positive? ? "#{ActionController::Base.helpers.number_with_delimiter(p.price.to_i)} ₽" : nil),
            image:    Rails.application.routes.url_helpers.rails_blob_path(first_image, only_path: true),
            url:      Rails.application.routes.url_helpers.property_path(p)
          }
        end.compact
      rescue StandardError => e
        Rails.logger.warn("[hero_slides] #{e.class}: #{e.message}")
        []
      end

      # Fallback: рязанские плейсхолдеры если каталог пуст (только на старте/в dev).
      if slides.empty?
        slides = [
          { subtitle: "Квартира",  title: "ЦЕНТР РЯЗАНИ",   area: "от 65 м²", price: "от 5 200 000 ₽", image: "https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?w=1920&q=80", url: properties_path },
          { subtitle: "Дом",       title: "КАНИЩЕВО",        area: "от 120 м²", price: "от 9 800 000 ₽", image: "https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?w=1920&q=80", url: properties_path },
          { subtitle: "Участок",   title: "РЯЗАНСКАЯ ОБЛ.",  area: "от 10 соток", price: "от 1 500 000 ₽", image: "https://images.unsplash.com/photo-1512917774080-9991f1c4c750?w=1920&q=80", url: properties_path }
        ]
      end
    %>

    <% slides.each_with_index do |s, i| %>
      <a class="hero-slide absolute inset-0 block"
         href="<%= s[:url] || properties_path %>"
         aria-label="Открыть объект: <%= s[:title] %>"
         style="opacity: <%= i == 0 ? 1 : 0 %>; pointer-events: <%= i == 0 ? 'auto' : 'none' %>; transition: opacity 1500ms ease-in-out;"
         data-index="<%= i %>">
        <span class="absolute inset-0 bg-background/60 z-10"></span>
        <img src="<%= s[:image] %>" alt="<%= s[:title] %>" loading="eager"
             class="w-full h-full object-cover grayscale">
      </a>
    <% end %>

    <div class="relative z-20 h-full flex flex-col justify-between px-6 lg:px-12 pt-32 pb-12 pointer-events-none">
      <div class="flex-1 flex flex-col justify-center max-w-4xl pointer-events-auto"
           data-hero="text-block"
           style="transition: opacity 600ms ease-in-out;">
        <p class="text-sm tracking-[0.4em] text-muted-foreground mb-4 uppercase" data-hero="subtitle"><%= slides.first[:subtitle] %></p>
        <h1 class="text-5xl md:text-7xl lg:text-8xl font-light tracking-wider text-foreground mb-8" data-hero="title"><%= slides.first[:title] %></h1>
        <div class="flex flex-col sm:flex-row gap-6 sm:gap-12 text-sm tracking-wider text-muted-foreground mb-12">
          <span data-hero="area"><%= slides.first[:area] %></span>
          <span data-hero="price"><%= slides.first[:price] %></span>
        </div>
        <a data-hero="cta" href="<%= slides.first[:url] || properties_path %>"
           class="group flex items-center gap-4 text-sm tracking-[0.3em] text-foreground hover:text-muted-foreground transition-colors w-fit pointer-events-auto">
          ПОДРОБНЕЕ
          <svg class="w-5 h-5 group-hover:translate-x-2 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <div class="flex items-end justify-between">
        <div class="flex items-center gap-4 pointer-events-auto" id="hero-indicators">
          <% slides.each_with_index do |_, i| %>
            <button type="button" class="hero-indicator h-px transition-all duration-500 <%= i == 0 ? 'w-12 bg-foreground' : 'w-6 bg-muted-foreground' %>" data-index="<%= i %>" aria-label="Слайд <%= i + 1 %>"></button>
          <% end %>
        </div>

        <div class="hidden lg:flex flex-col items-center gap-2 text-muted-foreground">
          <span class="text-xs tracking-widest rotate-90 origin-center translate-x-4">SCROLL</span>
          <svg class="w-4 h-4 animate-bounce" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
        </div>

        <div class="text-sm tracking-wider text-muted-foreground">
          <span class="text-foreground text-lg" data-hero="counter">01</span>
          <span class="mx-2">/</span>
          <span><%= sprintf("%02d", slides.size) %></span>
        </div>
      </div>
    </div>

    <script>
      (function () {
        var slides = <%= raw slides.to_json %>;
        var idx = 0;
        var transitioning = false;

        // Preload images so the first crossfade is instant.
        slides.forEach(function (s) { var i = new Image(); i.src = s.image; });

        var slideEls   = document.querySelectorAll('.hero-slide');
        var indicators = document.querySelectorAll('.hero-indicator');
        var textBlock  = document.querySelector('[data-hero="text-block"]');
        var subtitleEl = document.querySelector('[data-hero="subtitle"]');
        var titleEl    = document.querySelector('[data-hero="title"]');
        var areaEl     = document.querySelector('[data-hero="area"]');
        var priceEl    = document.querySelector('[data-hero="price"]');
        var counterEl  = document.querySelector('[data-hero="counter"]');
        var ctaEl      = document.querySelector('[data-hero="cta"]');

        function setIndicators(active) {
          indicators.forEach(function (el, i) {
            if (i === active) {
              el.classList.add('w-12', 'bg-foreground');
              el.classList.remove('w-6', 'bg-muted-foreground');
            } else {
              el.classList.remove('w-12', 'bg-foreground');
              el.classList.add('w-6', 'bg-muted-foreground');
            }
          });
        }

        function show(n) {
          if (transitioning) return;
          var next = ((n % slides.length) + slides.length) % slides.length;
          if (next === idx) return;
          transitioning = true;

          // 1. Crossfade backgrounds (1500ms via inline transition).
          //    pointer-events follows opacity so only the visible slide receives clicks.
          slideEls.forEach(function (el, i) {
            el.style.opacity = i === next ? '1' : '0';
            el.style.pointerEvents = i === next ? 'auto' : 'none';
          });

          // 2. Fade text out, swap content, fade text in.
          if (textBlock) textBlock.style.opacity = '0';
          setTimeout(function () {
            var s = slides[next];
            if (subtitleEl) subtitleEl.textContent = s.subtitle;
            if (titleEl)    titleEl.textContent    = s.title;
            if (areaEl)     areaEl.textContent     = s.area || '';
            if (priceEl)    priceEl.textContent    = s.price || '';
            if (counterEl)  counterEl.textContent  = String(next + 1).padStart(2, '0');
            if (ctaEl && s.url) ctaEl.setAttribute('href', s.url);
            if (textBlock) textBlock.style.opacity = '1';
          }, 600);

          setIndicators(next);
          idx = next;
          setTimeout(function () { transitioning = false; }, 1500);
        }

        indicators.forEach(function (btn) {
          btn.addEventListener('click', function () { show(parseInt(btn.dataset.index, 10)); });
        });

        setInterval(function () { show(idx + 1); }, 6000);
      })();
    </script>
  </section>

  <!-- ============================================
       FEATURED PROPERTIES
       ============================================ -->
  <%
    featured = Rails.cache.fetch('landing/featured_v2', expires_in: 10.minutes) do
      Property.in_advertising.joins(:images_attachments).distinct.order(updated_at: :desc).limit(4).to_a
    rescue StandardError
      []
    end
  %>
  <% if featured.any? %>
    <section id="projects" class="py-24 lg:py-32 px-6 lg:px-12 bg-background">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8 mb-16">
        <div>
          <p class="text-sm tracking-[0.4em] text-muted-foreground mb-4">КАТАЛОГ</p>
          <h2 class="text-4xl lg:text-5xl font-light tracking-wider text-foreground">ИЗБРАННЫЕ ОБЪЕКТЫ</h2>
        </div>
        <div class="flex flex-wrap gap-2">
          <%= link_to "Все",         properties_path,                                     class: "px-5 py-2 text-sm tracking-wider border bg-foreground text-background border-foreground" %>
          <%= link_to "Купить",      properties_path(q: { deal_type_eq: 'sale' }),        class: "px-5 py-2 text-sm tracking-wider border bg-transparent text-muted-foreground border-border hover:border-foreground hover:text-foreground transition-colors" %>
          <%= link_to "Снять",       properties_path(q: { deal_type_eq: 'rent' }),        class: "px-5 py-2 text-sm tracking-wider border bg-transparent text-muted-foreground border-border hover:border-foreground hover:text-foreground transition-colors" %>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <% featured.each do |p| %>
          <%= link_to p, class: "group relative bg-card border border-border overflow-hidden block" do %>
            <div class="relative aspect-[4/3] overflow-hidden">
              <%= property_picture(p.images.attached? ? p.images.first : nil,
                    alt: property_image_alt(p),
                    sizes: '(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw',
                    html_class: 'w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700',
                    fallback: :card) %>
              <div class="absolute inset-0 bg-background/20 group-hover:bg-transparent transition-colors duration-500"></div>
              <div class="absolute bottom-4 right-4 w-12 h-12 flex items-center justify-center bg-foreground text-background opacity-0 translate-y-4 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10M7 17 17 7"/></svg>
              </div>
            </div>
            <div class="p-6">
              <h3 class="text-lg tracking-wider text-foreground mb-1 group-hover:text-muted-foreground transition-colors uppercase"><%= p.title %></h3>
              <p class="text-sm text-muted-foreground tracking-wide mb-4"><%= p.address.presence || 'Москва, ЦАО' %></p>
              <div class="grid grid-cols-2 gap-4 py-4 border-t border-border">
                <div>
                  <p class="text-xs tracking-widest text-muted-foreground mb-1">ПЛОЩАДЬ</p>
                  <p class="text-sm tracking-wider text-foreground"><%= p.area.present? ? "#{p.area} м²" : "—" %></p>
                </div>
                <div>
                  <p class="text-xs tracking-widest text-muted-foreground mb-1">ЭТАЖ</p>
                  <p class="text-sm tracking-wider text-foreground"><%= p.floor.present? ? "#{p.floor}/#{p.total_floors}" : "—" %></p>
                </div>
              </div>
              <div class="pt-4 border-t border-border">
                <p class="text-xl tracking-wider text-foreground mb-1"><%= p.price_formatted %></p>
                <% if p.price_per_sqm.present? %>
                  <p class="text-xs tracking-wider text-muted-foreground"><%= number_with_delimiter(p.price_per_sqm.to_i) %> ₽/м²</p>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>

      <div class="flex justify-center mt-16">
        <%= link_to properties_path, class: "group flex items-center gap-4 px-8 py-4 text-sm tracking-[0.3em] border border-border text-foreground hover:bg-foreground hover:text-background transition-colors" do %>
          ВСЕ ОБЪЕКТЫ
          <svg class="w-5 h-5 group-hover:translate-x-2 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        <% end %>
      </div>
    </section>
  <% end %>

  <!-- ============================================
       STATS
       ============================================ -->
  <%# Live metrics — see AgencyMetricsService. processed_requests pulls counts
      across realty + orders from Topnlab API (cached 1h); volume / completed_deals
      / happy_clients come from local DB. %>
  <section class="py-24 px-6 lg:px-12 bg-card border-y border-border">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8 max-w-7xl mx-auto">
      <div class="text-center">
        <p class="text-4xl lg:text-6xl font-light tracking-wider text-foreground mb-2"><%= @metrics[:years_on_market] %></p>
        <p class="text-sm tracking-widest text-muted-foreground uppercase">лет на рынке</p>
      </div>
      <div class="text-center">
        <p class="text-4xl lg:text-6xl font-light tracking-wider text-foreground mb-2"><%= number_with_delimiter(@metrics[:processed_requests].to_i.positive? ? @metrics[:processed_requests] : @metrics[:completed_deals]) %></p>
        <p class="text-sm tracking-widest text-muted-foreground uppercase">обработано клиентских запросов</p>
      </div>
      <div class="text-center">
        <p class="text-4xl lg:text-6xl font-light tracking-wider text-foreground mb-2"><%= number_with_delimiter(@metrics[:happy_clients]) %></p>
        <p class="text-sm tracking-widest text-muted-foreground uppercase">довольных клиентов</p>
      </div>
      <div class="text-center">
        <p class="text-4xl lg:text-6xl font-light tracking-wider text-foreground mb-2"><%= @metrics[:total_volume_human].presence || '—' %></p>
        <p class="text-sm tracking-widest text-muted-foreground uppercase">объём продаж</p>
      </div>
    </div>
  </section>

  <%= render 'shared/reviews_strip', reviews: @reviews, aggregate: @metrics %>

  <!-- ============================================
       VALUES
       ============================================ -->
  <section class="py-24 lg:py-32 px-6 lg:px-12 bg-background">
    <div class="max-w-5xl mx-auto">
      <p class="text-sm tracking-[0.4em] text-muted-foreground mb-4">О КОМПАНИИ</p>
      <h2 class="text-4xl lg:text-5xl font-light tracking-wider text-foreground mb-8 leading-tight">
        АГЕНТСТВО НЕДВИЖИМОСТИ<br>В РЯЗАНИ
      </h2>
      <p class="text-base lg:text-lg text-muted-foreground leading-relaxed mb-16 max-w-3xl">
        Помогаем покупать, продавать и арендовать квартиры, дома, участки и коммерческую недвижимость в Рязани и области. Полный цикл сделки: подбор, оценка, ипотека, юридическое сопровождение.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16">
        <% [
          ["ПОДБОР",       "Знаем рязанский рынок изнутри: каждый район, новостройку, инфраструктуру. Подберём вариант под ваш бюджет и задачу.", properties_path, "Открыть каталог"],
          ["ОЦЕНКА",       "Онлайн-оценка по своей базе сделок плюс выезд эксперта. Реальная цена под продажу. Инвест-аудит — для покупки.", valuations_path, "Оценить онлайн"],
          ["ИПОТЕКА",      "Подключаем банки-партнёры, считаем платёж, помогаем со справками. Льготная и стандартная — найдём подходящую программу.", services_mortgage_calculator_path, "Рассчитать"],
          ["СОПРОВОЖДЕНИЕ","Юридическая проверка объекта, договор, регистрация в Росреестре. Сделка под ключ — от показа до получения ключей.", services_legal_services_path, "Подробнее"]
        ].each do |title, body, link_url, link_label| %>
          <div>
            <h3 class="text-lg tracking-widest text-foreground mb-4"><%= title %></h3>
            <p class="text-sm text-muted-foreground leading-relaxed mb-3"><%= body %></p>
            <%= link_to link_label + " →", link_url, class: "inline-block text-xs tracking-[0.3em] text-foreground border-b border-foreground/30 hover:border-foreground transition-colors" %>
          </div>
        <% end %>
      </div>
    </div>
  </section>

</div><%# end -mt-20 wrapper %>
