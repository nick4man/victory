<% content_for :title, "Заявки покупателей" %>

<%= render 'shared/dashboard_nav' %>

<section class="px-6 lg:px-12 pt-12 pb-20 bg-background min-h-screen">
  <div class="max-w-7xl mx-auto">

    <div class="mb-12 pb-8 border-b border-border">
      <p class="text-sm tracking-[0.4em] text-muted-foreground mb-3">КАБИНЕТ СОТРУДНИКА</p>
      <h1 class="text-4xl lg:text-5xl font-light tracking-wide text-foreground">Заявки покупателей и арендаторов</h1>
      <p class="text-sm text-muted-foreground mt-3">Активных заявок: <%= @total %> · синхронизация каждые 3 часа</p>
    </div>

    <%= form_with url: dashboard_orders_path, method: :get, local: true, class: "grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 mb-8" do |f| %>
      <%= f.select :deal_type,
            options_for_select([['Все сделки', '']] + [['Продажа', 'sale'], ['Аренда', 'rent']], params[:deal_type]),
            {}, class: "h-11 px-3 bg-background border border-border text-foreground focus:border-foreground focus:outline-none transition-colors text-sm" %>
      <%= f.select :realty_type,
            options_for_select([['Все типы', '']] + @realty_types.map { |t| [t, t] }, params[:realty_type]),
            {}, class: "h-11 px-3 bg-background border border-border text-foreground focus:border-foreground focus:outline-none transition-colors text-sm" %>
      <%= f.text_field :city, value: params[:city], placeholder: "Город",
            class: "h-11 px-3 bg-background border border-border text-foreground placeholder:text-muted-foreground focus:border-foreground focus:outline-none transition-colors text-sm" %>
      <%= f.text_field :district, value: params[:district], placeholder: "Район",
            class: "h-11 px-3 bg-background border border-border text-foreground placeholder:text-muted-foreground focus:border-foreground focus:outline-none transition-colors text-sm" %>
      <%= f.number_field :price_min, value: params[:price_min], placeholder: "Цена от, ₽",
            class: "h-11 px-3 bg-background border border-border text-foreground placeholder:text-muted-foreground focus:border-foreground focus:outline-none transition-colors text-sm" %>
      <%= f.number_field :price_max, value: params[:price_max], placeholder: "Цена до, ₽",
            class: "h-11 px-3 bg-background border border-border text-foreground placeholder:text-muted-foreground focus:border-foreground focus:outline-none transition-colors text-sm" %>

      <label class="flex items-center gap-2 col-span-2 text-sm text-muted-foreground">
        <%= f.check_box :my_only, { checked: params[:my_only] == '1' }, '1', '0' %>
        Только мои заявки
      </label>
      <label class="flex items-center gap-2 col-span-2 text-sm text-muted-foreground">
        <%= f.check_box :show_archived, { checked: params[:show_archived] == '1' }, '1', '0' %>
        Показывать архивные
      </label>
      <%= f.submit "Применить", class: "col-span-2 h-11 bg-foreground text-background hover:bg-foreground/90 transition-colors text-sm" %>
    <% end %>

    <div class="grid grid-cols-1 gap-px bg-border">
      <% @orders.each do |order| %>
        <%= link_to dashboard_order_path(order), class: "block bg-background p-6 hover:bg-foreground/[0.02] transition-colors" do %>
          <div class="flex items-start justify-between gap-6">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-2 flex-wrap">
                <span class="text-[10px] uppercase tracking-wider px-2 py-0.5 border border-border text-muted-foreground"><%= I18n.t("deal_types.#{order.deal_type}", default: order.deal_type) %></span>
                <% if order.realty_type %>
                  <span class="text-[10px] uppercase tracking-wider px-2 py-0.5 border border-border text-muted-foreground"><%= order.realty_type %></span>
                <% end %>
                <% if order.deal_state %>
                  <span class="text-[10px] uppercase tracking-wider px-2 py-0.5 border border-border <%= order.deal_state == 'lead' ? 'text-foreground border-foreground' : 'text-muted-foreground' %>"><%= order.deal_state %></span>
                <% end %>
                <% if order.user %>
                  <span class="text-[10px] uppercase tracking-wider text-muted-foreground">→ <%= order.user.short_name %></span>
                <% end %>
              </div>
              <p class="text-base font-medium text-foreground"><%= order.title %></p>
              <% if order.description.present? %>
                <p class="text-sm text-muted-foreground mt-2 line-clamp-2"><%= order.description %></p>
              <% end %>
            </div>
            <div class="text-right flex-shrink-0">
              <% if order.price_range %>
                <p class="text-base font-medium text-foreground"><%= order.price_range %></p>
              <% end %>
              <% if order.area_min || order.area_max %>
                <p class="text-xs text-muted-foreground mt-1"><%= [order.area_min, order.area_max].compact.uniq.join('–') %> м²</p>
              <% end %>
              <p class="text-[10px] text-muted-foreground mt-2">CRM ##<%= order.crm_id %></p>
            </div>
          </div>
        <% end %>
      <% end %>

      <% if @orders.empty? %>
        <div class="bg-background p-12 text-center text-muted-foreground">
          Заявок не найдено по выбранным фильтрам.
        </div>
      <% end %>
    </div>

    <% if @orders.respond_to?(:total_pages) && @orders.total_pages > 1 %>
      <div class="mt-8 flex items-center justify-center">
        <%= paginate @orders %>
      </div>
    <% end %>
  </div>
</section>
