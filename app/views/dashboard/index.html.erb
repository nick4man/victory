<%
  is_staff = current_user.role_agent? || current_user.role_admin?
  is_admin = current_user.role_admin?

  # CRM activity counters (graceful when tables don't exist yet)
  staff_count    = (Department.active.count rescue 0)
  agents_count   = (User.crm_active.where(role: User.roles[:agent]).count rescue 0)
  orders_count   = (BuyerOrder.active.count rescue 0)
  services_count = (ServiceType.public_visible.count rescue 0)
  reports_count  = (CrmReport.count rescue 0)
%>

<% content_for :title, "Личный кабинет — АН Виктори" %>

<%= render 'shared/dashboard_nav' %>

<section class="px-6 lg:px-12 pt-12 pb-20 bg-background min-h-screen">
  <div class="max-w-7xl mx-auto">

    <div class="mb-12 pb-8 border-b border-border">
      <p class="text-sm tracking-[0.4em] text-muted-foreground mb-3">ЛИЧНЫЙ КАБИНЕТ</p>
      <h1 class="text-4xl lg:text-5xl font-light tracking-wide text-foreground mb-2">
        <%= current_user.short_name.presence || current_user.email %>
      </h1>
      <p class="text-sm text-muted-foreground"><%= current_user.email %><% if current_user.crm_role_name %> · <%= current_user.crm_role_name %><% end %></p>
    </div>

    <% if is_staff %>
      <!-- ========== STAFF SECTION ========== -->
      <div class="mb-16">
        <h2 class="text-xs tracking-[0.4em] text-muted-foreground mb-6">РАБОТА С CRM</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-border">

          <%= link_to dashboard_staff_index_path, class: "group bg-card p-8 hover:bg-accent transition-colors block" do %>
            <div class="flex items-start justify-between mb-4">
              <h3 class="text-lg tracking-widest text-foreground group-hover:translate-x-2 transition-transform">СОТРУДНИКИ</h3>
              <p class="text-3xl font-light text-foreground"><%= agents_count %></p>
            </div>
            <p class="text-sm text-muted-foreground leading-relaxed">Справочник коллег: ФИО, отделы, контакты. Из Topnlab CRM.</p>
            <p class="text-xs text-muted-foreground mt-4"><%= pluralize(staff_count, 'отдел', plural: 'отделов') %></p>
          <% end %>

          <%= link_to dashboard_orders_path, class: "group bg-card p-8 hover:bg-accent transition-colors block" do %>
            <div class="flex items-start justify-between mb-4">
              <h3 class="text-lg tracking-widest text-foreground group-hover:translate-x-2 transition-transform">ПОКУПАТЕЛИ</h3>
              <p class="text-3xl font-light text-foreground"><%= orders_count %></p>
            </div>
            <p class="text-sm text-muted-foreground leading-relaxed">Заявки покупателей и арендаторов из CRM. Поиск подходящих объектов из нашей базы.</p>
            <p class="text-xs text-muted-foreground mt-4">Sync каждые 3 часа</p>
          <% end %>

          <%= link_to services_page_path, class: "group bg-card p-8 hover:bg-accent transition-colors block" do %>
            <div class="flex items-start justify-between mb-4">
              <h3 class="text-lg tracking-widest text-foreground group-hover:translate-x-2 transition-transform">УСЛУГИ</h3>
              <p class="text-3xl font-light text-foreground"><%= services_count %></p>
            </div>
            <p class="text-sm text-muted-foreground leading-relaxed">Каталог услуг агентства: ипотека, юристы, оценка, осмотр объекта.</p>
            <p class="text-xs text-muted-foreground mt-4">Публичная страница</p>
          <% end %>

          <% my_count = (Property.unscoped.assigned_to(current_user).where(deleted_at: nil).count rescue 0) %>
          <%= link_to dashboard_properties_path, class: "group bg-card p-8 hover:bg-accent transition-colors block" do %>
            <div class="flex items-start justify-between mb-4">
              <h3 class="text-lg tracking-widest text-foreground group-hover:translate-x-2 transition-transform">МОИ ОБЪЕКТЫ</h3>
              <p class="text-3xl font-light text-foreground"><%= my_count %></p>
            </div>
            <p class="text-sm text-muted-foreground leading-relaxed">Все объекты, закреплённые за вами в CRM (любая стадия — реклама, работа, аванс, архив).</p>
            <p class="text-xs text-muted-foreground mt-4">Sync каждые 30 мин</p>
          <% end %>

          <%= link_to properties_path, target: '_blank', class: "group bg-card p-8 hover:bg-accent transition-colors block" do %>
            <div class="flex items-start justify-between mb-4">
              <h3 class="text-lg tracking-widest text-foreground group-hover:translate-x-2 transition-transform">КАТАЛОГ</h3>
              <p class="text-3xl font-light text-foreground"><%= (Property.on_site.count rescue 0) %></p>
            </div>
            <p class="text-sm text-muted-foreground leading-relaxed">Публичный каталог: только объекты в стадии «реклама» (deal_state=ad).</p>
            <p class="text-xs text-muted-foreground mt-4">Открывается в новой вкладке</p>
          <% end %>

          <%= link_to new_property_valuation_path, class: "group bg-card p-8 hover:bg-accent transition-colors block" do %>
            <h3 class="text-lg tracking-widest text-foreground mb-4 group-hover:translate-x-2 transition-transform">ОНЛАЙН-ОЦЕНКА</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">Оценка по медиане аналогов: 4 шага, динамические поля для каждого типа объекта.</p>
          <% end %>

          <% if is_admin %>
            <% all_props = (Property.unscoped.where(deleted_at: nil).count rescue 0) %>
            <% unassigned = (Property.unscoped.unassigned.where(deleted_at: nil).count rescue 0) %>
            <%= link_to dashboard_admin_properties_path, class: "group bg-card p-8 hover:bg-accent transition-colors block border-l-2 border-foreground" do %>
              <div class="flex items-start justify-between mb-4">
                <h3 class="text-lg tracking-widest text-foreground group-hover:translate-x-2 transition-transform">ВСЕ ОБЪЕКТЫ</h3>
                <p class="text-3xl font-light text-foreground"><%= all_props %></p>
              </div>
              <p class="text-sm text-muted-foreground leading-relaxed">Полный каталог компании. Назначение агентов, фильтры по стадии, поиск.</p>
              <p class="text-xs text-muted-foreground mt-4">Без агента: <%= unassigned %> · Только администратор</p>
            <% end %>

            <%= link_to dashboard_admin_reports_path, class: "group bg-card p-8 hover:bg-accent transition-colors block border-l-2 border-foreground" do %>
              <div class="flex items-start justify-between mb-4">
                <h3 class="text-lg tracking-widest text-foreground group-hover:translate-x-2 transition-transform">ОТЧЁТЫ CRM</h3>
                <p class="text-3xl font-light text-foreground"><%= reports_count %></p>
              </div>
              <p class="text-sm text-muted-foreground leading-relaxed">Регистрация custom-отчётов в Topnlab. PDF генерируется на нашем сервере по запросу из CRM.</p>
              <p class="text-xs text-muted-foreground mt-4">Только администратор</p>
            <% end %>
          <% end %>

        </div>
      </div>
    <% end %>

    <!-- ========== PERSONAL SECTION ========== -->
    <div class="mb-12">
      <h2 class="text-xs tracking-[0.4em] text-muted-foreground mb-6">ЛИЧНЫЕ ДАННЫЕ</h2>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-border mb-8">
        <% [
          ["ИЗБРАННОЕ",  current_user.favorites_count, dashboard_favorites_path],
          ["МОИ ЗАЯВКИ", current_user.inquiries_count, dashboard_inquiries_path],
          ["ПОИСКИ",     (current_user.saved_searches.count rescue 0), dashboard_saved_searches_path],
          ["СООБЩЕНИЯ",  (current_user.unread_messages_count rescue 0), dashboard_messages_path]
        ].each do |label, value, url| %>
          <%= link_to url, class: "bg-card p-6 hover:bg-accent transition-colors block" do %>
            <p class="text-3xl lg:text-4xl font-light tracking-wider text-foreground mb-2"><%= value %></p>
            <p class="text-xs tracking-[0.3em] text-muted-foreground"><%= label %></p>
          <% end %>
        <% end %>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-px bg-border">
        <%= link_to dashboard_profile_path, class: "group bg-card p-6 hover:bg-accent transition-colors block" do %>
          <h3 class="text-sm tracking-widest text-foreground mb-2 group-hover:translate-x-2 transition-transform">ПРОФИЛЬ</h3>
          <p class="text-xs text-muted-foreground">Личные данные и безопасность</p>
        <% end %>
        <%= link_to dashboard_settings_path, class: "group bg-card p-6 hover:bg-accent transition-colors block" do %>
          <h3 class="text-sm tracking-widest text-foreground mb-2 group-hover:translate-x-2 transition-transform">НАСТРОЙКИ</h3>
          <p class="text-xs text-muted-foreground">Уведомления и оформление</p>
        <% end %>
        <%= link_to dashboard_history_index_path, class: "group bg-card p-6 hover:bg-accent transition-colors block" do %>
          <h3 class="text-sm tracking-widest text-foreground mb-2 group-hover:translate-x-2 transition-transform">ИСТОРИЯ</h3>
          <p class="text-xs text-muted-foreground">Просмотренные объекты</p>
        <% end %>
        <%= link_to dashboard_comparisons_path, class: "group bg-card p-6 hover:bg-accent transition-colors block" do %>
          <h3 class="text-sm tracking-widest text-foreground mb-2 group-hover:translate-x-2 transition-transform">СРАВНЕНИЕ</h3>
          <p class="text-xs text-muted-foreground">Сопоставление объектов</p>
        <% end %>
      </div>
    </div>
  </div>
</section>
