<%# Dashboard - Настройки %>
<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold text-gray-900 mb-6">Настройки</h1>

  <div class="bg-white rounded-lg shadow p-6">
    <%= form_with model: current_user, url: dashboard_settings_path, method: :patch, class: "space-y-4" do |f| %>
      <div>
        <%= f.label :email, "Email", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.email_field :email, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
      </div>

      <div class="flex gap-3">
        <%= f.submit "Сохранить", class: "bg-primary-600 text-white px-6 py-2 rounded-lg hover:bg-primary-700 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
