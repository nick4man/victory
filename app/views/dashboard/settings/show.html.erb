<% content_for :title, 'Настройки — АН Виктори' %>

<%= render 'shared/dashboard_nav' %>

<%
  labels = {
    'email_new_inquiry'     => 'Email при новой заявке (для агентов — поступление; для клиентов — подтверждение)',
    'email_inquiry_status'  => 'Email при изменении статуса заявки',
    'email_valuation_ready' => 'Email когда онлайн-оценка готова',
    'email_property_match'  => 'Email при появлении объектов под сохранённый поиск',
    'email_newsletter'      => 'Дайджест новостей рынка раз в неделю'
  }
%>

<section class="px-6 lg:px-12 pt-12 pb-20 bg-background min-h-screen">
  <div class="max-w-3xl mx-auto">

    <div class="mb-10 pb-6 border-b border-border">
      <p class="text-[11px] tracking-[0.4em] text-muted-foreground mb-2">ЛИЧНЫЙ КАБИНЕТ</p>
      <h1 class="text-3xl lg:text-4xl font-light tracking-tight text-foreground">Настройки</h1>
    </div>

    <% if flash[:notice] %>
      <div class="mb-6 px-4 py-3 border border-emerald-500/40 bg-emerald-500/5 text-sm text-emerald-300">
        <%= flash[:notice] %>
      </div>
    <% end %>

    <%# ============================================================
        SECTION 1 — NOTIFICATIONS
        ============================================================ %>
    <section class="bg-card border border-border p-7 lg:p-10 mb-6">
      <h2 class="text-xl font-light tracking-wide text-foreground mb-1">Уведомления</h2>
      <p class="text-xs text-muted-foreground mb-6">
        Когда отправлять вам email. Telegram-уведомления настраиваются на стороне @victory62_bot.
      </p>

      <%= form_with url: dashboard_settings_path, method: :patch, local: true, class: 'space-y-4' do %>
        <% Dashboard::SettingsController::DEFAULT_NOTIFICATION_KEYS.each do |key| %>
          <label class="flex items-start gap-3 cursor-pointer">
            <%= hidden_field_tag "notifications[#{key}]", '0' %>
            <%= check_box_tag "notifications[#{key}]", '1', @notifications[key],
                  class: 'mt-0.5 w-4 h-4 bg-background border-border' %>
            <span class="text-sm text-foreground leading-snug"><%= labels[key] %></span>
          </label>
        <% end %>

        <div class="pt-3">
          <%= submit_tag 'СОХРАНИТЬ',
                class: 'px-6 py-3 text-xs tracking-[0.3em] bg-foreground text-background hover:bg-foreground/85 transition-colors cursor-pointer' %>
        </div>
      <% end %>
    </section>

    <%# ============================================================
        SECTION 2 — SECURITY
        ============================================================ %>
    <section class="bg-card border border-border p-7 lg:p-10 mb-6">
      <h2 class="text-xl font-light tracking-wide text-foreground mb-1">Безопасность</h2>
      <p class="text-xs text-muted-foreground mb-6">
        Сменить email, пароль или выйти со всех устройств.
      </p>

      <div class="space-y-3 text-sm">
        <div class="flex items-baseline justify-between flex-wrap gap-3 py-3 border-b border-border">
          <div>
            <p class="text-foreground">Email</p>
            <p class="text-xs text-muted-foreground mt-1"><%= current_user.email %></p>
          </div>
          <%= link_to 'Изменить →', edit_user_registration_path,
                class: 'text-xs tracking-[0.25em] text-muted-foreground hover:text-foreground' %>
        </div>

        <div class="flex items-baseline justify-between flex-wrap gap-3 py-3 border-b border-border">
          <div>
            <p class="text-foreground">Пароль</p>
            <p class="text-xs text-muted-foreground mt-1">
              Последняя смена через Devise — обычно после &laquo;забыл пароль&raquo;
            </p>
          </div>
          <%= link_to 'Сменить →', edit_user_registration_path,
                class: 'text-xs tracking-[0.25em] text-muted-foreground hover:text-foreground' %>
        </div>

        <% if current_user.last_sign_in_at %>
          <div class="py-3 border-b border-border">
            <p class="text-foreground">Активность</p>
            <p class="text-xs text-muted-foreground mt-1">
              Последний вход: <%= l(current_user.last_sign_in_at, format: :long) rescue current_user.last_sign_in_at.strftime('%d.%m.%Y %H:%M') %>
              <% if current_user.last_sign_in_ip.present? %>
                <span class="opacity-50 mx-1">·</span>IP <%= current_user.last_sign_in_ip %>
              <% end %>
            </p>
          </div>
        <% end %>

        <div class="flex items-baseline justify-between flex-wrap gap-3 pt-3">
          <div>
            <p class="text-foreground">Выйти из аккаунта</p>
            <p class="text-xs text-muted-foreground mt-1">
              Завершить текущую сессию (cookie сбрасывается)
            </p>
          </div>
          <%= button_to 'ВЫЙТИ', destroy_user_session_path, method: :delete,
                class: 'px-4 py-2 text-xs tracking-[0.25em] border border-border text-muted-foreground hover:text-foreground hover:border-foreground/60 transition-colors bg-transparent cursor-pointer',
                form: { class: 'inline' } %>
        </div>
      </div>
    </section>

    <%# ============================================================
        SECTION 3 — DELETE ACCOUNT
        ============================================================ %>
    <section class="bg-card border border-red-500/20 p-7 lg:p-10">
      <h2 class="text-xl font-light tracking-wide text-red-300 mb-1">Удалить аккаунт</h2>
      <p class="text-xs text-muted-foreground mb-5">
        Аккаунт деактивируется (soft-delete): вход блокируется, профиль скрывается. Данные остаются 30 дней — за это время можем восстановить по запросу.
        Избранное, заявки и оценки сохраняются.
      </p>
      <%= button_to 'УДАЛИТЬ АККАУНТ', account_dashboard_settings_path, method: :delete,
            data: { turbo_confirm: 'Точно удалить аккаунт? Восстановить можно в течение 30 дней.' },
            class: 'px-5 py-2.5 text-xs tracking-[0.25em] border border-red-500/40 text-red-300 hover:bg-red-500/10 transition-colors cursor-pointer',
            form: { class: 'inline' } %>
    </section>
  </div>
</section>
