<%# Dashboard - Редактирование профиля %>
<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold text-gray-900 mb-6">Редактировать профиль</h1>

  <%= form_with model: current_user, url: dashboard_profile_path, method: :patch, class: "bg-white rounded-lg shadow p-6 space-y-4" do |f| %>
    <% if current_user.errors.any? %>
      <div class="bg-red-50 border border-red-200 rounded p-4">
        <ul class="text-red-700 text-sm list-disc pl-4">
          <% current_user.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= f.label :first_name, "Имя", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :first_name, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
      </div>
      <div>
        <%= f.label :last_name, "Фамилия", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :last_name, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
      </div>
      <div>
        <%= f.label :phone, "Телефон", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.telephone_field :phone, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
      </div>
    </div>

    <div>
      <%= f.label :bio, "О себе", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :bio, rows: 4, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
    </div>

    <div class="flex gap-3">
      <%= f.submit "Сохранить", class: "bg-primary-600 text-white px-6 py-2 rounded-lg hover:bg-primary-700 cursor-pointer" %>
      <%= link_to "Отмена", dashboard_profile_path, class: "px-6 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50" %>
    </div>
  <% end %>
</div>
