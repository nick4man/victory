<%# Dashboard - Заявка %>
<div class="container mx-auto px-4 py-8">
  <div class="flex items-center gap-4 mb-6">
    <%= link_to "← Назад", dashboard_inquiries_path, class: "text-primary-600 hover:underline" %>
    <h1 class="text-3xl font-bold text-gray-900">Заявка #<%= @inquiry.id %></h1>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <dl class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <dt class="text-sm text-gray-500">Статус</dt>
        <dd class="font-medium text-gray-900"><%= @inquiry.status %></dd>
      </div>
      <div>
        <dt class="text-sm text-gray-500">Дата создания</dt>
        <dd class="font-medium text-gray-900"><%= l @inquiry.created_at, format: :long %></dd>
      </div>
      <% if @inquiry.property %>
        <div class="col-span-2">
          <dt class="text-sm text-gray-500">Объект</dt>
          <dd class="font-medium text-gray-900">
            <%= link_to @inquiry.property.title, property_path(@inquiry.property), class: "text-primary-600 hover:underline" %>
          </dd>
        </div>
      <% end %>
      <% if @inquiry.message.present? %>
        <div class="col-span-2">
          <dt class="text-sm text-gray-500">Сообщение</dt>
          <dd class="text-gray-900 mt-1"><%= @inquiry.message %></dd>
        </div>
      <% end %>
    </dl>
  </div>
</div>
