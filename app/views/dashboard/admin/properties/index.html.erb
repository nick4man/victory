<% content_for :title, "Все объекты компании" %>

<%= render 'shared/dashboard_nav' %>

<section class="px-6 lg:px-12 pt-12 pb-20 bg-background min-h-screen">
  <div class="max-w-7xl mx-auto">

    <div class="mb-8 pb-6 border-b border-border">
      <p class="text-sm tracking-[0.4em] text-muted-foreground mb-3">АДМИНИСТРИРОВАНИЕ</p>
      <h1 class="text-4xl lg:text-5xl font-light tracking-wide text-foreground">Все объекты компании</h1>
      <p class="text-sm text-muted-foreground mt-3">Назначение агентов · фильтры по стадии · поиск</p>
    </div>

    <%= form_with url: dashboard_admin_properties_path, method: :get, local: true, class: "grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 mb-6" do |f| %>
      <%= f.text_field :q, value: params[:q], placeholder: "ID, заголовок, адрес",
            class: "h-11 px-3 bg-background border border-border text-foreground placeholder:text-muted-foreground focus:border-foreground focus:outline-none transition-colors text-sm" %>
      <%= f.select :deal_state,
            options_for_select([['Все стадии', '']] + %w[ad active lead prepayment deferred deal denied archive].map { |s| [s, s] }, params[:deal_state]),
            {}, class: "h-11 px-3 bg-background border border-border text-foreground focus:border-foreground focus:outline-none transition-colors text-sm" %>
      <%= f.select :deal_type,
            options_for_select([['Все', '']] + [['Продажа', 'sale'], ['Аренда', 'rent']], params[:deal_type]),
            {}, class: "h-11 px-3 bg-background border border-border text-foreground focus:border-foreground focus:outline-none transition-colors text-sm" %>
      <%= f.select :user_id,
            options_for_select([['Любой агент', '']] + @agents.map { |u| [u.short_name.presence || u.email, u.id] }, params[:user_id]),
            {}, class: "h-11 px-3 bg-background border border-border text-foreground focus:border-foreground focus:outline-none transition-colors text-sm" %>
      <label class="flex items-center gap-2 text-sm text-muted-foreground">
        <%= f.check_box :unassigned, { checked: params[:unassigned] == '1' }, '1', '0' %>
        Без агента
      </label>
      <%= f.submit "Применить", class: "h-11 bg-foreground text-background hover:bg-foreground/90 transition-colors text-sm" %>
    <% end %>

    <p class="text-xs text-muted-foreground mb-6">
      Найдено: <strong class="text-foreground"><%= @scope.except(:offset, :limit, :order).count %></strong> ·
      По стадиям: <%= @counts.map { |s, n| "#{s}=#{n}" }.join(' · ').presence || '—' %>
    </p>

    <% if @properties.any? %>
      <div class="space-y-px bg-border">
        <% @properties.each do |p| %>
          <div class="bg-background p-5 grid grid-cols-12 gap-4 items-center">
            <div class="col-span-12 lg:col-span-7">
              <div class="flex items-center gap-2 mb-1 flex-wrap">
                <span class="text-[10px] uppercase tracking-wider px-2 py-0.5 border border-border text-muted-foreground"><%= p.deal_type %></span>
                <% if p.deal_state %>
                  <span class="text-[10px] uppercase tracking-wider px-2 py-0.5 border <%= p.deal_state == 'ad' ? 'border-foreground text-foreground' : 'border-border text-muted-foreground' %>"><%= p.deal_state %></span>
                <% end %>
                <% if p.property_type %>
                  <span class="text-[10px] uppercase tracking-wider text-muted-foreground"><%= p.property_type.name %></span>
                <% end %>
                <span class="text-[10px] tracking-wider text-muted-foreground">CRM ##<%= p.external_id %></span>
              </div>
              <%= link_to property_path(p), target: '_blank', class: "block hover:text-muted-foreground transition-colors" do %>
                <p class="text-sm font-medium text-foreground truncate"><%= p.title %></p>
              <% end %>
              <p class="text-xs text-muted-foreground truncate"><%= p.address %></p>
            </div>

            <div class="col-span-6 lg:col-span-2 text-right lg:text-left">
              <p class="text-sm font-medium text-foreground"><%= number_with_delimiter(p.price.to_i, delimiter: ' ') %> ₽</p>
              <p class="text-xs text-muted-foreground"><%= p.area %> м²<% if p.rooms %> · <%= p.rooms %>к<% end %></p>
            </div>

            <%= form_with url: assign_dashboard_admin_property_path(p), method: :patch, local: true, class: "col-span-6 lg:col-span-3 flex items-center gap-2" do |f| %>
              <%= f.select :user_id,
                    options_for_select([['— без агента —', '']] + @agents.map { |u| [u.short_name.presence || u.email, u.id] }, p.user_id),
                    {},
                    class: "flex-1 h-9 px-2 bg-background border border-border text-foreground text-xs focus:border-foreground focus:outline-none transition-colors",
                    onchange: "this.form.submit()" %>
              <noscript>
                <%= f.submit "→", class: "h-9 px-3 bg-foreground text-background text-xs" %>
              </noscript>
            <% end %>
          </div>
        <% end %>
      </div>

      <% if @properties.respond_to?(:total_pages) && @properties.total_pages > 1 %>
        <div class="mt-8 flex items-center justify-center">
          <%= paginate @properties %>
        </div>
      <% end %>
    <% else %>
      <div class="bg-card border border-border p-12 text-center text-muted-foreground">
        Объектов не найдено по выбранным фильтрам.
      </div>
    <% end %>
  </div>
</section>
