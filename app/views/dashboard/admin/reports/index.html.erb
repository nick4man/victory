<% content_for :title, "Отчёты CRM" %>

<%= render 'shared/dashboard_nav' %>

<section class="px-6 lg:px-12 pt-12 pb-20 bg-background min-h-screen">
  <div class="max-w-5xl mx-auto">
    <div class="flex items-end justify-between gap-6 mb-12 pb-8 border-b border-border">
      <div>
        <p class="text-sm tracking-[0.4em] text-muted-foreground mb-3">АДМИНИСТРИРОВАНИЕ</p>
        <h1 class="text-4xl lg:text-5xl font-light tracking-wide text-foreground">Отчёты CRM</h1>
        <p class="text-sm text-muted-foreground mt-3">Регистрация кастомных отчётов в Topnlab. Каждый отчёт получает endpoint для генерации PDF на нашей стороне.</p>
      </div>
      <%= link_to 'Новый отчёт', new_dashboard_admin_report_path,
            class: "py-2 px-6 bg-foreground text-background hover:bg-foreground/90 transition-colors text-sm" %>
    </div>

    <% if @reports.any? %>
      <div class="space-y-px bg-border">
        <% @reports.each do |r| %>
          <div class="bg-background p-5 flex items-center justify-between gap-6">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-3 mb-1 flex-wrap">
                <p class="text-base font-medium text-foreground"><%= r.title %></p>
                <% if r.crm_id %>
                  <span class="text-[10px] uppercase tracking-wider px-2 py-0.5 border border-foreground text-foreground">CRM ##<%= r.crm_id %></span>
                <% else %>
                  <span class="text-[10px] uppercase tracking-wider px-2 py-0.5 border border-destructive text-destructive">не зарегистрирован</span>
                <% end %>
                <% unless r.active %>
                  <span class="text-[10px] uppercase tracking-wider px-2 py-0.5 border border-muted-foreground text-muted-foreground">отключён</span>
                <% end %>
              </div>
              <p class="text-xs text-muted-foreground"><%= r.page_title %> · slug: <code class="text-foreground"><%= r.slug %></code></p>
              <p class="text-xs text-muted-foreground mt-1">Шаблон: <code class="text-foreground"><%= r.template_class %></code></p>
            </div>
            <div class="flex items-center gap-3">
              <%= link_to 'Изменить', edit_dashboard_admin_report_path(r), class: 'text-xs uppercase tracking-wider text-muted-foreground hover:text-foreground transition-colors' %>
              <%= button_to 'Удалить', dashboard_admin_report_path(r), method: :delete, data: { turbo_confirm: 'Удалить отчёт из CRM и локальной БД?' },
                    class: 'text-xs uppercase tracking-wider text-destructive hover:text-foreground transition-colors bg-transparent border-0 p-0' %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="bg-card border border-border p-12 text-center text-muted-foreground">
        Отчётов пока нет. <%= link_to 'Создайте первый', new_dashboard_admin_report_path, class: 'text-foreground underline' %>.
      </div>
    <% end %>
  </div>
</section>
