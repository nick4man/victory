<% content_for :title, 'Уведомления — АН Виктори' %>

<%= render 'shared/dashboard_nav' %>

<%
  icon_for = ->(kind) {
    case kind
    when 'inquiry'        then '📩'
    when 'valuation'      then '📊'
    when 'property_match' then '🏠'
    when 'message'        then '💬'
    else '🔔'
    end
  }
%>

<section class="px-6 lg:px-12 pt-12 pb-20 bg-background min-h-screen">
  <div class="max-w-3xl mx-auto">

    <div class="flex items-baseline justify-between mb-10 pb-6 border-b border-border flex-wrap gap-3">
      <div>
        <p class="text-[11px] tracking-[0.4em] text-muted-foreground mb-2">ЛИЧНЫЙ КАБИНЕТ</p>
        <h1 class="text-3xl lg:text-4xl font-light tracking-tight text-foreground">
          Уведомления
          <% if @unread_count.positive? %>
            <span class="inline-flex items-center px-2 py-0.5 text-xs tracking-wider bg-foreground text-background ml-2 align-middle"><%= @unread_count %></span>
          <% end %>
        </h1>
      </div>
      <div class="flex items-center gap-3">
        <% if @unread_count.positive? %>
          <%= button_to 'Прочитать всё', mark_all_read_dashboard_notifications_path, method: :post,
                class: 'text-xs tracking-[0.25em] text-muted-foreground hover:text-foreground border-b border-border/40 pb-1 bg-transparent border-0 cursor-pointer',
                form: { class: 'inline' } %>
        <% end %>
        <% if @notifications.any? %>
          <%= button_to 'Очистить', clear_all_dashboard_notifications_path, method: :delete,
                data: { turbo_confirm: 'Очистить все уведомления? Их можно будет посмотреть в архиве администратором.' },
                class: 'text-xs tracking-[0.25em] text-muted-foreground hover:text-red-300 border-b border-border/40 pb-1 bg-transparent border-0 cursor-pointer',
                form: { class: 'inline' } %>
        <% end %>
      </div>
    </div>

    <% if flash[:notice] %>
      <div class="mb-6 px-4 py-3 border border-emerald-500/40 bg-emerald-500/5 text-sm text-emerald-300">
        <%= flash[:notice] %>
      </div>
    <% end %>

    <% if @notifications.any? %>
      <div class="bg-card border border-border divide-y divide-border">
        <% @notifications.each do |n| %>
          <% unread = !n.read? %>
          <div class="px-5 py-4 flex items-start gap-4 <%= 'bg-foreground/[0.02]' if unread %>">
            <span class="text-xl flex-shrink-0 mt-0.5"><%= icon_for.call(n.kind) %></span>
            <div class="flex-1 min-w-0">
              <div class="flex items-baseline justify-between gap-3 flex-wrap">
                <p class="text-sm <%= unread ? 'text-foreground font-medium' : 'text-muted-foreground' %>">
                  <%= n.title %>
                </p>
                <span class="text-[10px] tracking-wider text-muted-foreground/70 flex-shrink-0">
                  <%= time_ago_in_words(n.created_at) %> назад
                </span>
              </div>
              <% if n.body.present? %>
                <p class="text-xs text-muted-foreground mt-1 leading-snug"><%= n.body.truncate(200) %></p>
              <% end %>
              <div class="mt-2 flex items-center gap-3 text-[10px] tracking-[0.2em]">
                <% if n.url.present? %>
                  <%= link_to 'ОТКРЫТЬ →', n.url,
                        class: 'text-foreground hover:text-muted-foreground' %>
                <% end %>
                <% if unread %>
                  <%= button_to 'ПРОЧИТАНО', mark_read_dashboard_notification_path(n), method: :post,
                        class: 'text-muted-foreground hover:text-foreground bg-transparent border-0 cursor-pointer',
                        form: { class: 'inline' } %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <% if @notifications.respond_to?(:total_pages) && @notifications.total_pages > 1 %>
        <div class="mt-6"><%= paginate @notifications rescue nil %></div>
      <% end %>
    <% else %>
      <div class="bg-card border border-border p-12 text-center">
        <p class="text-sm text-muted-foreground mb-2">Уведомлений пока нет.</p>
        <p class="text-xs text-muted-foreground/70">
          Они появятся когда мы ответим на заявку или будет готова онлайн-оценка.
        </p>
      </div>
    <% end %>
  </div>
</section>
