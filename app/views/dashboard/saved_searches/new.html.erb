<% content_for :title, 'Новый поиск — АН Виктори' %>

<%= render 'shared/dashboard_nav' %>

<section class="px-6 lg:px-12 pt-12 pb-20 bg-background min-h-screen">
  <div class="max-w-2xl mx-auto">
    <%= link_to '← К списку поисков', dashboard_saved_searches_path,
          class: 'inline-block text-xs tracking-[0.3em] text-muted-foreground hover:text-foreground mb-8' %>
    <div class="mb-10 pb-6 border-b border-border">
      <p class="text-[11px] tracking-[0.4em] text-muted-foreground mb-2">ЛИЧНЫЙ КАБИНЕТ</p>
      <h1 class="text-3xl lg:text-4xl font-light tracking-tight text-foreground">Новый сохранённый поиск</h1>
      <p class="text-sm text-muted-foreground mt-3">
        Задайте параметры — будем присылать email, когда появятся новые объекты под фильтр.
      </p>
    </div>
    <%= render 'form' %>
  </div>
</section>
