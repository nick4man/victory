<%
  url    = @search.persisted? ? dashboard_saved_search_path(@search) : dashboard_saved_searches_path
  method = @search.persisted? ? :patch : :post
  filters = (@search.filters || {}).symbolize_keys
%>

<%= form_with model: @search, url: url, method: method, scope: :saved_search,
      html: { class: 'space-y-6 bg-card border border-border p-7 lg:p-10' } do |f| %>

  <% if @search.errors.any? %>
    <div class="px-4 py-3 border border-red-500/40 bg-red-500/5 text-sm text-red-300">
      <ul class="list-disc pl-5">
        <% @search.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, 'Название', class: 'block text-[10px] tracking-[0.3em] text-muted-foreground mb-2' %>
    <%= f.text_field :name, required: true, placeholder: '1-комн. в Канищево до 5 млн',
          class: 'w-full px-4 py-2.5 bg-background border border-border text-foreground focus:border-foreground/60 focus:outline-none' %>
  </div>

  <div>
    <%= f.label :description, 'Описание (для себя)', class: 'block text-[10px] tracking-[0.3em] text-muted-foreground mb-2' %>
    <%= f.text_area :description, rows: 2,
          class: 'w-full px-4 py-2.5 bg-background border border-border text-foreground focus:border-foreground/60 focus:outline-none' %>
  </div>

  <div class="pt-2">
    <p class="text-[10px] tracking-[0.3em] text-muted-foreground mb-4">ПАРАМЕТРЫ ПОИСКА</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :deal_type, 'Тип сделки', class: 'block text-xs text-muted-foreground mb-1' %>
        <%= select_tag 'saved_search[deal_type]',
              options_for_select([['Любая', ''], ['Покупка', 'sale'], ['Аренда', 'rent'], ['Посуточно', 'daily']], filters[:deal_type]),
              class: 'w-full px-3 py-2 bg-background border border-border text-foreground' %>
      </div>
      <div>
        <%= f.label :property_type, 'Тип недвижимости', class: 'block text-xs text-muted-foreground mb-1' %>
        <%= select_tag 'saved_search[property_type]',
              options_from_collection_for_select(PropertyType.order(:name), :id, :name, filters[:property_type]),
              include_blank: 'Любой',
              class: 'w-full px-3 py-2 bg-background border border-border text-foreground' %>
      </div>
      <div>
        <%= label_tag 'saved_search_price_min', 'Цена от, ₽', class: 'block text-xs text-muted-foreground mb-1' %>
        <%= number_field_tag 'saved_search[price_min]', filters[:price_min], min: 0, step: 100_000,
              class: 'w-full px-3 py-2 bg-background border border-border text-foreground' %>
      </div>
      <div>
        <%= label_tag 'saved_search_price_max', 'Цена до, ₽', class: 'block text-xs text-muted-foreground mb-1' %>
        <%= number_field_tag 'saved_search[price_max]', filters[:price_max], min: 0, step: 100_000,
              class: 'w-full px-3 py-2 bg-background border border-border text-foreground' %>
      </div>
      <div>
        <%= label_tag 'saved_search_rooms', 'Комнат', class: 'block text-xs text-muted-foreground mb-1' %>
        <%= select_tag 'saved_search[rooms]',
              options_for_select([['Любое', ''], ['Студия / 1', '1'], ['2', '2'], ['3', '3'], ['4+', '4']], filters[:rooms]),
              class: 'w-full px-3 py-2 bg-background border border-border text-foreground' %>
      </div>
      <div>
        <%= label_tag 'saved_search_district', 'Район', class: 'block text-xs text-muted-foreground mb-1' %>
        <%= text_field_tag 'saved_search[district]', filters[:district], placeholder: 'Канищево',
              class: 'w-full px-3 py-2 bg-background border border-border text-foreground' %>
      </div>
      <div class="sm:col-span-2">
        <%= label_tag 'saved_search_city', 'Город', class: 'block text-xs text-muted-foreground mb-1' %>
        <%= text_field_tag 'saved_search[city]', filters[:city] || 'Рязань',
              class: 'w-full px-3 py-2 bg-background border border-border text-foreground' %>
      </div>
    </div>
  </div>

  <div class="pt-3 border-t border-border space-y-2">
    <label class="flex items-center gap-3 cursor-pointer">
      <%= f.check_box :notify_enabled, class: 'w-4 h-4' %>
      <span class="text-sm text-foreground">Присылать email при появлении новых объектов</span>
    </label>
    <label class="flex items-center gap-3 cursor-pointer">
      <%= f.check_box :active, class: 'w-4 h-4' %>
      <span class="text-sm text-foreground">Активен (проверять регулярно)</span>
    </label>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit (@search.persisted? ? 'СОХРАНИТЬ' : 'СОЗДАТЬ'),
          class: 'px-6 py-3 text-xs tracking-[0.3em] bg-foreground text-background hover:bg-foreground/85 transition-colors cursor-pointer' %>
    <%= link_to 'отмена', dashboard_saved_searches_path,
          class: 'text-xs tracking-[0.25em] text-muted-foreground hover:text-foreground' %>
  </div>
<% end %>
