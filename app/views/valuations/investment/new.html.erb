<% content_for :title, "Инвестиционный аудит недвижимости — АН Виктори" %>
<% content_for :seo_description, 'Бесплатный инвестиционный аудит объекта недвижимости от АН «Виктори»: индекс эффективности, сравнение с депозитом и ипотекой, симуляция Монте-Карло, вердикт «Покупать / Подождать / Нейтрально».' %>

<%= render 'shared/breadcrumb', items: [
  ['Главная', root_path],
  ['Услуги', services_page_path],
  ['Инвест-аудит', nil]
] %>

<section class="px-6 lg:px-12 pt-8 pb-20 bg-background">
  <div class="max-w-4xl mx-auto text-center mb-12">
    <p class="text-sm tracking-[0.4em] text-muted-foreground mb-4">ИНВЕСТ-АУДИТ</p>
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-light tracking-tight text-foreground mb-4 leading-tight">
      Стоит ли<br>покупать этот объект?
    </h1>
    <p class="text-base lg:text-lg text-muted-foreground">
      Полный анализ: индекс эффективности (наличные / ипотека / депозит), симуляция Монте-Карло на 1 млн прогонов, вердикт «Покупать / Подождать / Нейтрально».
      <br>Время расчёта — около 30 секунд.
    </p>
  </div>

  <% if @source_property %>
    <%# Pre-filled from /properties/<slug>. Show a subtle banner so user
        knows the fields came from the listing and can be edited (e.g. to
        run the audit against an offer price below the asking price). %>
    <div class="max-w-2xl mx-auto mb-6 bg-card border border-border p-4 text-sm">
      <p class="text-xs tracking-[0.3em] text-muted-foreground mb-2">АУДИТ ОБЪЕКТА</p>
      <p class="text-foreground"><%= @source_property.title.truncate(80) %></p>
      <p class="text-xs text-muted-foreground mt-2 leading-relaxed">
        Поля ниже заполнены автоматически из карточки. Можете править —
        например, ввести вашу цену предложения вместо asking price <%= @source_property.price_formatted %>.
      </p>
    </div>
  <% end %>

  <%# === Current macro rates panel ====================================== %>
  <%# Lets the visitor see exactly which ставки the audit will use, and
      opt-in to override (например при льготной ипотеке под 6%). When
      `@macro[:stale]` — fall back silently (engine не отвечает), audit
      работает на инжиниринговых defaults. %>
  <% if @macro && @macro[:key_rate].present? %>
    <div class="max-w-2xl mx-auto mb-6 bg-card border border-border p-5">
      <div class="flex items-center justify-between flex-wrap gap-3">
        <div class="flex items-baseline gap-6 sm:gap-10">
          <div>
            <p class="text-[10px] tracking-[0.3em] text-muted-foreground mb-1">ЦБ&nbsp;РФ</p>
            <p class="text-base text-foreground"><%= @macro[:key_rate] %>%</p>
          </div>
          <div>
            <p class="text-[10px] tracking-[0.3em] text-muted-foreground mb-1">ИПОТЕКА</p>
            <p class="text-base text-foreground"><%= @macro[:mortgage_rate] %>%</p>
          </div>
          <div>
            <p class="text-[10px] tracking-[0.3em] text-muted-foreground mb-1">ДЕПОЗИТ</p>
            <p class="text-base text-foreground"><%= @macro[:deposit_rate] %>%</p>
          </div>
        </div>
        <%
          has_init_ro = @initial_rate_overrides.present? && @initial_rate_overrides.values.any?(&:present?)
        %>
        <button type="button"
                onclick="document.getElementById('rate-overrides').classList.toggle('hidden'); this.querySelector('.btn-label').textContent = (document.getElementById('rate-overrides').classList.contains('hidden') ? 'Использовать свои →' : 'Скрыть');"
                class="text-xs tracking-[0.3em] text-muted-foreground hover:text-foreground border-b border-border pb-0.5">
          <span class="btn-label"><%= has_init_ro ? 'Скрыть' : 'Использовать свои →' %></span>
        </button>
      </div>
      <p class="text-[10px] text-muted-foreground/70 mt-3 leading-relaxed">
        Базовые ставки на <%= @macro[:effective_date].presence ? l(Date.parse(@macro[:effective_date]), format: :long) : '—' %> ·
        Источник: <%= @macro[:source] %>. Производные ипотеки и депозита вычисляются от ключевой ставки ЦБ&nbsp;РФ.
      </p>
    </div>

    <%# Override fields — hidden by default. Three optional inputs that go
        into params[:rate_overrides][...] and end up in evaluation_data.
        Auto-revealed when the user arrived from /services/mortgage with
        pre-filled overrides (B.1 cross-link). %>
    <%
      init_ro = @initial_rate_overrides || {}
      has_init = init_ro['mortgage_rate'].present? || init_ro['deposit_rate'].present? || init_ro['price_growth_annual'].present?
    %>
    <div id="rate-overrides" class="<%= 'hidden' unless has_init %> max-w-2xl mx-auto mb-6 bg-card border border-border p-5">
      <p class="text-[10px] tracking-[0.3em] text-muted-foreground mb-3">ВАШИ СТАВКИ (опционально)</p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div>
          <label class="block text-xs text-muted-foreground mb-1" for="ro-mortgage">Ипотека, %</label>
          <input type="number" step="0.1" min="0" max="50" id="ro-mortgage" form="investment-form" name="rate_overrides[mortgage_rate]"
                 placeholder="<%= @macro[:mortgage_rate] %>"
                 value="<%= init_ro['mortgage_rate'] %>"
                 class="w-full border border-border bg-background px-3 py-2 text-sm focus:outline-none focus:border-foreground">
        </div>
        <div>
          <label class="block text-xs text-muted-foreground mb-1" for="ro-deposit">Депозит, %</label>
          <input type="number" step="0.1" min="0" max="50" id="ro-deposit" form="investment-form" name="rate_overrides[deposit_rate]"
                 placeholder="<%= @macro[:deposit_rate] %>"
                 value="<%= init_ro['deposit_rate'] %>"
                 class="w-full border border-border bg-background px-3 py-2 text-sm focus:outline-none focus:border-foreground">
          <%# Опциональный выбор конкретной депозитной программы. Если
              выбрана — её ставка автоматически подставляется в поле выше
              и сохраняется в evaluation_data для отображения в результате. %>
          <% deposit_programs = Deposit::ProgramsService.all rescue [] %>
          <% if deposit_programs.any? %>
            <select id="ro-deposit-program" form="investment-form" name="rate_overrides[deposit_program_id]"
                    class="mt-1 w-full border border-border bg-background px-2 py-1 text-[11px] focus:outline-none focus:border-foreground">
              <option value="">— по ключевой ставке ЦБ —</option>
              <% deposit_programs.each do |d| %>
                <option value="<%= Deposit::ProgramsService.id_for(d) %>"
                        data-rate="<%= d[:rate_max] %>"
                        <%= 'selected' if init_ro['deposit_program_id'] == Deposit::ProgramsService.id_for(d) %>>
                  <%= d[:bank_name] %> · <%= d[:product_name] %> (<%= d[:rate_max] %>%)
                </option>
              <% end %>
            </select>
            <script type="module">
              (function () {
                const sel = document.getElementById('ro-deposit-program');
                const rateInput = document.getElementById('ro-deposit');
                if (!sel || !rateInput) return;
                sel.addEventListener('change', (e) => {
                  const opt = e.target.options[e.target.selectedIndex];
                  const rate = opt && opt.dataset ? opt.dataset.rate : '';
                  if (rate) rateInput.value = rate;
                });
              })();
            </script>
          <% end %>
        </div>
        <div>
          <label class="block text-xs text-muted-foreground mb-1" for="ro-growth">Рост цен, %/год</label>
          <input type="number" step="0.1" min="0" max="30" id="ro-growth" form="investment-form" name="rate_overrides[price_growth_annual]"
                 placeholder="7.9"
                 value="<%= init_ro['price_growth_annual'] %>"
                 class="w-full border border-border bg-background px-3 py-2 text-sm focus:outline-none focus:border-foreground">
        </div>
      </div>
      <p class="text-[10px] text-muted-foreground/70 mt-3 leading-relaxed">
        Знаете точную льготную ставку (IT-ипотека 6%, семейная 5.99%)? — введите её. Пустые поля останутся базовыми.
      </p>
    </div>
  <% end %>

  <div class="max-w-2xl mx-auto bg-card border border-border p-8 lg:p-12">
    <%= form_with model: @valuation, url: investment_audit_create_path, scope: :property_valuation, local: true, html: { id: 'investment-form' }, data: { turbo: false } do |f| %>
      <% if @source_property %>
        <%# Persist the source_property reference through form submission so
            telemetry survives the POST. (Hidden field — invisible to user.) %>
        <%= hidden_field_tag :from_property, @source_property.slug %>
      <% end %>
      <% if @valuation.errors.any? %>
        <div class="border border-destructive/30 bg-destructive/5 p-4 mb-6 text-sm text-destructive">
          <p class="font-medium mb-2">Не получилось отправить:</p>
          <ul class="list-disc pl-5">
            <% @valuation.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
          </ul>
        </div>
      <% end %>

      <%= f.hidden_field :audit_mode, value: 'investment' %>
      <%= f.hidden_field :deal_type, value: 'sale' %>

      <%# ===== STEP 1: Объект ===== %>
      <fieldset class="mb-8">
        <legend class="text-xs tracking-[0.3em] text-muted-foreground mb-4">ОБЪЕКТ</legend>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
          <div>
            <%= f.label :property_type, "Тип", class: "block text-xs text-muted-foreground mb-1" %>
            <%= f.select :property_type, [["Квартира", "apartment"], ["Дом", "house"], ["Участок", "land"], ["Коммерция", "commercial"]],
                  {}, class: "w-full border border-border bg-background px-3 py-2 text-sm focus:outline-none focus:border-foreground" %>
          </div>
          <div>
            <%= f.label :rooms, "Комнат", class: "block text-xs text-muted-foreground mb-1" %>
            <%= f.number_field :rooms, min: 0, max: 10, class: "w-full border border-border bg-background px-3 py-2 text-sm focus:outline-none focus:border-foreground" %>
          </div>
        </div>

        <div class="mb-4">
          <%= f.label :address, "Адрес", class: "block text-xs text-muted-foreground mb-1" %>
          <%# Phase 4.6: DaData server-side autocomplete proxy (см. shared/_address_autocomplete).
              Заменил статический <datalist> — теперь подсказки приходят по мере ввода
              из 30M+ адресов ФИАС/КЛАДР, не ограничены каталогом. %>
          <%= render 'shared/address_autocomplete',
                input_id:    'investment-address',
                input_name:  'property_valuation[address]',
                placeholder: 'г. Рязань, ул. Пушкина, д. 10',
                value:       @valuation.address,
                required:    true %>
          <p class="mt-1 text-[10px] text-muted-foreground/70">
            Начните вводить — появятся подсказки из ФИАС/КЛАДР по Рязани и области.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <%= f.label :total_area, "Площадь, м²", class: "block text-xs text-muted-foreground mb-1" %>
            <%= f.number_field :total_area, step: 0.1, min: 0, required: true,
                  class: "w-full border border-border bg-background px-3 py-2 text-sm focus:outline-none focus:border-foreground" %>
          </div>
          <div>
            <%= f.label :estimated_price, "Цена объекта, ₽", class: "block text-xs text-muted-foreground mb-1" %>
            <%= f.number_field :estimated_price, step: 1000, min: 0, required: true, placeholder: "5000000",
                  class: "w-full border border-border bg-background px-3 py-2 text-sm focus:outline-none focus:border-foreground" %>
          </div>
        </div>
      </fieldset>

      <%# ===== STEP 2: Дополнительно ===== %>
      <fieldset class="mb-8">
        <legend class="text-xs tracking-[0.3em] text-muted-foreground mb-4">ДОПОЛНИТЕЛЬНО (опционально)</legend>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4">
          <div>
            <%= f.label :floor, "Этаж", class: "block text-xs text-muted-foreground mb-1" %>
            <%= f.number_field :floor, min: 1, class: "w-full border border-border bg-background px-3 py-2 text-sm focus:outline-none focus:border-foreground" %>
          </div>
          <div>
            <%= f.label :total_floors, "Из", class: "block text-xs text-muted-foreground mb-1" %>
            <%= f.number_field :total_floors, min: 1, class: "w-full border border-border bg-background px-3 py-2 text-sm focus:outline-none focus:border-foreground" %>
          </div>
          <div>
            <%= f.label :building_year, "Год постройки", class: "block text-xs text-muted-foreground mb-1" %>
            <%= f.number_field :building_year, min: 1900, max: 2030, class: "w-full border border-border bg-background px-3 py-2 text-sm focus:outline-none focus:border-foreground" %>
          </div>
        </div>

        <div>
          <%= f.label :property_condition, "Состояние", class: "block text-xs text-muted-foreground mb-1" %>
          <%= f.select :property_condition,
                [["Требует ремонта", "needs_repair"], ["Среднее", "average"], ["Хорошее", "good"], ["Отличное", "excellent"], ["Дизайнерский", "designer"]],
                { include_blank: "—" },
                class: "w-full border border-border bg-background px-3 py-2 text-sm focus:outline-none focus:border-foreground" %>
        </div>
      </fieldset>

      <%# ===== STEP 3: Контакт ===== %>
      <fieldset class="mb-8">
        <legend class="text-xs tracking-[0.3em] text-muted-foreground mb-4">КОНТАКТ ДЛЯ ОТЧЁТА</legend>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <%= f.label :name, "Имя", class: "block text-xs text-muted-foreground mb-1" %>
            <%= f.text_field :name, class: "w-full border border-border bg-background px-3 py-2 text-sm focus:outline-none focus:border-foreground" %>
          </div>
          <div>
            <%= f.label :phone, "Телефон", class: "block text-xs text-muted-foreground mb-1" %>
            <%= f.telephone_field :phone, class: "w-full border border-border bg-background px-3 py-2 text-sm focus:outline-none focus:border-foreground" %>
          </div>
        </div>

        <div class="mt-4">
          <%= f.label :email, "Email (для PDF-отчёта)", class: "block text-xs text-muted-foreground mb-1" %>
          <%= f.email_field :email, class: "w-full border border-border bg-background px-3 py-2 text-sm focus:outline-none focus:border-foreground" %>
        </div>
      </fieldset>

      <div class="flex flex-col sm:flex-row gap-3">
        <%= f.submit "ЗАПУСТИТЬ АУДИТ",
              class: "flex-1 px-8 py-4 bg-foreground text-background tracking-[0.2em] text-sm hover:bg-foreground/85 transition-colors cursor-pointer" %>
        <%= link_to "Простая оценка вместо аудита", new_property_valuation_path,
              class: "px-8 py-4 border border-border text-foreground tracking-[0.2em] text-sm hover:bg-secondary transition-colors text-center" %>
      </div>

      <p class="mt-4 text-xs text-muted-foreground/70 leading-relaxed">
        Аудит — собственный аналитический инструмент АН&nbsp;Виктори: моделирование цены на основе 271+ объекта каталога,
        миллион сценариев Monte&nbsp;Carlo, актуальные ставки ЦБ&nbsp;РФ. Расчёт занимает 20–40 секунд. Результат — на этой странице, ссылка остаётся работать сутки.
      </p>
    <% end %>
  </div>
</section>
