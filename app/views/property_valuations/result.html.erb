<%
  # Result page in v0 dark theme. Pulls everything off @valuation and @evaluation_result.
  property_type_names = {
    "apartment"  => "Квартира",  "house" => "Дом",      "land"   => "Участок",
    "commercial" => "Коммерческая", "garage" => "Гараж", "room"   => "Комната"
  }
  deal_type_names = { "sale" => "Продажа", "rent" => "Аренда" }
  condition_names = {
    "designer" => "Дизайнерский ремонт", "excellent" => "Отличное", "good" => "Хорошее",
    "average" => "Среднее", "needs_repair" => "Требует ремонта"
  }
  is_land = @valuation.property_type == "land"
  area_label, area_value = is_land ? ["Площадь участка", "#{@valuation.land_area} соток"] :
                                     ["Общая площадь", "#{@valuation.total_area} м²"]
  per_unit_value = @evaluation_result[:price_per_sqm] || @evaluation_result["price_per_sqm"]
  per_unit_value ||= (@valuation.estimated_price / @valuation.total_area rescue nil) if @valuation.total_area.to_f.positive?

  comparables     = @evaluation_result[:comparables].presence || []
  market_text     = @evaluation_result[:market_analysis]
  adjustments     = @evaluation_result[:adjustments] || {}
  recommendations = @evaluation_result[:recommendations] || []
  range_pct = if @valuation.min_price.to_i > 0 && @valuation.max_price.to_i > @valuation.min_price.to_i
                ((@valuation.estimated_price.to_f - @valuation.min_price.to_f) /
                 (@valuation.max_price.to_f - @valuation.min_price.to_f)) * 100
              else
                50
              end
%>

<% content_for :title, "Результат оценки — #{number_to_currency(@valuation.estimated_price, precision: 0)}" %>

<section class="px-6 lg:px-12 pt-32 pb-20 bg-background min-h-screen">
  <div class="max-w-6xl mx-auto space-y-6">

    <!-- Success banner -->
    <div class="bg-foreground text-background p-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 border border-background/30 flex items-center justify-center flex-shrink-0">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
            <circle cx="12" cy="12" r="10"/>
            <path d="m9 12 2 2 4-4"/>
          </svg>
        </div>
        <div>
          <h1 class="text-xl font-medium">Оценка завершена · Отчёт <%= @valuation.report_label %></h1>
          <p class="text-sm text-background/70">Вот результат оценки вашей недвижимости</p>
        </div>
      </div>
      <%= link_to download_pdf_property_valuations_path(token: @valuation.token, format: :pdf),
            class: "inline-flex items-center gap-2 px-4 py-2 border border-background/30 text-background bg-transparent hover:bg-background/10 transition-colors" do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" x2="12" y1="15" y2="3"/>
        </svg>
        Скачать PDF
      <% end %>
    </div>

    <div class="grid lg:grid-cols-3 gap-6">

      <!-- Main content -->
      <div class="lg:col-span-2 space-y-6">

        <!-- Estimated value -->
        <div class="bg-card border border-border p-6">
          <h3 class="text-lg font-medium text-foreground mb-6">Оценочная стоимость</h3>

          <div class="text-center mb-8">
            <p class="text-sm text-muted-foreground mb-2">Рыночная стоимость</p>
            <p class="text-4xl md:text-5xl font-light tracking-tight text-foreground">
              <%= number_with_delimiter(@valuation.estimated_price.to_i, delimiter: " ") %>
              <span class="text-2xl">₽</span>
            </p>
            <% if per_unit_value.to_i.positive? %>
              <p class="text-muted-foreground mt-2">
                <%= number_with_delimiter(per_unit_value.to_i, delimiter: " ") %> ₽ / <%= is_land ? 'м²' : 'м²' %>
              </p>
            <% end %>
          </div>

          <!-- Range slider -->
          <div class="space-y-3">
            <div class="flex justify-between text-sm">
              <span class="text-muted-foreground">Диапазон стоимости:</span>
              <span class="text-foreground"><%= number_with_delimiter(@valuation.min_price.to_i, delimiter: " ") %> — <%= number_with_delimiter(@valuation.max_price.to_i, delimiter: " ") %> ₽</span>
            </div>
            <div class="relative">
              <div class="h-1 bg-secondary w-full"></div>
              <div class="absolute top-0 h-1 bg-foreground" style="width: <%= range_pct %>%"></div>
              <div class="absolute top-1/2 -translate-y-1/2 w-3 h-3 bg-foreground border-2 border-background"
                   style="left: <%= range_pct %>%; margin-left: -6px"></div>
            </div>
            <div class="flex justify-between text-xs text-muted-foreground">
              <span><%= number_with_delimiter(@valuation.min_price.to_i, delimiter: " ") %> ₽</span>
              <span><%= number_with_delimiter(@valuation.max_price.to_i, delimiter: " ") %> ₽</span>
            </div>
          </div>

          <!-- Accuracy -->
          <div class="mt-6 p-4 bg-secondary/50 border border-border flex items-center justify-between">
            <div class="flex items-center gap-2">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-foreground">
                <circle cx="12" cy="12" r="10"/>
                <path d="m9 12 2 2 4-4"/>
              </svg>
              <span class="text-sm text-foreground">Точность оценки:</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-lg font-medium text-foreground"><%= @valuation.confidence_percentage %>%</span>
              <span class="text-xs px-2 py-1 bg-foreground/10 text-foreground"><%= @valuation.accuracy_level %></span>
            </div>
          </div>
        </div>

        <!-- Property info -->
        <div class="bg-card border border-border p-6">
          <h3 class="text-lg font-medium text-foreground mb-6">Информация об объекте</h3>
          <div class="grid grid-cols-2 gap-x-8 gap-y-4">
            <div class="border-b border-border pb-3">
              <p class="text-xs text-muted-foreground mb-1">Тип недвижимости</p>
              <p class="font-medium text-foreground"><%= property_type_names[@valuation.property_type] || "—" %></p>
            </div>
            <div class="border-b border-border pb-3">
              <p class="text-xs text-muted-foreground mb-1">Тип сделки</p>
              <p class="font-medium text-foreground"><%= deal_type_names[@valuation.deal_type] || "—" %></p>
            </div>
            <div class="border-b border-border pb-3">
              <p class="text-xs text-muted-foreground mb-1"><%= area_label %></p>
              <p class="font-medium text-foreground"><%= area_value %></p>
            </div>
            <% if @valuation.rooms.present? %>
              <div class="border-b border-border pb-3">
                <p class="text-xs text-muted-foreground mb-1">Комнат</p>
                <p class="font-medium text-foreground"><%= @valuation.rooms %></p>
              </div>
            <% end %>
            <% if @valuation.floor.present? && @valuation.total_floors.present? %>
              <div class="border-b border-border pb-3">
                <p class="text-xs text-muted-foreground mb-1">Этаж</p>
                <p class="font-medium text-foreground"><%= @valuation.floor %> / <%= @valuation.total_floors %></p>
              </div>
            <% elsif @valuation.total_floors.present? %>
              <div class="border-b border-border pb-3">
                <p class="text-xs text-muted-foreground mb-1">Этажность</p>
                <p class="font-medium text-foreground"><%= @valuation.total_floors %></p>
              </div>
            <% end %>
            <% if @valuation.building_year.present? %>
              <div class="border-b border-border pb-3">
                <p class="text-xs text-muted-foreground mb-1">Год постройки</p>
                <p class="font-medium text-foreground"><%= @valuation.building_year %></p>
              </div>
            <% end %>
            <% if @valuation.property_condition.present? %>
              <div class="border-b border-border pb-3">
                <p class="text-xs text-muted-foreground mb-1">Состояние</p>
                <p class="font-medium text-foreground"><%= condition_names[@valuation.property_condition] || @valuation.property_condition %></p>
              </div>
            <% end %>
            <% if is_land && @valuation.land_category.present? %>
              <div class="border-b border-border pb-3">
                <p class="text-xs text-muted-foreground mb-1">Категория земли</p>
                <p class="font-medium text-foreground"><%= { 'izhs'=>'ИЖС','lph'=>'ЛПХ','snt'=>'СНТ / ДНП','agricultural'=>'Земли с/х','commercial'=>'Коммерческая' }[@valuation.land_category] || @valuation.land_category %></p>
              </div>
            <% end %>
            <% if is_land && @valuation.ownership_type.present? %>
              <div class="border-b border-border pb-3">
                <p class="text-xs text-muted-foreground mb-1">Вид права</p>
                <p class="font-medium text-foreground"><%= { 'ownership'=>'Собственность','rent'=>'Аренда','inheritable'=>'Пожизненное наследуемое' }[@valuation.ownership_type] || @valuation.ownership_type %></p>
              </div>
            <% end %>
            <div class="col-span-2 border-b border-border pb-3">
              <p class="text-xs text-muted-foreground mb-1">Адрес</p>
              <p class="font-medium text-foreground"><%= [@valuation.address, @valuation.district, @valuation.city].reject(&:blank?).join(", ") %></p>
            </div>
          </div>
        </div>

        <!-- Market analysis + adjustments -->
        <% if market_text.present? %>
          <div class="bg-card border border-border p-6">
            <h3 class="text-lg font-medium text-foreground mb-4">Анализ рынка</h3>
            <p class="text-sm text-muted-foreground leading-relaxed"><%= market_text %></p>

            <% if adjustments.any? { |_, v| v.to_f != 1.0 } %>
              <div class="mt-6 pt-6 border-t border-border">
                <h4 class="text-sm font-medium text-foreground mb-3">Применённые коэффициенты</h4>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                  <% { floor: 'Этаж', year: 'Год постройки', condition: 'Состояние', amenities: 'Удобства' }.each do |key, lbl| %>
                    <% c = (adjustments[key] || adjustments[key.to_s]).to_f %>
                    <% next if c.zero? %>
                    <div class="p-3 bg-secondary/40 border border-border">
                      <p class="text-xs text-muted-foreground"><%= lbl %></p>
                      <p class="text-sm font-medium <%= c > 1 ? 'text-foreground' : c < 1 ? 'text-destructive' : 'text-muted-foreground' %>">
                        <%= c > 1 ? '+' : '' %><%= ((c - 1) * 100).round(1) %>%
                      </p>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>

        <!-- Comparables -->
        <% if comparables.any? %>
          <div class="bg-card border border-border p-6">
            <h3 class="text-lg font-medium text-foreground mb-1">Аналоги в выбранном районе</h3>
            <p class="text-sm text-muted-foreground mb-6">Объявления, на которых основан расчёт медианной цены за м²</p>
            <div class="space-y-3">
              <% comparables.each do |c| %>
                <% url = c[:url] || c["url"]
                   title = c[:title] || c["title"]
                   price = c[:price] || c["price"]
                   pps = c[:price_per_sqm] || c["price_per_sqm"]
                   area_v = c[:area] || c["area"]
                   rooms_v = c[:rooms] || c["rooms"]
                   district_v = c[:district] || c["district"]
                   distance = c[:distance_km] || c["distance_km"]
                   source = c[:source] || c["source"]
                   wrapper = url.present? ? :a : :div %>
                <%= content_tag wrapper, ({ href: url, target: '_blank', rel: 'noopener' } if url.present?), class: "flex items-center justify-between p-4 border border-border #{'hover:border-foreground/50 hover:bg-foreground/[0.02] transition-colors' if url.present?}" do %>
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-foreground truncate"><%= title %></p>
                    <p class="text-xs text-muted-foreground mt-1">
                      <%
                        details = []
                        details << "#{area_v} м²" if area_v.present?
                        details << "#{rooms_v}-комн." if rooms_v.present?
                        details << district_v if district_v.present?
                        details << "#{distance} км" if distance.present?
                      %>
                      <%= details.join(" • ") %>
                      <% if source.to_s == 'mls' %>
                        <span class="ml-2 inline-block px-2 py-0.5 text-[10px] font-medium uppercase tracking-wider bg-foreground/10 text-foreground">MLS</span>
                      <% else %>
                        <span class="ml-2 inline-block px-2 py-0.5 text-[10px] font-medium uppercase tracking-wider border border-border text-muted-foreground">Виктори</span>
                      <% end %>
                    </p>
                  </div>
                  <div class="ml-4 text-right flex-shrink-0">
                    <p class="text-sm font-semibold text-foreground"><%= number_with_delimiter(price.to_i, delimiter: " ") %> ₽</p>
                    <p class="text-xs text-muted-foreground"><%= number_with_delimiter(pps.to_i, delimiter: " ") %> ₽/м²</p>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>

        <!-- Recommendations -->
        <% if recommendations.any? %>
          <div class="bg-card border border-border p-6">
            <h3 class="text-lg font-medium text-foreground mb-6">Рекомендации</h3>
            <div class="space-y-4">
              <% recommendations.each do |r| %>
                <div class="flex items-start gap-4 p-4 border border-border">
                  <div class="flex-shrink-0 w-2 h-2 rounded-full mt-2 <%= (r[:priority] || r['priority']) == 'high' ? 'bg-foreground' : 'bg-muted-foreground' %>"></div>
                  <div class="flex-1">
                    <p class="text-sm font-medium text-foreground"><%= r[:title] || r['title'] %></p>
                    <p class="text-sm text-muted-foreground mt-1"><%= r[:description] || r['description'] %></p>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

      </div>

      <!-- Sidebar -->
      <div class="space-y-6">

        <!-- CTA card -->
        <div class="bg-foreground text-background p-6">
          <div class="w-12 h-12 border border-background/30 flex items-center justify-center mx-auto mb-4">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
          </div>
          <h4 class="text-lg font-medium text-center mb-2">Хотите продать выгодно?</h4>
          <p class="text-sm text-background/70 text-center mb-6">Наши эксперты помогут вам получить максимальную цену</p>

          <%= form_with url: request_call_property_valuations_path(token: @valuation.token), method: :post, local: true, class: "space-y-3" do %>
            <button type="submit" class="w-full py-3 bg-background text-foreground hover:bg-background/90 transition-colors font-medium">
              Получить консультацию
            </button>
          <% end %>

          <div class="mt-6 space-y-2">
            <% ["Бесплатная консультация", "Помощь в продаже", "Юридическое сопровождение"].each do |item| %>
              <div class="flex items-center gap-2 text-sm text-background/80">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 flex-shrink-0">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                <span><%= item %></span>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Share -->
        <div class="bg-card border border-border p-6">
          <h4 class="font-medium text-foreground mb-4">Поделиться результатом</h4>
          <div class="space-y-3">
            <%= link_to download_pdf_property_valuations_path(token: @valuation.token, format: :pdf),
                  class: "flex items-center gap-2 w-full px-4 py-2 border border-border text-foreground hover:bg-secondary transition-colors" do %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" x2="12" y1="15" y2="3"/>
              </svg>
              Скачать PDF
            <% end %>
            <button type="button" data-copy-link
                    data-url="<%= request.original_url %>"
                    class="flex items-center gap-2 w-full px-4 py-2 border border-border text-foreground hover:bg-secondary transition-colors">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
              </svg>
              <span data-copy-label>Копировать ссылку</span>
            </button>
          </div>
        </div>

        <!-- Disclaimer -->
        <div class="bg-card border border-border p-4">
          <div class="flex gap-3">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-muted-foreground flex-shrink-0 mt-0.5">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" x2="12" y1="16" y2="12"/>
              <line x1="12" x2="12.01" y1="8" y2="8"/>
            </svg>
            <div>
              <p class="text-sm font-medium text-foreground mb-1">О точности оценки</p>
              <p class="text-xs text-muted-foreground leading-relaxed">
                Оценка основана на анализе рыночных данных и может отличаться от реальной стоимости.
                Для точной оценки рекомендуем консультацию с экспертом.
              </p>
            </div>
          </div>
        </div>

        <!-- New valuation -->
        <%= link_to "Новая оценка", new_property_valuation_path,
              class: "block w-full py-3 text-center border border-border text-foreground hover:bg-secondary transition-colors" %>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    document.querySelectorAll('[data-copy-link]').forEach(btn => {
      btn.addEventListener('click', () => {
        const url = btn.dataset.url || window.location.href;
        navigator.clipboard?.writeText(url);
        const label = btn.querySelector('[data-copy-label]');
        if (label) {
          const original = label.textContent;
          label.textContent = 'Скопировано!';
          setTimeout(() => { label.textContent = original; }, 2000);
        }
      });
    });
  })();
</script>
