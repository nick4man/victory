<% content_for :title, 'Считаем оценку — АН Виктори' %>
<% content_for :seo_description, 'Идёт расчёт рыночной стоимости вашей недвижимости.' %>

<%# Loader page для async PropertyValuationJob. Mirrors UI pattern из
    valuations/investment/show.html.erb pending-branch. Inline JS poll'ит
    /valuations/:token/status каждые 3 секунды, перезагружает страницу
    когда status = completed/failed → result/failed view рендерится. %>

<section class="px-6 lg:px-12 pt-32 pb-20 bg-background min-h-screen">
  <div class="max-w-3xl mx-auto text-center"
       data-valuation-token="<%= @valuation.token %>"
       data-valuation-status="<%= @valuation.status %>">
    <p class="text-sm tracking-[0.4em] text-muted-foreground mb-6">РАСЧЁТ В ПРОЦЕССЕ</p>

    <div class="inline-block animate-spin mb-6">
      <svg class="w-12 h-12 text-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="10" stroke-width="2" opacity="0.2"/>
        <path d="M12 2a10 10 0 0 1 10 10" stroke-width="2"/>
      </svg>
    </div>

    <h1 class="text-3xl lg:text-4xl font-light tracking-tight text-foreground mb-4">
      Готовим оценку
    </h1>
    <p class="text-base text-muted-foreground max-w-xl mx-auto mb-10">
      Ищем похожие объекты в нашей базе и на открытом рынке, считаем медианные цены
      по району, формируем диапазон с доверительным интервалом. Обычно занимает
      <strong class="text-foreground">10–30 секунд</strong>.
    </p>

    <p class="text-xs tracking-[0.3em] text-muted-foreground/70 uppercase" id="poll-status">
      Подключаемся…
    </p>
    <p class="mt-3 text-xs tracking-[0.3em] text-muted-foreground/50 uppercase">
      Прошло: <span id="elapsed-value">0</span>&nbsp;с
    </p>
  </div>
</section>

<%# noscript fallback — мета-refresh каждые 8 секунд для пользователей с JS off.
    Не optimal UX, но всё-таки показывает прогресс. %>
<noscript>
  <meta http-equiv="refresh" content="8">
  <section class="px-6 lg:px-12 pb-16 bg-background">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-xs tracking-wider text-muted-foreground">
        Страница автоматически обновится. Если не обновляется — нажмите F5.
      </p>
    </div>
  </section>
</noscript>

<script>
  (function () {
    var token = <%= @valuation.token.to_json.html_safe %>;
    var pollEl = document.getElementById('poll-status');
    var elapsedEl = document.getElementById('elapsed-value');
    var startedAt = Date.now();
    var INTERVAL_MS = 3000;
    var MAX_MS = 120000;

    function setText(s) { if (pollEl) pollEl.textContent = s; }
    function tick() {
      if (elapsedEl) elapsedEl.textContent = Math.round((Date.now() - startedAt) / 1000);
    }

    function poll() {
      if (Date.now() - startedAt > MAX_MS) {
        setText('Превышено время ожидания. Обновите страницу через минуту.');
        clearInterval(pollTimer);
        clearInterval(tickTimer);
        return;
      }
      fetch('/valuations/' + encodeURIComponent(token) + '/status', {
        headers: { Accept: 'application/json' },
        cache: 'no-store'
      })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (data) {
          if (!data) return;
          if (data.status === 'completed') {
            setText('Готово, открываем отчёт…');
            clearInterval(pollTimer);
            clearInterval(tickTimer);
            setTimeout(function () { window.location.reload(); }, 400);
          } else if (data.status === 'failed') {
            setText('Не удалось рассчитать. Перенаправляем…');
            clearInterval(pollTimer);
            clearInterval(tickTimer);
            setTimeout(function () { window.location.reload(); }, 1500);
          }
        })
        .catch(function (e) { console.warn('[valuation-poll] failed', e); });
    }

    setText('Считаем…');
    var tickTimer = setInterval(tick, 1000);
    var pollTimer = setInterval(poll, INTERVAL_MS);
    poll();
  })();
</script>
