<%# Title — оптимизирован под top-query «оценка стоимости дома с участком
    онлайн в рязани и рязанской области» (pos 4.5 в Я.Webmaster, май 2026).
    Добавлены ключевые: «стоимость», «дома», «Рязанская область». %>
<% content_for :title, 'Онлайн-оценка стоимости квартиры, дома и участка — Рязань и Рязанская область' %>
<% content_for :seo_description, 'Бесплатная онлайн-оценка стоимости квартиры, дома или участка в Рязани и Рязанской области от АН «Виктори». Результат за 2 минуты: рыночная цена, аналоги, диапазон. Также Москва и СПб. AI + 18 лет опыта.' %>

<%= render 'shared/breadcrumb', items: [
  ['Главная', root_path],
  ['Услуги', services_page_path],
  ['Онлайн-оценка', nil]
] %>

<section class="px-6 lg:px-12 pt-8 pb-20 bg-background">
  <div class="max-w-4xl mx-auto text-center mb-12">
    <p class="text-sm tracking-[0.4em] text-muted-foreground mb-4">ОЦЕНКА</p>
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-light tracking-tight text-foreground mb-4 leading-tight">
      Узнайте стоимость<br>вашей недвижимости
    </h1>
    <p class="text-base lg:text-lg text-muted-foreground">
      Бесплатная онлайн-оценка за 2 минуты с использованием AI
    </p>
  </div>

  <%= render "form", valuation: (@valuation || PropertyValuation.new) %>

  <!-- Features -->
  <div class="max-w-4xl mx-auto mt-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <% [
        [
          %(<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-foreground"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>).html_safe,
          "Мгновенный результат",
          "Получите оценку стоимости сразу после заполнения формы"
        ],
        [
          %(<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-foreground"><path d="M12 2a4.5 4.5 0 0 0-4.5 4.5 4.5 4.5 0 0 0-3 7.79 4.5 4.5 0 0 0 3.5 7.71 4.5 4.5 0 0 0 8 0 4.5 4.5 0 0 0 3.5-7.71 4.5 4.5 0 0 0-3-7.79A4.5 4.5 0 0 0 12 2Z"/><path d="M12 2v20"/></svg>).html_safe,
          "Точная оценка с AI",
          "Искусственный интеллект анализирует рынок и аналоги"
        ],
        [
          %(<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-foreground"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>).html_safe,
          "Абсолютно бесплатно",
          "Никаких скрытых платежей и обязательств"
        ]
      ].each do |icon, title, desc| %>
        <div class="bg-card border border-border p-6 hover:border-muted-foreground/50 transition-colors">
          <div class="w-12 h-12 bg-secondary flex items-center justify-center mb-4">
            <%= icon %>
          </div>
          <h3 class="font-medium text-foreground mb-2"><%= title %></h3>
          <p class="text-sm text-muted-foreground"><%= desc %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>
