<%#
  Favorite toggle button — heart icon. Renders для logged-in clients only.
  Locals:
    - property: Property record (required)
    - favorited: Boolean (required). True если current_cabinet_user уже favorited.

  Container has id="favorite-toggle-#{property.id}" чтобы turbo_stream
  replace мог его перерисовать после toggle. Inside — button_to с правильным
  method (POST для add, DELETE для remove) и target action.

  Stimulus 'favorite' controller (опционально для optimistic UI) — но
  turbo_stream response сделает rerender автоматически.
%>
<% favorited = local_assigns.fetch(:favorited, false) %>
<turbo-frame id="favorite-toggle-<%= property.id %>" class="inline-block">
  <% if favorited %>
    <%= button_to cabinet_destroy_favorite_path(property.id),
          method:    :delete,
          form:      { data: { turbo_frame: "favorite-toggle-#{property.id}" }, class: 'inline-block' },
          class:     'inline-flex items-center justify-center w-9 h-9 bg-foreground/10 hover:bg-foreground/20 transition-colors',
          aria:      { label: 'Убрать из избранного' },
          title:     'Убрать из избранного' do %>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="text-foreground" aria-hidden="true">
        <path d="M12 21s-7-4.35-9.5-9.5C.5 6.5 4 3 7.5 4.5 9 5.1 10.5 6.5 12 8.5c1.5-2 3-3.4 4.5-4 3.5-1.5 7 2 5 7-2.5 5.15-9.5 9.5-9.5 9.5z"/>
      </svg>
    <% end %>
  <% else %>
    <%= button_to cabinet_create_favorite_path, params: { property_id: property.id },
          method:    :post,
          form:      { data: { turbo_frame: "favorite-toggle-#{property.id}" }, class: 'inline-block' },
          class:     'inline-flex items-center justify-center w-9 h-9 border border-border hover:border-foreground transition-colors',
          aria:      { label: 'В избранное' },
          title:     'В избранное' do %>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="text-muted-foreground" aria-hidden="true">
        <path d="M12 21s-7-4.35-9.5-9.5C.5 6.5 4 3 7.5 4.5 9 5.1 10.5 6.5 12 8.5c1.5-2 3-3.4 4.5-4 3.5-1.5 7 2 5 7-2.5 5.15-9.5 9.5-9.5 9.5z"/>
      </svg>
    <% end %>
  <% end %>
</turbo-frame>
