<%
  # Renders Topnlab activity log for a card. Local: `events` (array from ActivityLogFetcher).
  events ||= []
%>

<div class="bg-card border border-border p-6">
  <div class="flex items-center justify-between mb-6">
    <h3 class="text-lg font-medium text-foreground">История изменений (CRM)</h3>
    <span class="text-xs text-muted-foreground"><%= pluralize(events.size, 'событие', plural: 'событий') %></span>
  </div>

  <% if events.any? %>
    <ol class="space-y-4">
      <% events.each do |ev| %>
        <li class="flex gap-4 items-start">
          <div class="w-2 h-2 rounded-full bg-foreground mt-2 flex-shrink-0"></div>
          <div class="flex-1 min-w-0">
            <p class="text-sm text-foreground"><%= ev[:label] %></p>
            <p class="text-xs text-muted-foreground mt-0.5">
              <%= l(ev[:at], format: :short) if ev[:at] %>
              <% if ev[:user] %>
                · <%= ev[:user].short_name %>
              <% elsif ev[:user_id] %>
                · сотрудник CRM ##<%= ev[:user_id] %>
              <% end %>
            </p>
          </div>
        </li>
      <% end %>
    </ol>
  <% else %>
    <p class="text-sm text-muted-foreground py-4 text-center">История событий пуста или недоступна.</p>
  <% end %>
</div>
