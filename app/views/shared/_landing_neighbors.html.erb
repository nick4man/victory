<%#
  Cross-link block: "Соседние районы" rendered on micro-district landings.

  Purpose — distribute PageRank across the 20-district landing pyramid so
  Yandex/Google can discover sibling landings from any single entry point.
  Sitemap + header mega-menu provide top-down discovery; this provides the
  lateral (sibling) graph that Yandex weighs separately for "связанность
  страниц" (page relatedness) ranking signal.

  Renders only when @district_slug is a known micro-slug AND has siblings.
  Preserves the current intent ('sale'/'rent') and type ('kvartira', etc.)
  so the cross-link keeps the user inside the same landing facet.
%>
<% neighbors = RyazanDistricts.neighbors_of(@district_slug) %>
<% if neighbors.any? %>
  <section class="px-6 lg:px-12 py-8 bg-background border-t border-border">
    <div class="max-w-4xl mx-auto">
      <p class="text-xs tracking-[0.3em] text-muted-foreground mb-4 uppercase">Соседние районы</p>
      <div class="flex flex-wrap gap-3">
        <% neighbors.each do |n_slug| %>
          <% n_name = RyazanDistricts::MICRO.dig(n_slug, :name) %>
          <% next unless n_name %>
          <% url = @intent == 'rent' ? rent_district_landing_path(type: @type, district: n_slug) : buy_district_landing_path(type: @type, district: n_slug) %>
          <%= link_to n_name, url,
                      class: 'px-4 py-2 text-xs tracking-wider border border-border hover:border-foreground transition-colors' %>
        <% end %>
      </div>
    </div>
  </section>
<% end %>
