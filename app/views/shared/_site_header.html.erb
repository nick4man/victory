<%
  # Active-link helper — adds a subtle underline + colour change for the
  # current page. Same logic for top nav links and dropdown items.
  active_class = ->(path) { current_page?(path) ? 'text-foreground' : 'text-muted-foreground hover:text-foreground' }

  # Cabinet URL depends on role (admin → /admin, agent → /dashboard/staff,
  # client → /dashboard). Computed once so the link is identical in desktop
  # nav and mobile drawer.
  cabinet_path = if user_signed_in?
                   if current_user.admin?
                     admin_root_path
                   elsif current_user.agent?
                     dashboard_staff_index_path
                   else
                     dashboard_root_path
                   end
                 end
%>

<header class="fixed top-0 left-0 right-0 z-50 bg-background/85 backdrop-blur-md border-b border-border"
        data-site-header>

  <div class="flex items-center justify-between px-6 lg:px-10 py-4">
    <%# === LOGO === %>
    <%= link_to root_path,
          class: "text-xl lg:text-[1.35rem] font-light tracking-[0.32em] text-foreground hover:text-foreground/85 transition-colors flex-shrink-0" do %>
      АН&nbsp;ВИКТОРИ
    <% end %>

    <%# ============================================================
        DESKTOP NAV (lg+) — 6 items with dropdowns + mega-menu
        ============================================================ %>
    <nav class="hidden lg:flex items-center gap-6 xl:gap-8" aria-label="Главная навигация">

      <%# --- 1. Каталог (mega-menu) --- %>
      <div class="relative" data-nav-menu-target="item">
        <button type="button" aria-expanded="false" aria-haspopup="true"
                data-nav-toggle
                class="flex items-center gap-1 text-sm tracking-widest <%= active_class.call(properties_path) %> py-1 transition-colors">
          Каталог
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M2 4l3 3 3-3"/>
          </svg>
        </button>
        <div data-nav-menu-target="panel"
             class="hidden absolute left-0 top-full mt-2 w-[640px] bg-background border border-border shadow-2xl"
             role="menu">
          <div class="grid grid-cols-2">
            <%# Left col — by type %>
            <div class="p-6 border-r border-border">
              <p class="text-[10px] tracking-[0.4em] text-muted-foreground mb-4">ПО ТИПУ</p>
              <ul class="space-y-2.5 text-sm">
                <li><%= link_to 'Все объекты',       properties_path,                class: 'text-foreground hover:text-muted-foreground' %></li>
                <li><%= link_to 'Купить квартиру',   '/kupit/kvartira',              class: 'text-foreground hover:text-muted-foreground' %></li>
                <li><%= link_to 'Снять квартиру',    '/snyat/kvartira',              class: 'text-foreground hover:text-muted-foreground' %></li>
                <li><%= link_to 'Купить дом',        '/kupit/dom',                   class: 'text-foreground hover:text-muted-foreground' %></li>
                <li><%= link_to 'Коммерческая',      '/kupit/commerce',              class: 'text-foreground hover:text-muted-foreground' %></li>
                <li><%= link_to 'Земельные участки', '/kupit/uchastok',              class: 'text-foreground hover:text-muted-foreground' %></li>
              </ul>
            </div>
            <%# Right col — by district %>
            <div class="p-6">
              <p class="text-[10px] tracking-[0.4em] text-muted-foreground mb-4">ПО РАЙОНАМ РЯЗАНИ</p>
              <ul class="grid grid-cols-2 gap-x-3 gap-y-1.5 text-sm">
                <% RyazanDistricts.micro_grouped_by_admin.values.flatten(1).each do |slug, meta| %>
                  <li>
                    <%= link_to meta[:name], "/kupit/kvartira/rayon/#{slug}",
                          class: 'text-muted-foreground hover:text-foreground transition-colors' %>
                  </li>
                <% end %>
              </ul>
              <p class="text-[10px] tracking-[0.3em] text-muted-foreground/70 mt-4 pt-3 border-t border-border">
                4 АДМИНИСТРАТИВНЫХ РАЙОНА
              </p>
              <ul class="flex flex-wrap gap-x-3 gap-y-1 mt-2 text-xs">
                <% RyazanDistricts::ADMIN.each do |slug, meta| %>
                  <li><%= link_to meta[:name], "/kupit/kvartira/rayon/#{slug}",
                            class: 'text-muted-foreground hover:text-foreground' %></li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <%# --- 2. Оценка --- %>
      <div class="relative" data-nav-menu-target="item">
        <button type="button" aria-expanded="false" aria-haspopup="true"
                data-nav-toggle
                class="flex items-center gap-1 text-sm tracking-widest <%= active_class.call(valuations_path) %> py-1 transition-colors">
          Оценка
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 4l3 3 3-3"/></svg>
        </button>
        <div data-nav-menu-target="panel"
             class="hidden absolute left-0 top-full mt-2 w-64 bg-background border border-border shadow-2xl p-5">
          <ul class="space-y-2.5 text-sm">
            <li><%= link_to 'Экспресс-оценка',         valuations_path,                  class: 'text-foreground hover:text-muted-foreground block' %></li>
            <li><%= link_to 'Инвестиционный аудит',    investment_audit_new_path,        class: 'text-foreground hover:text-muted-foreground block' %></li>
          </ul>
        </div>
      </div>

      <%# --- 3. Финансы — раздел из 4 страниц --- %>
      <div class="relative" data-nav-menu-target="item">
        <%
          finance_paths = [services_mortgage_path, services_deposit_path,
                           services_mortgage_vs_deposit_path, new_services_mortgage_application_path]
          finance_active = finance_paths.any? { |p| request.path.start_with?(p) }
        %>
        <button type="button" aria-expanded="false" aria-haspopup="true"
                data-nav-toggle
                class="flex items-center gap-1 text-sm tracking-widest <%= finance_active ? 'text-foreground' : 'text-muted-foreground hover:text-foreground' %> py-1 transition-colors">
          Финансы
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 4l3 3 3-3"/></svg>
        </button>
        <div data-nav-menu-target="panel"
             class="hidden absolute left-0 top-full mt-2 w-[340px] bg-background border border-border shadow-2xl p-5">
          <ul class="space-y-3 text-sm" role="menu">
            <li>
              <%= link_to services_mortgage_path, class: 'block group', role: 'menuitem' do %>
                <span class="block text-foreground group-hover:text-muted-foreground">Ипотечный калькулятор</span>
                <span class="block text-[11px] text-muted-foreground mt-0.5">Платёж, переплата и программы банков</span>
              <% end %>
            </li>
            <li>
              <%= link_to services_deposit_path, class: 'block group', role: 'menuitem' do %>
                <span class="block text-foreground group-hover:text-muted-foreground">Депозитный калькулятор</span>
                <span class="block text-[11px] text-muted-foreground mt-0.5">Доход вклада, программы банков, капитализация</span>
              <% end %>
            </li>
            <li>
              <%= link_to services_mortgage_vs_deposit_path, class: 'block group', role: 'menuitem' do %>
                <span class="block text-foreground group-hover:text-muted-foreground">Вклад или ипотека</span>
                <span class="block text-[11px] text-muted-foreground mt-0.5">Что выгоднее: купить или копить — расчёт на 20 лет</span>
              <% end %>
            </li>
            <li class="pt-3 mt-1 border-t border-border">
              <%= link_to new_services_mortgage_application_path, class: 'block group', role: 'menuitem' do %>
                <span class="block text-foreground group-hover:text-muted-foreground">Подать заявку</span>
                <span class="block text-[11px] text-muted-foreground mt-0.5">Свяжем с банком — без выезда и звонков</span>
              <% end %>
            </li>
          </ul>
        </div>
      </div>

      <%# --- 4. Новости --- %>
      <%= link_to 'Новости', news_path,
            class: "text-sm tracking-widest #{active_class.call(news_path)} py-1 transition-colors" %>

      <%# --- 5. О нас --- %>
      <div class="relative" data-nav-menu-target="item">
        <button type="button" aria-expanded="false" aria-haspopup="true"
                data-nav-toggle
                class="flex items-center gap-1 text-sm tracking-widest <%= active_class.call(about_path) %> py-1 transition-colors">
          О нас
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 4l3 3 3-3"/></svg>
        </button>
        <div data-nav-menu-target="panel"
             class="hidden absolute right-0 top-full mt-2 w-56 bg-background border border-border shadow-2xl p-5">
          <ul class="space-y-2.5 text-sm">
            <li><%= link_to 'О компании', about_path,                class: 'text-foreground hover:text-muted-foreground block' %></li>
            <li><%= link_to 'Команда',    team_path,                 class: 'text-foreground hover:text-muted-foreground block' %></li>
            <li><%= link_to 'Контакты',   contacts_path,             class: 'text-foreground hover:text-muted-foreground block' %></li>
            <li><%= link_to 'Отзывы',     reviews_path,              class: 'text-foreground hover:text-muted-foreground block' %></li>
            <li><%= link_to 'FAQ',        faq_path,                  class: 'text-foreground hover:text-muted-foreground block' %></li>
          </ul>
        </div>
      </div>
    </nav>

    <%# ============================================================
        RIGHT SIDE — auth + CTA
        ============================================================ %>
    <div class="flex items-center gap-3 lg:gap-5 flex-shrink-0">
      <% if user_signed_in? %>
        <%= link_to "КАБИНЕТ", cabinet_path,
              class: "hidden lg:inline-block text-xs tracking-[0.25em] text-muted-foreground hover:text-foreground transition-colors whitespace-nowrap" %>
      <% elsif session[:admin_token_digest].present? %>
        <%= link_to "АДМИН", admin_root_path,
              class: "hidden lg:inline-block text-xs tracking-[0.25em] text-muted-foreground hover:text-foreground transition-colors whitespace-nowrap" %>
      <% else %>
        <%= link_to "ВОЙТИ", new_user_session_path,
              class: "hidden lg:inline-block text-xs tracking-[0.25em] text-muted-foreground hover:text-foreground transition-colors whitespace-nowrap" %>
      <% end %>
      <button type="button" data-chat-trigger
              class="hidden lg:inline-block px-5 py-2.5 text-xs tracking-[0.25em] bg-foreground text-background hover:bg-foreground/85 transition-colors whitespace-nowrap">
        КОНСУЛЬТАЦИЯ
      </button>
      <%# Burger — visible <lg %>
      <button type="button" data-drawer-open
              class="lg:hidden text-foreground" aria-label="Меню">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h16M4 6h16M4 18h16"/></svg>
      </button>
    </div>
  </div>

  <%# ============================================================
      MOBILE DRAWER (slide-in from right, < lg)
      ============================================================ %>
  <div data-drawer-backdrop
       data-drawer-close
       class="lg:hidden fixed inset-0 bg-foreground/40 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 z-40"></div>

  <aside data-drawer-panel
         class="lg:hidden fixed top-0 right-0 h-screen w-[88%] max-w-sm bg-background border-l border-border translate-x-full transition-transform duration-300 ease-out z-50 overflow-y-auto">
    <div class="flex items-center justify-between px-6 py-5 border-b border-border">
      <p class="text-[10px] tracking-[0.4em] text-muted-foreground">МЕНЮ</p>
      <button type="button" data-drawer-close aria-label="Закрыть">
        <svg class="w-6 h-6 text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>

    <nav class="flex flex-col gap-1 px-6 py-5">
      <%= link_to 'Каталог',                properties_path,                  class: 'py-3 text-base text-foreground border-b border-border' %>
      <%= link_to 'Новости',                news_path,                        class: 'py-3 text-base text-foreground border-b border-border' %>
      <%= link_to 'Экспресс-оценка',        valuations_path,                  class: 'py-3 text-base text-foreground border-b border-border' %>
      <%= link_to 'Инвестиционный аудит',   investment_audit_new_path,        class: 'py-3 text-base text-foreground border-b border-border' %>
      <div class="py-3 border-b border-border">
        <p class="text-[10px] tracking-[0.4em] text-muted-foreground mb-2">ФИНАНСЫ</p>
        <%= link_to 'Ипотечный калькулятор',  services_mortgage_path,            class: 'block py-1.5 text-sm text-foreground' %>
        <%= link_to 'Депозитный калькулятор', services_deposit_path,             class: 'block py-1.5 text-sm text-foreground' %>
        <%= link_to 'Вклад или ипотека',      services_mortgage_vs_deposit_path, class: 'block py-1.5 text-sm text-foreground' %>
        <%= link_to 'Подать заявку',          new_services_mortgage_application_path, class: 'block py-1.5 text-sm text-foreground' %>
      </div>
      <%= link_to 'Команда',                team_path,                        class: 'py-3 text-base text-foreground border-b border-border' %>
      <%= link_to 'О компании',             about_path,                       class: 'py-3 text-base text-foreground border-b border-border' %>
      <%= link_to 'Отзывы',                 reviews_path,                     class: 'py-3 text-base text-foreground border-b border-border' %>
      <%= link_to 'FAQ',                    faq_path,                         class: 'py-3 text-base text-foreground border-b border-border' %>
      <%= link_to 'Контакты',               contacts_path,                    class: 'py-3 text-base text-foreground border-b border-border' %>
    </nav>

    <div class="px-6 py-5 border-t border-border">
      <p class="text-[10px] tracking-[0.4em] text-muted-foreground mb-3">ПО РАЙОНАМ РЯЗАНИ</p>
      <div class="flex flex-wrap gap-2">
        <% RyazanDistricts.micro_grouped_by_admin.values.flatten(1).each do |slug, meta| %>
          <%= link_to meta[:name], "/kupit/kvartira/rayon/#{slug}",
                class: 'px-3 py-1.5 text-xs text-muted-foreground border border-border hover:text-foreground hover:border-foreground/60' %>
        <% end %>
      </div>
    </div>

    <div class="px-6 py-5 border-t border-border space-y-3">
      <% if user_signed_in? %>
        <%= link_to "Личный кабинет",  cabinet_path,             class: 'block py-2 text-sm text-foreground' %>
        <%= button_to "Выйти",         destroy_user_session_path, method: :delete,
              class: 'block py-2 text-sm text-muted-foreground hover:text-foreground bg-transparent border-0 p-0 cursor-pointer text-left',
              form: { class: 'block' } %>
      <% else %>
        <%= link_to "Войти",          new_user_session_path,      class: 'block py-2 text-sm text-foreground' %>
        <%= link_to "Регистрация",    new_user_registration_path, class: 'block py-2 text-sm text-muted-foreground hover:text-foreground' %>
      <% end %>
      <a href="<%= agency_phone_tel %>" class="block py-2 text-sm text-foreground">
        <%= agency_phone_primary %>
      </a>
      <button type="button" data-chat-trigger
              class="w-full mt-2 px-5 py-3 text-xs tracking-[0.3em] bg-foreground text-background hover:bg-foreground/85 transition-colors">
        КОНСУЛЬТАЦИЯ
      </button>
    </div>
  </aside>
</header>

<script>
  (function () {
    if (window.__siteHeaderInit) return;
    window.__siteHeaderInit = true;

    var header = document.querySelector('[data-site-header]');
    if (!header) return;

    // ============================================================
    // Desktop nav dropdowns — click + hover + Esc + click-outside.
    // ============================================================
    function closeAllNavMenus() {
      header.querySelectorAll('[data-nav-menu-target="item"]').forEach(function (item) {
        item.classList.remove('is-open');
        var trigger = item.querySelector('[aria-expanded]');
        if (trigger) trigger.setAttribute('aria-expanded', 'false');
        var panel = item.querySelector('[data-nav-menu-target="panel"]');
        if (panel) panel.classList.add('hidden');
      });
    }
    function openNavMenu(item) {
      item.classList.add('is-open');
      var trigger = item.querySelector('[aria-expanded]');
      if (trigger) trigger.setAttribute('aria-expanded', 'true');
      var panel = item.querySelector('[data-nav-menu-target="panel"]');
      if (panel) panel.classList.remove('hidden');
    }

    header.querySelectorAll('[data-nav-toggle]').forEach(function (trigger) {
      trigger.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        var item = trigger.closest('[data-nav-menu-target="item"]');
        if (!item) return;
        var wasOpen = item.classList.contains('is-open');
        closeAllNavMenus();
        if (!wasOpen) openNavMenu(item);
      });
    });

    if (window.matchMedia && window.matchMedia('(pointer: fine)').matches) {
      header.querySelectorAll('[data-nav-menu-target="item"]').forEach(function (item) {
        item.addEventListener('mouseenter', function () {
          closeAllNavMenus();
          openNavMenu(item);
        });
      });
      header.addEventListener('mouseleave', closeAllNavMenus);
    }

    document.addEventListener('click', function (e) {
      if (!header.contains(e.target)) closeAllNavMenus();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') { closeAllNavMenus(); closeDrawer(); }
    });

    // ============================================================
    // Mobile drawer — right-side slide-in.
    // ============================================================
    var panel    = header.querySelector('[data-drawer-panel]');
    var backdrop = header.querySelector('[data-drawer-backdrop]');
    function openDrawer() {
      if (!panel || !backdrop) return;
      panel.classList.remove('translate-x-full');
      panel.classList.add('translate-x-0');
      backdrop.classList.remove('opacity-0', 'pointer-events-none');
      backdrop.classList.add('opacity-100');
      document.documentElement.style.overflow = 'hidden';
    }
    function closeDrawer() {
      if (!panel || !backdrop) return;
      panel.classList.add('translate-x-full');
      panel.classList.remove('translate-x-0');
      backdrop.classList.add('opacity-0', 'pointer-events-none');
      backdrop.classList.remove('opacity-100');
      document.documentElement.style.overflow = '';
    }
    header.querySelectorAll('[data-drawer-open]').forEach(function (btn) {
      btn.addEventListener('click', function (e) { e.preventDefault(); openDrawer(); });
    });
    header.querySelectorAll('[data-drawer-close]').forEach(function (btn) {
      btn.addEventListener('click', function (e) { e.preventDefault(); closeDrawer(); });
    });

    // ============================================================
    // Chat-trigger — opens the floating chat widget.
    // ============================================================
    document.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-chat-trigger]');
      if (!btn) return;
      e.preventDefault();
      window.dispatchEvent(new Event('chat:open'));
    });
  })();
</script>
