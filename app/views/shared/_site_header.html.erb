<header class="fixed top-0 left-0 right-0 z-50 bg-background/80 backdrop-blur-md border-b border-border">
  <div class="flex items-center justify-between px-6 py-4 lg:px-12">
    <%= link_to root_path, class: "text-xl font-light tracking-[0.3em] text-foreground" do %>АН ВИКТОРИ<% end %>

    <nav class="hidden lg:flex items-center gap-12">
      <%= link_to "Каталог",     properties_path,     class: "text-sm tracking-widest text-muted-foreground hover:text-foreground transition-colors duration-300" %>
      <%= link_to "Услуги",      services_page_path,  class: "text-sm tracking-widest text-muted-foreground hover:text-foreground transition-colors duration-300" %>
      <%= link_to "О компании",  about_path,          class: "text-sm tracking-widest text-muted-foreground hover:text-foreground transition-colors duration-300" %>
      <%= link_to "Контакты",    contacts_path,       class: "text-sm tracking-widest text-muted-foreground hover:text-foreground transition-colors duration-300" %>
    </nav>

    <div class="hidden lg:flex items-center gap-8">
      <a href="tel:+74951234567" class="flex items-center gap-2 text-sm tracking-wider text-muted-foreground hover:text-foreground transition-colors">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        +7 495 123 45 67
      </a>
      <% if user_signed_in? %>
        <%= link_to "КАБИНЕТ",  dashboard_root_path,        class: "text-sm tracking-widest text-muted-foreground hover:text-foreground transition-colors" %>
        <%= button_to "ВЫХОД",  destroy_user_session_path,  method: :delete, class: "text-sm tracking-widest text-muted-foreground hover:text-foreground transition-colors bg-transparent border-0 p-0 cursor-pointer", form: { class: "inline" } %>
      <% else %>
        <%= link_to "ВОЙТИ",          new_user_session_path,       class: "text-sm tracking-widest text-muted-foreground hover:text-foreground transition-colors" %>
      <% end %>
      <button type="button" data-chat-trigger
              class="px-6 py-2 text-sm tracking-widest bg-foreground text-background hover:bg-foreground/90 transition-colors">
        КОНСУЛЬТАЦИЯ
      </button>
    </div>

    <button class="lg:hidden text-foreground" onclick="document.getElementById('mobile-nav').classList.toggle('hidden')" aria-label="Меню">
      <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16M4 6h16M4 18h16"/></svg>
    </button>
  </div>

  <div id="mobile-nav" class="hidden lg:hidden border-t border-border">
    <nav class="flex flex-col py-4 px-6">
      <%= link_to "Каталог",     properties_path,    class: "py-3 text-sm tracking-wider text-muted-foreground hover:text-foreground transition-colors" %>
      <%= link_to "Услуги",      services_page_path, class: "py-3 text-sm tracking-wider text-muted-foreground hover:text-foreground transition-colors" %>
      <%= link_to "О компании",  about_path,         class: "py-3 text-sm tracking-wider text-muted-foreground hover:text-foreground transition-colors" %>
      <%= link_to "Контакты",    contacts_path,      class: "py-3 text-sm tracking-wider text-muted-foreground hover:text-foreground transition-colors" %>
      <% if user_signed_in? %>
        <%= link_to "Кабинет",  dashboard_root_path,        class: "py-3 text-sm tracking-wider text-muted-foreground hover:text-foreground transition-colors" %>
        <%= button_to "Выход",  destroy_user_session_path,  method: :delete, class: "py-3 text-sm tracking-wider text-muted-foreground hover:text-foreground transition-colors bg-transparent border-0 p-0 cursor-pointer text-left", form: { class: "block" } %>
      <% else %>
        <%= link_to "Войти",        new_user_session_path,       class: "py-3 text-sm tracking-wider text-muted-foreground hover:text-foreground transition-colors" %>
        <%= link_to "Регистрация",  new_user_registration_path,  class: "py-3 text-sm tracking-wider text-muted-foreground hover:text-foreground transition-colors" %>
      <% end %>
      <button type="button" data-chat-trigger class="py-3 text-left text-sm tracking-wider text-foreground hover:text-muted-foreground transition-colors bg-transparent border-0 p-0 cursor-pointer">
        Консультация
      </button>
    </nav>
  </div>
</header>

<script>
  // Globally route any data-chat-trigger button to open the floating widget.
  document.addEventListener('click', function (e) {
    const btn = e.target.closest('[data-chat-trigger]');
    if (!btn) return;
    e.preventDefault();
    window.dispatchEvent(new Event('chat:open'));
  });
</script>
