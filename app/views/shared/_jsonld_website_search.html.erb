<%#
  WebSite + SearchAction JSON-LD.

  Render ONLY on the homepage. Google uses this to display the sitelinks
  search box in SERP. Duplicates on inner pages confuse the signal — keep
  this single instance on the landing only.

  Target URL: /properties/search?q[title_or_description_cont]={search_term_string}
  matches the existing Ransack collection action `get :search` on /properties.
%>
<script type="application/ld+json">
<%= raw JSON.pretty_generate(
  '@context'        => 'https://schema.org',
  '@type'           => 'WebSite',
  'url'             => root_url,
  'name'            => 'АН «Виктори»',
  'alternateName'   => 'Victory Real Estate Agency',
  'inLanguage'      => 'ru-RU',
  'potentialAction' => {
    '@type'       => 'SearchAction',
    'target'      => {
      '@type'       => 'EntryPoint',
      'urlTemplate' => "#{search_properties_url}?q[title_or_description_cont]={search_term_string}"
    },
    'query-input' => 'required name=search_term_string'
  }
) %>
</script>
