<% content_for :title, (@category.present? ? "Блог: #{@category.humanize} — АН Виктори" : 'Блог о недвижимости Рязани — АН Виктори') %>
<% content_for :seo_description, (@category.present? ?
   "Статьи и обзоры в категории «#{@category.humanize}» от АН «Виктори»." :
   'Аналитика рынка недвижимости Рязани, инструкции для покупателей и продавцов, обзоры районов и инвест-разборы.') %>

<% content_for :head do %>
  <script type="application/ld+json">
  <%= raw({
    '@context' => 'https://schema.org',
    '@type' => 'Blog',
    'name' => content_for(:title),
    'description' => content_for(:seo_description),
    'url' => url_for(only_path: false, host: request.host_with_port),
    'publisher' => { '@id' => "#{AgencyInfo::WEBSITE_URL}/#agent" },
    'blogPost' => @articles.first(20).map { |a|
      {
        '@type' => 'BlogPosting',
        'headline' => a.title,
        'url' => blog_post_url(slug: a.slug, host: request.host_with_port),
        'datePublished' => a.published_at&.iso8601,
        'author' => { '@type' => 'Person', 'name' => (a.author&.try(:display_name) || 'АН Виктори') }
      }.compact
    }
  }.to_json) %>
  </script>
<% end %>

<section class="px-6 lg:px-12 pt-32 pb-12 bg-background">
  <div class="max-w-6xl mx-auto">
    <p class="text-sm tracking-[0.4em] text-muted-foreground mb-4">БЛОГ</p>
    <h1 class="text-4xl lg:text-5xl font-light tracking-wider text-foreground mb-6 uppercase">
      <%= @category.present? ? @category.humanize : 'О рынке и недвижимости' %>
    </h1>
    <p class="text-base text-muted-foreground leading-relaxed max-w-3xl">
      Аналитика, обзоры районов Рязани, инструкции для покупателей и инвесторов.
    </p>

    <% if Article::CATEGORIES.any? %>
      <div class="flex flex-wrap gap-2 mt-8">
        <%= link_to 'Все', blog_path,
              class: "px-4 py-2 text-xs tracking-wider border #{@category.blank? ? 'bg-foreground text-background border-foreground' : 'border-border text-muted-foreground hover:border-foreground hover:text-foreground'} transition-colors" %>
        <% Article::CATEGORIES.each do |cat| %>
          <% active = (@category == cat) %>
          <%= link_to cat.humanize, blog_category_path(category: cat),
                class: "px-4 py-2 text-xs tracking-wider border #{active ? 'bg-foreground text-background border-foreground' : 'border-border text-muted-foreground hover:border-foreground hover:text-foreground'} transition-colors" %>
        <% end %>
      </div>
    <% end %>
  </div>
</section>

<section class="px-6 lg:px-12 py-12 bg-background">
  <div class="max-w-6xl mx-auto">
    <% if @articles.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @articles.each do |article| %>
          <%= render 'article_card', article: article %>
        <% end %>
      </div>
      <% if @articles.respond_to?(:total_pages) && @articles.total_pages > 1 %>
        <div class="flex justify-center mt-16">
          <%= paginate @articles, theme: 'plain' rescue nil %>
        </div>
      <% end %>
    <% else %>
      <div class="border border-border p-16 text-center">
        <p class="text-sm tracking-wider text-muted-foreground mb-2">Пока нет статей в этой категории</p>
        <%= link_to 'Все статьи →', blog_path, class: 'mt-6 inline-block text-xs tracking-[0.3em] text-foreground underline hover:text-muted-foreground' %>
      </div>
    <% end %>
  </div>
</section>
