<% content_for :title, 'Объявление снято — АН Виктори' %>
<% content_for :meta_robots, 'noindex, follow' %>

<%#
  HTTP 410 Gone. Контент существовал, но удалён или архивирован — статья
  hidden через admin, объект продан/снят. Recovery paths внизу превращают
  dead-end в навигационный hub (тот же подход что not_found, но с честным
  сигналом «уже не вернётся», не «возможно появится»).
%>
<%
  catalog_total   = (Property.on_site.count rescue 0)
  district_counts = (Property.on_site.where.not(district: [nil, '']).group(:district).count rescue {})
  top_districts   = district_counts.sort_by { |_, c| -c }.first(8)
  recent_properties = (Property.on_site.order(updated_at: :desc).limit(4).to_a rescue [])
%>

<section class="px-6 lg:px-12 pt-32 pb-12 bg-background">
  <div class="max-w-3xl mx-auto text-center">
    <p class="text-sm tracking-[0.4em] text-muted-foreground mb-6">410</p>
    <h1 class="text-5xl lg:text-7xl font-light tracking-wider text-foreground mb-8">УЖЕ НЕ АКТУАЛЬНО</h1>
    <p class="text-base text-muted-foreground leading-relaxed mb-12 max-w-xl mx-auto">
      Этот объект продан или снят с публикации. В каталоге сейчас <span class="text-foreground"><%= catalog_total %></span> актуальных предложений в Рязани и области — подберём аналог по вашим параметрам.
    </p>
    <div class="flex flex-wrap items-center justify-center gap-4">
      <%= link_to 'В КАТАЛОГ', properties_path, class: "px-8 py-4 text-sm tracking-[0.3em] bg-foreground text-background hover:bg-foreground/90 transition-colors" %>
      <%= link_to 'ГЛАВНАЯ',   root_path,        class: "px-8 py-4 text-sm tracking-[0.3em] border border-border text-foreground hover:bg-foreground hover:text-background transition-colors" %>
      <button type="button" data-chat-trigger class="px-8 py-4 text-sm tracking-[0.3em] border border-border text-foreground hover:bg-foreground hover:text-background transition-colors">
        ПОДОБРАТЬ АНАЛОГ
      </button>
    </div>
  </div>
</section>

<% if top_districts.any? %>
  <section class="px-6 lg:px-12 py-12 bg-background border-t border-border">
    <div class="max-w-5xl mx-auto">
      <p class="text-sm tracking-[0.4em] text-muted-foreground mb-6 text-center">РАЙОНЫ РЯЗАНИ</p>
      <div class="flex flex-wrap gap-3 justify-center">
        <% top_districts.each do |district, count| %>
          <%= link_to properties_path(q: { district_eq: district }),
                      class: "group inline-flex items-baseline gap-2 px-4 py-2 border border-border hover:border-foreground transition-colors" do %>
            <span class="text-sm tracking-wider text-foreground"><%= district %></span>
            <span class="text-xs tracking-wider text-muted-foreground"><%= count %></span>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<% if recent_properties.any? %>
  <section class="px-6 lg:px-12 py-16 bg-background border-t border-border">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-end justify-between mb-12">
        <div>
          <p class="text-sm tracking-[0.4em] text-muted-foreground mb-4">АКТУАЛЬНЫЕ ОБЪЕКТЫ</p>
          <h2 class="text-2xl lg:text-3xl font-light tracking-wider text-foreground">МОЖЕТ ПОДОЙТИ</h2>
        </div>
        <%= link_to "ВСЕ ОБЪЕКТЫ →", properties_path, class: "text-sm tracking-[0.3em] text-muted-foreground hover:text-foreground transition-colors" %>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <% recent_properties.each do |p| %>
          <%= render 'properties/property_card', property: p %>
        <% end %>
      </div>
    </div>
  </section>
<% end %>
