<% content_for :title, "#{@article.title} — АН Виктори" %>

<%
  category_ru = {
    'news' => 'НОВОСТИ', 'market' => 'РЫНОК', 'mortgage' => 'ИПОТЕКА',
    'investment' => 'ИНВЕСТИЦИИ', 'guides' => 'ГИД'
  }[@article.category.to_s] || @article.category.to_s.upcase
  source_url = @article.metadata&.dig('source_url') || @article.metadata&.dig(:source_url)
  hashtags   = @article.metadata&.dig('hashtags') || @article.metadata&.dig(:hashtags)
  image_url  = @article.metadata&.dig('image_url') || @article.metadata&.dig(:image_url)
%>

<%# JSON-LD %>
<script type="application/ld+json">
<%= raw({
  "@context": "https://schema.org",
  "@type": @article.schema_type,
  "headline": @article.title,
  "datePublished": @article.published_at&.iso8601,
  "dateModified":  @article.updated_at&.iso8601,
  "url": news_item_url(@article.slug),
  "publisher": {
    "@type": "Organization",
    "name": (defined?(AgencyInfo) ? AgencyInfo::NAME : 'АН Виктори'),
    "url": (defined?(AgencyInfo) ? AgencyInfo::WEBSITE_URL : root_url)
  },
  "author": {
    "@type": "Organization",
    "name": (defined?(AgencyInfo) ? AgencyInfo::NAME : 'АН Виктори')
  },
  "description": @article.short_excerpt(length: 200),
  "image": image_url
}.compact.to_json) %>
</script>

<article class="px-6 lg:px-12 pt-32 pb-20 bg-background min-h-screen">
  <%# === Header === %>
  <header class="max-w-3xl mx-auto mb-10">
    <%= link_to "← Все новости", news_path,
          class: "inline-block text-[11px] tracking-[0.3em] text-muted-foreground hover:text-foreground mb-8" %>
    <div class="flex items-baseline justify-between mb-6 flex-wrap gap-3 text-[11px] tracking-[0.3em] text-muted-foreground">
      <span><%= category_ru %></span>
      <% if @article.published_at %>
        <span><%= l(@article.published_at.to_date, format: :long) %></span>
      <% end %>
    </div>
    <h1 class="text-3xl md:text-4xl lg:text-5xl font-light tracking-tight text-foreground leading-[1.15] mb-6">
      <%= @article.title %>
    </h1>
    <% if @article.excerpt.present? %>
      <p class="text-lg lg:text-xl text-muted-foreground leading-relaxed mb-6">
        <%= @article.excerpt %>
      </p>
    <% end %>
    <%# Byline — agency-author by default; falls back to author.full_name if set. %>
    <p class="text-xs tracking-[0.25em] text-muted-foreground/80">
      <%= (@article.author&.full_name.presence || 'АН Виктори') %>
      <span class="opacity-50 mx-2">·</span>
      <%= @article.reading_minutes %> МИН ЧТЕНИЯ
      <% if @article.views_count.to_i > 0 %>
        <span class="opacity-50 mx-2">·</span>
        <%= number_with_delimiter(@article.views_count, delimiter: ' '.encode('UTF-8')) %> ПРОСМОТРОВ
      <% end %>
    </p>
  </header>

  <%# === Image if present === %>
  <% if image_url.present? %>
    <div class="max-w-4xl mx-auto mb-10">
      <%= image_tag image_url, alt: @article.title, class: "w-full h-auto border border-border", loading: "lazy" %>
    </div>
  <% end %>

  <%# === Body === %>
  <div class="max-w-3xl mx-auto prose prose-invert prose-lg max-w-none article-body
              [&_p]:text-base [&_p]:lg:text-lg [&_p]:text-foreground/90 [&_p]:leading-relaxed [&_p]:mb-5
              [&_h2]:text-2xl [&_h2]:lg:text-3xl [&_h2]:font-light [&_h2]:text-foreground [&_h2]:tracking-tight [&_h2]:mt-10 [&_h2]:mb-4
              [&_h3]:text-xl [&_h3]:font-medium [&_h3]:text-foreground [&_h3]:mt-8 [&_h3]:mb-3
              [&_a]:text-foreground [&_a]:underline [&_a]:underline-offset-2 [&_a]:decoration-foreground/40 hover:[&_a]:decoration-foreground
              [&_blockquote]:border-l-2 [&_blockquote]:border-foreground/40 [&_blockquote]:pl-5 [&_blockquote]:text-muted-foreground [&_blockquote]:italic [&_blockquote]:my-6
              [&_ul]:my-5 [&_ul]:pl-5 [&_ul]:list-disc [&_ul]:text-foreground/90
              [&_ol]:my-5 [&_ol]:pl-5 [&_ol]:list-decimal [&_ol]:text-foreground/90
              [&_li]:mb-2
              [&_strong]:text-foreground [&_strong]:font-medium
              [&_code]:bg-secondary [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:text-sm">
    <%= @article.body_html.to_s.html_safe %>
  </div>

  <%# === Share bar — TG/VK/copy === %>
  <div class="max-w-3xl mx-auto">
    <%= render 'news/share_bar', article: @article %>
  </div>

  <%# === Telegram channel CTA — appears after body but before tags === %>
  <div class="max-w-3xl mx-auto">
    <%= render 'news/tg_channel_cta' %>
  </div>

  <%# === Hashtags + source === %>
  <% if hashtags.present? || source_url.present? %>
    <footer class="max-w-3xl mx-auto mt-12 pt-8 border-t border-border space-y-3">
      <% if hashtags.present? && hashtags.any? %>
        <div class="flex flex-wrap gap-2">
          <% hashtags.each do |tag| %>
            <span class="text-xs tracking-wider text-muted-foreground"><%= tag %></span>
          <% end %>
        </div>
      <% end %>
      <% if source_url.present? %>
        <p class="text-xs text-muted-foreground">
          Источник: <%= link_to source_url, source_url, class: "underline hover:text-foreground", target: "_blank", rel: "noopener noreferrer nofollow" %>
        </p>
      <% end %>
    </footer>
  <% end %>

  <%# === Related — embedding-based when available, category-fallback otherwise === %>
  <% if @related.any? %>
    <section class="max-w-7xl mx-auto mt-20 pt-12 border-t border-border">
      <div class="flex items-baseline justify-between mb-6 flex-wrap gap-3">
        <p class="text-xs tracking-[0.4em] text-muted-foreground">ЕЩЁ ПО ТЕМЕ</p>
        <%= link_to "Все новости →", news_path,
              class: "text-xs tracking-[0.25em] text-muted-foreground hover:text-foreground border-b border-border/40 pb-1" %>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <% @related.each do |a| %>
          <%= render 'shared/article_card', article: a %>
        <% end %>
      </div>
    </section>
  <% end %>

  <%# === Prev / Next navigation === %>
  <% if @prev_article || @next_article %>
    <nav class="max-w-3xl mx-auto mt-16 pt-8 border-t border-border grid grid-cols-1 sm:grid-cols-2 gap-6">
      <div>
        <% if @prev_article %>
          <p class="text-[10px] tracking-[0.4em] text-muted-foreground mb-2">← ПРЕДЫДУЩАЯ</p>
          <%= link_to news_item_path(@prev_article.slug),
                class: "block text-sm lg:text-base text-foreground hover:text-muted-foreground transition-colors leading-snug" do %>
            <%= @prev_article.title.truncate(80) %>
          <% end %>
        <% end %>
      </div>
      <div class="sm:text-right">
        <% if @next_article %>
          <p class="text-[10px] tracking-[0.4em] text-muted-foreground mb-2">СЛЕДУЮЩАЯ →</p>
          <%= link_to news_item_path(@next_article.slug),
                class: "block text-sm lg:text-base text-foreground hover:text-muted-foreground transition-colors leading-snug" do %>
            <%= @next_article.title.truncate(80) %>
          <% end %>
        <% end %>
      </div>
    </nav>
  <% end %>
</article>
