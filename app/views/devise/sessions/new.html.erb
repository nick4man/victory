<% content_for :title, "Вход — АН Виктори" %>

<section class="min-h-[80vh] px-6 lg:px-12 py-24 bg-background flex items-center">
  <div class="w-full max-w-md mx-auto">
    <p class="text-sm tracking-[0.4em] text-muted-foreground mb-4 text-center">АН ВИКТОРИ</p>
    <h1 class="text-3xl lg:text-4xl font-light tracking-wider text-foreground mb-12 text-center">ВХОД В КАБИНЕТ</h1>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "flex flex-col gap-6" }) do |f| %>
      <div>
        <label class="text-xs tracking-[0.3em] text-muted-foreground mb-3 block">EMAIL</label>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true,
              class: "w-full bg-transparent border-b border-border py-3 text-foreground tracking-wider focus:border-foreground focus:outline-none transition-colors" %>
      </div>

      <div>
        <label class="text-xs tracking-[0.3em] text-muted-foreground mb-3 block">ПАРОЛЬ</label>
        <%= f.password_field :password, autocomplete: "current-password", required: true,
              class: "w-full bg-transparent border-b border-border py-3 text-foreground tracking-wider focus:border-foreground focus:outline-none transition-colors" %>
      </div>

      <div class="flex items-center justify-between text-xs tracking-wider text-muted-foreground pt-2">
        <% if devise_mapping.rememberable? %>
          <label class="flex items-center gap-2 cursor-pointer">
            <%= f.check_box :remember_me, class: "accent-foreground" %>
            ЗАПОМНИТЬ
          </label>
        <% end %>
        <%= link_to "ЗАБЫЛИ ПАРОЛЬ?", new_user_password_path, class: "hover:text-foreground transition-colors" %>
      </div>

      <%= f.submit "ВОЙТИ", class: "mt-6 px-8 py-4 text-sm tracking-[0.3em] bg-foreground text-background hover:bg-foreground/90 transition-colors cursor-pointer" %>
    <% end %>

    <p class="text-center text-xs tracking-wider text-muted-foreground mt-12">
      Нет аккаунта?
      <%= link_to "ЗАРЕГИСТРИРОВАТЬСЯ", new_user_registration_path, class: "ml-2 text-foreground hover:text-muted-foreground transition-colors" %>
    </p>
  </div>
</section>
