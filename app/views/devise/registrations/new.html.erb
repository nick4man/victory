<% content_for :title, "Регистрация — АН Виктори" %>

<section class="min-h-[80vh] px-6 lg:px-12 py-24 bg-background flex items-center">
  <div class="w-full max-w-md mx-auto">
    <p class="text-sm tracking-[0.4em] text-muted-foreground mb-4 text-center">АН ВИКТОРИ</p>
    <h1 class="text-3xl lg:text-4xl font-light tracking-wider text-foreground mb-12 text-center">СОЗДАНИЕ АККАУНТА</h1>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "flex flex-col gap-6" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="grid grid-cols-2 gap-6">
        <div>
          <label class="text-xs tracking-[0.3em] text-muted-foreground mb-3 block">ИМЯ</label>
          <%= f.text_field :first_name, autofocus: true, required: true, class: "w-full bg-transparent border-b border-border py-3 text-foreground tracking-wider focus:border-foreground focus:outline-none transition-colors" %>
        </div>
        <div>
          <label class="text-xs tracking-[0.3em] text-muted-foreground mb-3 block">ФАМИЛИЯ</label>
          <%= f.text_field :last_name, required: true, class: "w-full bg-transparent border-b border-border py-3 text-foreground tracking-wider focus:border-foreground focus:outline-none transition-colors" %>
        </div>
      </div>

      <div>
        <label class="text-xs tracking-[0.3em] text-muted-foreground mb-3 block">ТЕЛЕФОН</label>
        <%= f.telephone_field :phone, class: "w-full bg-transparent border-b border-border py-3 text-foreground tracking-wider focus:border-foreground focus:outline-none transition-colors" %>
      </div>

      <div>
        <label class="text-xs tracking-[0.3em] text-muted-foreground mb-3 block">EMAIL</label>
        <%= f.email_field :email, autocomplete: "email", required: true, class: "w-full bg-transparent border-b border-border py-3 text-foreground tracking-wider focus:border-foreground focus:outline-none transition-colors" %>
      </div>

      <div>
        <label class="text-xs tracking-[0.3em] text-muted-foreground mb-3 block">ПАРОЛЬ</label>
        <%= f.password_field :password, autocomplete: "new-password", required: true, class: "w-full bg-transparent border-b border-border py-3 text-foreground tracking-wider focus:border-foreground focus:outline-none transition-colors" %>
      </div>

      <div>
        <label class="text-xs tracking-[0.3em] text-muted-foreground mb-3 block">ПОДТВЕРЖДЕНИЕ ПАРОЛЯ</label>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true, class: "w-full bg-transparent border-b border-border py-3 text-foreground tracking-wider focus:border-foreground focus:outline-none transition-colors" %>
      </div>

      <label class="flex items-start gap-3 text-xs tracking-wider text-muted-foreground pt-2 cursor-pointer">
        <%= check_box_tag :terms, "1", false, required: true, class: "accent-foreground mt-0.5" %>
        <span>
          Соглашаюсь с
          <%= link_to "условиями", terms_path, target: "_blank", class: "text-foreground hover:text-muted-foreground transition-colors" %>
          и
          <%= link_to "политикой конфиденциальности", privacy_path, target: "_blank", class: "text-foreground hover:text-muted-foreground transition-colors" %>
        </span>
      </label>

      <%= f.submit "ЗАРЕГИСТРИРОВАТЬСЯ", class: "mt-6 px-8 py-4 text-sm tracking-[0.3em] bg-foreground text-background hover:bg-foreground/90 transition-colors cursor-pointer" %>
    <% end %>

    <p class="text-center text-xs tracking-wider text-muted-foreground mt-12">
      Уже есть аккаунт?
      <%= link_to "ВОЙТИ", new_user_session_path, class: "ml-2 text-foreground hover:text-muted-foreground transition-colors" %>
    </p>
  </div>
</section>
