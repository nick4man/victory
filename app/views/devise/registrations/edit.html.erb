<% content_for :title, "Профиль — АН Виктори" %>

<section class="px-6 lg:px-12 py-24 bg-background">
  <div class="w-full max-w-md mx-auto">
    <p class="text-sm tracking-[0.4em] text-muted-foreground mb-4">ПРОФИЛЬ</p>
    <h1 class="text-3xl lg:text-4xl font-light tracking-wider text-foreground mb-12">РЕДАКТИРОВАНИЕ</h1>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "flex flex-col gap-6" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="grid grid-cols-2 gap-6">
        <div>
          <label class="text-xs tracking-[0.3em] text-muted-foreground mb-3 block">ИМЯ</label>
          <%= f.text_field :first_name, class: "w-full bg-transparent border-b border-border py-3 text-foreground tracking-wider focus:border-foreground focus:outline-none transition-colors" %>
        </div>
        <div>
          <label class="text-xs tracking-[0.3em] text-muted-foreground mb-3 block">ФАМИЛИЯ</label>
          <%= f.text_field :last_name, class: "w-full bg-transparent border-b border-border py-3 text-foreground tracking-wider focus:border-foreground focus:outline-none transition-colors" %>
        </div>
      </div>
      <div>
        <label class="text-xs tracking-[0.3em] text-muted-foreground mb-3 block">EMAIL</label>
        <%= f.email_field :email, class: "w-full bg-transparent border-b border-border py-3 text-foreground tracking-wider focus:border-foreground focus:outline-none transition-colors" %>
      </div>
      <div>
        <label class="text-xs tracking-[0.3em] text-muted-foreground mb-3 block">ТЕЛЕФОН</label>
        <%= f.telephone_field :phone, class: "w-full bg-transparent border-b border-border py-3 text-foreground tracking-wider focus:border-foreground focus:outline-none transition-colors" %>
      </div>
      <div>
        <label class="text-xs tracking-[0.3em] text-muted-foreground mb-3 block">НОВЫЙ ПАРОЛЬ</label>
        <%= f.password_field :password, autocomplete: "new-password", class: "w-full bg-transparent border-b border-border py-3 text-foreground tracking-wider focus:border-foreground focus:outline-none transition-colors" %>
        <p class="text-xs text-muted-foreground mt-2">Оставьте пустым, чтобы не менять</p>
      </div>
      <div>
        <label class="text-xs tracking-[0.3em] text-muted-foreground mb-3 block">ТЕКУЩИЙ ПАРОЛЬ</label>
        <%= f.password_field :current_password, autocomplete: "current-password", required: true, class: "w-full bg-transparent border-b border-border py-3 text-foreground tracking-wider focus:border-foreground focus:outline-none transition-colors" %>
      </div>

      <%= f.submit "СОХРАНИТЬ", class: "mt-6 px-8 py-4 text-sm tracking-[0.3em] bg-foreground text-background hover:bg-foreground/90 transition-colors cursor-pointer" %>
    <% end %>
  </div>
</section>
