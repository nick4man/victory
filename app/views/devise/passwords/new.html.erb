<% content_for :title, "Восстановление пароля — АН Виктори" %>

<section class="min-h-[80vh] px-6 lg:px-12 py-24 bg-background flex items-center">
  <div class="w-full max-w-md mx-auto">
    <p class="text-sm tracking-[0.4em] text-muted-foreground mb-4 text-center">ВОССТАНОВЛЕНИЕ</p>
    <h1 class="text-3xl lg:text-4xl font-light tracking-wider text-foreground mb-12 text-center">ЗАБЫЛИ ПАРОЛЬ?</h1>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "flex flex-col gap-6" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <p class="text-sm text-muted-foreground tracking-wider">Введите ваш email — мы отправим инструкции по восстановлению.</p>
      <div>
        <label class="text-xs tracking-[0.3em] text-muted-foreground mb-3 block">EMAIL</label>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "w-full bg-transparent border-b border-border py-3 text-foreground tracking-wider focus:border-foreground focus:outline-none transition-colors" %>
      </div>
      <%= f.submit "ОТПРАВИТЬ ИНСТРУКЦИИ", class: "mt-6 px-8 py-4 text-sm tracking-[0.3em] bg-foreground text-background hover:bg-foreground/90 transition-colors cursor-pointer" %>
    <% end %>

    <p class="text-center text-xs tracking-wider text-muted-foreground mt-12">
      <%= link_to "← НАЗАД К ВХОДУ", new_user_session_path, class: "text-foreground hover:text-muted-foreground transition-colors" %>
    </p>
  </div>
</section>
