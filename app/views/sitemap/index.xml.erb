<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
  <%# Static pages — order is purely cosmetic; priority tells crawlers what we value %>
  <% [
    [root_url,                       'daily',   1.0],
    [properties_url,                 'hourly',  0.9],
    [map_properties_url,             'weekly',  0.7],
    [services_page_url,              'monthly', 0.7],
    [new_property_valuation_url,     'weekly',  0.7],
    [about_url,                      'monthly', 0.5],
    [team_url,                       'monthly', 0.6],
    [history_url,                    'monthly', 0.4],
    [contacts_url,                   'monthly', 0.5],
    [faq_url,                        'monthly', 0.5],
    [privacy_url,                    'yearly',  0.2],
    [terms_url,                      'yearly',  0.2],
    [blog_url,                       'daily',   0.7]
  ].each do |loc, freq, prio| %>
    <url>
      <loc><%= loc %></loc>
      <changefreq><%= freq %></changefreq>
      <priority><%= prio %></priority>
    </url>
  <% end %>
  <%#
    NB: SEO landings (/kupit/*, /snyat/*) are intentionally NOT in this
    sitemap yet. Without editorial content per landing they're soft-404
    candidates and Google will demote the whole sitemap if many entries
    look thin. Add them here as content arrives via landings/content/.
  %>
  <% base_host = "#{request.protocol}#{request.host_with_port}" %>
  <% @properties.each do |property| %>
    <url>
      <loc><%= property_url(property) %></loc>
      <lastmod><%= property.updated_at.iso8601 %></lastmod>
      <changefreq>weekly</changefreq>
      <priority>0.7</priority>
      <%# Image sitemap entries — Google Image SEO + Yandex картинки. Hero
          variant gives 1920×1440 jpg which clears Google's 1200px threshold
          for rich-image eligibility. Capped at 6 images per property — well
          under Google's 1000-images-per-URL ceiling, keeps sitemap small. %>
      <% if property.images.attached? %>
        <% property.images.first(6).each do |img| %>
          <% img_path = (url_for(img.variant(:hero)) rescue nil) %>
          <% next unless img_path %>
          <image:image>
            <image:loc><%= img_path.start_with?('http') ? img_path : "#{base_host}#{img_path}" %></image:loc>
            <image:title><%= property.title.to_s.encode(xml: :text) %></image:title>
            <image:caption><%= property_image_alt(property).to_s.encode(xml: :text) %></image:caption>
          </image:image>
        <% end %>
      <% end %>
    </url>
  <% end %>
  <%# Blog articles — substantive editorial content, safe to include. %>
  <% (@articles || []).each do |article| %>
    <url>
      <loc><%= blog_post_url(slug: article.slug) %></loc>
      <lastmod><%= article.updated_at.iso8601 %></lastmod>
      <changefreq>weekly</changefreq>
      <priority>0.6</priority>
    </url>
  <% end %>
  <%# Agent profile pages — Person Schema + E-E-A-T entry points. %>
  <% (@agents || []).each do |agent| %>
    <url>
      <loc><%= agent_url(agent.agent_slug) %></loc>
      <lastmod><%= agent.updated_at.iso8601 %></lastmod>
      <changefreq>monthly</changefreq>
      <priority>0.5</priority>
    </url>
  <% end %>
</urlset>
