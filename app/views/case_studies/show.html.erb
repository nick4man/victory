<%# Single case-study landing — следует структуре из case-study-writer
    agent spec: Hook → Lede → Meta-блок → Body (challenge/solution/result/
    takeaway, agent emits всё это как markdown в body) → CTA → JSON-LD. %>

<% content_for :head do %>
  <%= render 'shared/jsonld_case_study', case_study: @case_study %>
<% end %>

<section class="px-6 lg:px-12 pt-32 pb-12 bg-background">
  <div class="max-w-3xl mx-auto">
    <p class="text-sm tracking-[0.4em] text-muted-foreground mb-4">
      <%= link_to 'КЕЙСЫ', cases_path, class: 'hover:text-foreground transition-colors' %>
      <% if @case_study.district.present? %>· <%= @case_study.district.upcase %><% end %>
    </p>

    <h1 class="text-3xl lg:text-4xl font-light tracking-wider text-foreground mb-6 leading-tight">
      <%= @case_study.title %>
    </h1>

    <% if @case_study.excerpt.present? %>
      <p class="text-base text-muted-foreground leading-relaxed mb-8 max-w-2xl">
        <%= @case_study.excerpt %>
      </p>
    <% end %>

    <%# Meta-блок: район • тип • площадь • сумма • срок (per agent spec) %>
    <div class="border-y border-border py-4 mb-12 flex flex-wrap items-baseline gap-x-8 gap-y-2 text-xs tracking-wider text-muted-foreground uppercase">
      <% if @case_study.district.present? %>
        <span>Район: <span class="text-foreground"><%= @case_study.district %></span></span>
      <% end %>
      <% type_ru = { 'flat' => 'квартира', 'house' => 'дом', 'commercial' => 'коммерция', 'land' => 'участок' }[@case_study.property_type] || @case_study.property_type %>
      <span>Тип: <span class="text-foreground"><%= type_ru %></span></span>
      <% if @case_study.area.present? %>
        <span>Площадь: <span class="text-foreground"><%= @case_study.area.to_i %> м²</span></span>
      <% end %>
      <% if @case_study.deal_amount.present? %>
        <span>Сумма: <span class="text-foreground"><%= @case_study.deal_amount_human %></span></span>
      <% end %>
      <% if @case_study.deal_duration_days.present? %>
        <span>Срок: <span class="text-foreground"><%= @case_study.deal_duration_human %></span></span>
      <% end %>
      <% if @case_study.bank.present? %>
        <span>Банк: <span class="text-foreground"><%= @case_study.bank %></span></span>
      <% end %>
    </div>
  </div>
</section>

<section class="px-6 lg:px-12 pb-16 bg-background">
  <div class="max-w-3xl mx-auto prose prose-lg text-foreground">
    <%= @case_study.body_html&.html_safe || simple_format(@case_study.body) %>
  </div>
</section>

<%# CTA footer-block %>
<section class="px-6 lg:px-12 py-16 bg-card border-t border-border">
  <div class="max-w-3xl mx-auto text-center">
    <p class="text-sm tracking-[0.3em] text-muted-foreground mb-4 uppercase">Похожая ситуация?</p>
    <h2 class="text-2xl lg:text-3xl font-light tracking-wider text-foreground mb-6">
      Расскажу детали по телефону
    </h2>
    <p class="text-sm text-muted-foreground leading-relaxed mb-8 max-w-xl mx-auto">
      Каждая сделка индивидуальна. Если вы видите параллели с этим кейсом —
      позвоните, обсудим вашу ситуацию и какие шаги имеют смысл именно для вас.
    </p>
    <div class="flex flex-wrap gap-4 justify-center">
      <a href="<%= agency_phone_tel %>" class="px-6 py-3 text-xs tracking-[0.3em] uppercase border border-foreground bg-foreground text-background hover:bg-foreground/85 transition-colors">
        <%= agency_phone_primary %>
      </a>
      <%= link_to "Все кейсы", cases_path, class: "px-6 py-3 text-xs tracking-[0.3em] uppercase border border-border text-muted-foreground hover:border-foreground hover:text-foreground transition-colors" %>
    </div>
  </div>
</section>
