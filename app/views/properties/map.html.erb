<% content_for :title, "Карта объектов — АН Виктори" %>

<%
  has_key = ENV['YANDEX_MAPS_API_KEY'].present?
  map_data = (@properties || []).map do |p|
    {
      id:              p.id,
      title:           p.title,
      address:         p.address,
      rooms:           p.rooms,
      area:            p.area,
      price_formatted: p.price_formatted,
      url:             property_path(p),
      coordinates:     { lat: p.latitude, lng: p.longitude },
      deal_type:       p.deal_type,
      is_featured:     p.respond_to?(:is_featured) && p.is_featured
    }
  end
%>

<section class="px-6 lg:px-12 pt-12 pb-6 bg-background">
  <div class="max-w-7xl mx-auto flex items-end justify-between">
    <div>
      <p class="text-sm tracking-[0.4em] text-muted-foreground mb-3">КАРТА</p>
      <h1 class="text-3xl lg:text-4xl font-light tracking-wider text-foreground">ОБЪЕКТЫ НА КАРТЕ</h1>
      <p class="text-sm text-muted-foreground tracking-wide mt-2"><%= map_data.size %> объектов с координатами</p>
    </div>
    <%= link_to "← К СПИСКУ", properties_path, class: "text-sm tracking-[0.3em] text-muted-foreground hover:text-foreground transition-colors" %>
  </div>
</section>

<% if map_data.any? %>
  <% if has_key %>
    <div class="border-t border-b border-border bg-card">
      <div class="h-[calc(100vh-220px)] min-h-[500px] w-full"
           data-controller="yandex-map"
           data-yandex-map-properties-value="<%= map_data.to_json %>"
           data-yandex-map-clustered-value="true"
           data-yandex-map-zoom-value="11"></div>
    </div>
  <% else %>
    <div class="border-t border-b border-border bg-card">
      <div class="h-[400px] flex items-center justify-center px-6">
        <p class="text-sm text-muted-foreground tracking-wider text-center max-w-md">
          Интерактивная карта будет доступна вскоре. Пока что объекты с координатами доступны в каталоге.
        </p>
      </div>
    </div>
  <% end %>
<% else %>
  <section class="px-6 lg:px-12 py-24 bg-background">
    <div class="max-w-7xl mx-auto border border-border p-16 text-center">
      <p class="text-sm tracking-wider text-muted-foreground mb-6">Объекты не найдены</p>
      <%= link_to "ПЕРЕЙТИ В КАТАЛОГ", properties_path, class: "inline-block px-8 py-4 text-sm tracking-[0.3em] bg-foreground text-background hover:bg-foreground/90 transition-colors" %>
    </div>
  </section>
<% end %>
