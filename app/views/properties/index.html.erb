<% content_for :title, "Каталог недвижимости — АН Виктори" %>

<section class="px-6 lg:px-12 py-24 lg:py-32 bg-background">
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8 mb-16">
      <div>
        <p class="text-sm tracking-[0.4em] text-muted-foreground mb-4">КАТАЛОГ</p>
        <h1 class="text-4xl lg:text-5xl font-light tracking-wider text-foreground">ОБЪЕКТЫ НЕДВИЖИМОСТИ</h1>
      </div>

      <% current_deal_type = params.dig(:q, :deal_type_eq).to_s %>
      <div class="flex flex-wrap gap-2">
        <% [["Все", {}], ["Купить", { deal_type_eq: 'sale' }], ["Снять", { deal_type_eq: 'rent' }]].each do |label, q| %>
          <% active = (current_deal_type == q[:deal_type_eq].to_s) %>
          <%= link_to label, properties_path(q.any? ? { q: q } : {}), class: "px-5 py-2 text-sm tracking-wider border #{active ? 'bg-foreground text-background border-foreground' : 'bg-transparent text-muted-foreground border-border hover:border-foreground hover:text-foreground'} transition-colors" %>
        <% end %>
      </div>
    </div>

    <%= search_form_for @q, url: properties_path, html: { class: "grid grid-cols-1 md:grid-cols-4 gap-px bg-border mb-12" } do |f| %>
      <div class="bg-card p-4">
        <label class="text-xs tracking-[0.3em] text-muted-foreground mb-2 block">ОТ ЦЕНЫ, ₽</label>
        <%= f.search_field :price_gteq, class: "w-full bg-transparent text-foreground tracking-wider focus:outline-none", placeholder: "0" %>
      </div>
      <div class="bg-card p-4">
        <label class="text-xs tracking-[0.3em] text-muted-foreground mb-2 block">ДО ЦЕНЫ, ₽</label>
        <%= f.search_field :price_lteq, class: "w-full bg-transparent text-foreground tracking-wider focus:outline-none", placeholder: "∞" %>
      </div>
      <div class="bg-card p-4">
        <label class="text-xs tracking-[0.3em] text-muted-foreground mb-2 block">КОМНАТ</label>
        <%= f.search_field :rooms_eq, class: "w-full bg-transparent text-foreground tracking-wider focus:outline-none", placeholder: "Любое" %>
      </div>
      <div class="bg-card flex">
        <%= f.submit "ИСКАТЬ", class: "w-full text-sm tracking-[0.3em] bg-foreground text-background hover:bg-foreground/90 transition-colors cursor-pointer" %>
      </div>
    <% end %>

    <% if @total_count.present? %>
      <p class="text-sm tracking-wider text-muted-foreground mb-8">
        Найдено: <span class="text-foreground"><%= @total_count %></span> объектов
        <% if @avg_price.present? %>
          · средняя цена: <span class="text-foreground"><%= number_with_delimiter(@avg_price.to_i) %> ₽</span>
        <% end %>
      </p>
    <% end %>

    <% if @properties.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        <% @properties.each do |property| %>
          <%= render "property_card", property: property %>
        <% end %>
      </div>

      <% if @properties.respond_to?(:total_pages) && @properties.total_pages > 1 %>
        <div class="flex justify-center mt-16">
          <%= paginate @properties, theme: 'plain' rescue nil %>
        </div>
      <% end %>
    <% else %>
      <div class="border border-border p-16 text-center">
        <p class="text-sm tracking-wider text-muted-foreground mb-2">Объекты не найдены</p>
        <p class="text-xs tracking-wider text-muted-foreground mb-6">Попробуйте изменить параметры поиска</p>
        <%= link_to "СБРОСИТЬ ФИЛЬТРЫ", properties_path, class: "inline-block px-8 py-4 text-sm tracking-[0.3em] border border-border text-foreground hover:bg-foreground hover:text-background transition-colors" %>
      </div>
    <% end %>
  </div>
</section>
