<% content_for :title, "Каталог недвижимости — АН Виктори" %>

<%# SEO head: pagination hints + JSON-LD ItemList / AggregateOffer. canonical
    intentionally stays at /properties (stripping query) so paginated/filtered
    views consolidate ranking signal to the main catalog page — rel=next/prev
    below tells crawlers these are sequential continuations, not duplicates. %>
<% content_for :head do %>
  <% if @properties.respond_to?(:current_page) %>
    <% if (prev_p = @properties.prev_page) %>
      <link rel="prev" href="<%= url_for(only_path: false, page: (prev_p == 1 ? nil : prev_p)) %>">
    <% end %>
    <% if (next_p = @properties.next_page) %>
      <link rel="next" href="<%= url_for(only_path: false, page: next_p) %>">
    <% end %>
  <% end %>

  <%# Always anchor CollectionPage + AggregateOffer to the canonical
      /properties URL — url_for(...) would otherwise carry the current
      ransack q[] params and ?page=N into structured data, conflicting
      with <link rel="canonical"> (which strips both). Mismatched
      canonical ↔ JSON-LD trips Google Rich Results validation. %>
  <% page_url = properties_url %>
  <%# AggregateRating across the agency's approved reviews — surfaces SERP
      stars on the catalog landing once we have ≥1 moderated review. Skipped
      when zero (Google manual action for fake markup if AggregateRating
      ships with reviewCount=0). %>
  <% reviews_scope = Review.respond_to?(:status_approved) ? Review.status_approved : nil %>
  <% reviews_count = reviews_scope&.count.to_i %>
  <% aggregate_rating = if reviews_count.positive?
       {
         '@type' => 'AggregateRating',
         'ratingValue' => reviews_scope.average(:rating).to_f.round(2),
         'reviewCount' => reviews_count,
         'bestRating' => 5
       }
     end %>
  <script type="application/ld+json">
  <%= raw({
    '@context' => 'https://schema.org',
    '@type' => 'CollectionPage',
    'name' => 'Каталог недвижимости АН Виктори',
    'url' => page_url,
    'aggregateRating' => aggregate_rating,
    'mainEntity' => {
      '@type' => 'ItemList',
      'numberOfItems' => @total_count.to_i,
      'itemListElement' => @properties.each_with_index.map { |p, i|
        { '@type' => 'ListItem', 'position' => i + 1, 'url' => property_url(p), 'name' => p.title }
      }
    }
  }.compact.to_json) %>
  </script>

  <%# AggregateOffer over the full filtered set (not just this page) — gives
      Yandex/Google the price range as structured data for catalog richer
      results. .reorder('') strips the ORDER BY so the aggregate scans cleanly. %>
  <% if @total_count.to_i.positive? %>
    <% min_price = (@q.result.reorder('').minimum(:price) rescue nil) %>
    <% max_price = (@q.result.reorder('').maximum(:price) rescue nil) %>
    <% if min_price && max_price %>
      <script type="application/ld+json">
      <%= raw({
        '@context' => 'https://schema.org',
        '@type' => 'AggregateOffer',
        'offerCount' => @total_count.to_i,
        'lowPrice' => min_price.to_i,
        'highPrice' => max_price.to_i,
        'priceCurrency' => 'RUB',
        'url' => page_url
      }.to_json) %>
      </script>
    <% end %>
  <% end %>
<% end %>

<section class="px-6 lg:px-12 py-24 lg:py-32 bg-background">
  <div class="max-w-7xl mx-auto">
    <%# Phase 4.5 banner — surfaces investment audit to catalog browsers.
        Buyers actively looking for properties are the highest-intent audience
        for the audit tool; this is one of three key entry points (others:
        property show aside, mode-picker landing). %>
    <div class="mb-12 border border-border bg-card p-4 lg:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <p class="text-sm text-muted-foreground">
        Не знаете, какой объект выгоднее? Запустите бесплатный инвест-аудит — индекс эффективности, симуляция Монте-Карло, рекомендация «Покупать» или «Подождать» за ~30 секунд.
      </p>
      <%= link_to "ЗАПУСТИТЬ АУДИТ →", investment_audit_new_path,
            class: "shrink-0 text-xs tracking-[0.3em] text-foreground border-b border-foreground/30 hover:border-foreground transition-colors" %>
    </div>

    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8 mb-8">
      <div>
        <p class="text-sm tracking-[0.4em] text-muted-foreground mb-4">КАТАЛОГ</p>
        <h1 class="text-4xl lg:text-5xl font-light tracking-wider text-foreground">ОБЪЕКТЫ НЕДВИЖИМОСТИ</h1>
        <%# Visible star widget mirrors the AggregateRating JSON-LD on this page.
            Google's Rich Results spec requires the SERP-star markup to point
            at a rating visible on the same page — otherwise the snippet is
            suppressed. Hidden when there are no approved reviews yet. %>
        <% if defined?(aggregate_rating) && aggregate_rating %>
          <div class="mt-3 flex items-center gap-2 text-xs tracking-widest text-muted-foreground">
            <span class="text-amber-500 text-base" aria-hidden="true">★★★★★</span>
            <span class="text-foreground"><%= aggregate_rating['ratingValue'] %></span>
            <span>/ 5</span>
            <span aria-hidden="true">·</span>
            <%= link_to "#{aggregate_rating['reviewCount']} отзывов",
                  reviews_path,
                  class: 'underline-offset-4 hover:underline hover:text-foreground' %>
          </div>
        <% end %>
      </div>

      <% current_deal_type = params.dig(:q, :deal_type_eq).to_s %>
      <div class="flex flex-wrap gap-2">
        <% [["Все", {}], ["Купить", { deal_type_eq: 'sale' }], ["Снять", { deal_type_eq: 'rent' }]].each do |label, q| %>
          <% active = (current_deal_type == q[:deal_type_eq].to_s) %>
          <%= link_to label, properties_path(q.any? ? { q: q } : {}), class: "px-5 py-2 text-sm tracking-wider border #{active ? 'bg-foreground text-background border-foreground' : 'bg-transparent text-muted-foreground border-border hover:border-foreground hover:text-foreground'} transition-colors" %>
        <% end %>
      </div>
    </div>

    <%# District chips — entry points to SEO landings. Each chip links to
        /kupit/kvartira/rayon/<slug>, which has its own editorial partial
        in landings/content/. Top 8 priority micro-districts (highest search
        traffic). Full list lives in the header's mega-menu (Каталог). %>
    <% chip_slugs = %w[centr kanishchevo dashkovo-pesochnya priokskiy semchino gorroshcha kalnoe solotcha] %>
    <div class="flex flex-wrap items-center gap-2 mb-16 -mt-4">
      <span class="text-xs tracking-[0.3em] text-muted-foreground mr-2">РАЙОНЫ:</span>
      <% chip_slugs.each do |slug| %>
        <%= link_to RyazanDistricts.name_for(slug),
                    buy_district_landing_path(type: 'kvartira', district: slug),
                    class: "px-3 py-1 text-xs tracking-wider border border-border text-muted-foreground hover:border-foreground hover:text-foreground transition-colors" %>
      <% end %>
      <%= link_to "Все районы →", buy_landing_path(type: 'kvartira'),
                  class: "px-3 py-1 text-xs tracking-[0.2em] text-foreground hover:text-muted-foreground transition-colors" %>
    </div>

    <%= search_form_for @q, url: properties_path, html: { class: "grid grid-cols-1 md:grid-cols-4 gap-px bg-border mb-12" } do |f| %>
      <div class="bg-card p-4">
        <label class="text-xs tracking-[0.3em] text-muted-foreground mb-2 block">ОТ ЦЕНЫ, ₽</label>
        <%= f.search_field :price_gteq, class: "w-full bg-transparent text-foreground tracking-wider focus:outline-none", placeholder: "0" %>
      </div>
      <div class="bg-card p-4">
        <label class="text-xs tracking-[0.3em] text-muted-foreground mb-2 block">ДО ЦЕНЫ, ₽</label>
        <%= f.search_field :price_lteq, class: "w-full bg-transparent text-foreground tracking-wider focus:outline-none", placeholder: "∞" %>
      </div>
      <div class="bg-card p-4">
        <label class="text-xs tracking-[0.3em] text-muted-foreground mb-2 block">КОМНАТ</label>
        <%= f.search_field :rooms_eq, class: "w-full bg-transparent text-foreground tracking-wider focus:outline-none", placeholder: "Любое" %>
      </div>
      <div class="bg-card flex">
        <%= f.submit "ИСКАТЬ", class: "w-full text-sm tracking-[0.3em] bg-foreground text-background hover:bg-foreground/90 transition-colors cursor-pointer" %>
      </div>
    <% end %>

    <% if @total_count.present? %>
      <p class="text-sm tracking-wider text-muted-foreground mb-8">
        Найдено: <span class="text-foreground"><%= @total_count %></span> объектов
        <% if @avg_price.present? %>
          · средняя цена: <span class="text-foreground"><%= number_with_delimiter(@avg_price.to_i) %> ₽</span>
        <% end %>
      </p>
    <% end %>

    <% if @properties.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        <%# Mark the first two cards as priority — they are the LCP slot on
            mobile (single column) and tablet (two columns). property_picture
            translates priority_image: true into loading="eager" +
            fetchpriority="high", which Yandex MatrixNet weights heavily for
            mobile ranking. %>
        <% @properties.each_with_index do |property, i| %>
          <%= render "property_card", property: property, priority_image: i < 2 %>
        <% end %>
      </div>

      <% if @properties.respond_to?(:total_pages) && @properties.total_pages > 1 %>
        <div class="flex justify-center mt-16">
          <%= paginate @properties, theme: 'plain' rescue nil %>
        </div>
      <% end %>
    <% else %>
      <div class="border border-border p-16 text-center">
        <p class="text-sm tracking-wider text-muted-foreground mb-2">Объекты не найдены</p>
        <p class="text-xs tracking-wider text-muted-foreground mb-6">Попробуйте изменить параметры поиска</p>
        <%= link_to "СБРОСИТЬ ФИЛЬТРЫ", properties_path, class: "inline-block px-8 py-4 text-sm tracking-[0.3em] border border-border text-foreground hover:bg-foreground hover:text-background transition-colors" %>
      </div>
    <% end %>
  </div>
</section>
