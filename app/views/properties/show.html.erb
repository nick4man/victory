<%# Property show page — orchestration only. Phase 3 design sprint (29.05.26):
    647 LOC → ~110 LOC orchestration + 5 partials + 3 existing partials.
    Cache discipline (Russian doll, keyed by property):
      * gallery + helpful_links + similar + district_cluster: cached
      * main_info: `cache_unless user_signed_in?` (favorite button per-user)
      * SEO meta + PhotoSwipe init: inline (per-request / one-time)
    Existing partials kept: jsonld_property, location_section, price_history. %>

<%# Title + meta description — Seo::PropertyMetaGenerator (Phase 2C) writes
    LLM-generated copy into property.seo_title / .seo_description via
    rake seo_generation:property_meta:backfill. effective_seo_* helpers
    fall back to rule-based generate_meta_* until the backfill runs, so
    the page never renders blank meta. Without per-property meta all 100+
    listings used the agency tagline → identical SERP snippets → CTR hit. %>
<% content_for :title, @property.effective_seo_title %>
<% content_for :seo_description, @property.effective_seo_description %>
<%# Geo meta overrides — Yandex regional ranking expects the page's geo
    signals to match the property's actual location. Without these, every
    listing emitted Рязань-агентство coords, suppressing МСК/СПб objects
    in their local SERPs. Locality drives ISO 3166-2 region code via
    SeoHelper#geo_region_code; placename mirrors the human-readable city;
    position/ICBM come from the property's own lat/lng (with fallback to
    the agency via the layout default for properties without geocoding). %>
<% content_for :geo_region, geo_region_code(@property.address_locality) %>
<% content_for :geo_placename, @property.address_locality %>
<% if @property.latitude.to_f != 0 && @property.longitude.to_f != 0 %>
  <% content_for :geo_position, "#{@property.latitude};#{@property.longitude}" %>
  <% content_for :icbm, "#{@property.latitude}, #{@property.longitude}" %>
  <%# OG geo extension — VK/Дзен parsers recognise place:location to
      render а маленькую карту-чип в preview-карточке шаринга. Extra
      signal сверх geo.* (which is for crawlers, не для соц-сетей). %>
  <% content_for :head do %>
    <meta property="place:location:latitude" content="<%= @property.latitude %>">
    <meta property="place:location:longitude" content="<%= @property.longitude %>">
  <% end %>
<% end %>
<%# OG/Twitter image — hero variant of the first photo (1920×1440). VK,
    Telegram, Дзен all generate richer preview cards when they get a
    landscape image ≥1200px on the long side. %>
<% if @property.images.attached? %>
  <% content_for :og_image, property_image_url(@property.images.first, variant: :hero) %>
  <%# Hero variant uses resize_to_limit [1920, 1440] — actual dims may
      be smaller if source is portrait, but VK/Дзен parsers accept max
      bounds. Without explicit dimensions VK often skips preview entirely. %>
  <% content_for :og_image_width, 1920 %>
  <% content_for :og_image_height, 1440 %>
<% end %>
<%# og:type left to layout default ('website'). The previous 'article'
    value made VK/Telegram render this listing as a news post — wrong
    semantic, and the Apartment/House JSON-LD already carries the
    correct entity type for crawlers. %>
<% content_for :head do %>
  <%# PhotoSwipe (gallery on tap) is fetched from unpkg.com — preconnect
      runs DNS+TLS handshake during initial HTML parse so the open-gallery
      tap doesn't pay 200-400ms cold connection cost on mobile 4G. %>
  <link rel="preconnect" href="https://unpkg.com" crossorigin>

  <%# LCP preload — kicks off the hero image fetch as soon as <head> parses,
      not when the picture tag in body is reached. Cuts ~300ms off Largest
      Contentful Paint on cold visits, which Yandex MatrixNet weights
      heavily for mobile ranking. Helper эмитит AVIF + WebP preload links;
      browser triggers только тот, чей type он поддерживает (no wasted bytes).
      Modern imagesrcset attr учитывает responsive sizes автоматически. %>
  <% if @property.images.attached? %>
    <%= property_hero_preloads(@property.images.first, sizes: '100vw') %>
  <% end %>

  <%= render 'jsonld_property' %>
<% end %>

<%
  # All Active Storage images for this property; trigger lazy analysis so we
  # know real dimensions for PhotoSwipe (falls back to 1600x1200 if absent).
  # NB: each loop fires ActiveStorage::Analyzer per missing-metadata image —
  # follow-up: move к async analyze job чтобы избежать N+1-style blob touches.
  all_images = @property.images.attached? ? @property.images.to_a : []
  all_images.each { |img| img.analyze unless img.analyzed? } rescue nil

  pswp_size = ->(image) {
    w = image&.metadata.is_a?(Hash) ? image.metadata['width']  : nil
    h = image&.metadata.is_a?(Hash) ? image.metadata['height'] : nil
    [w.presence || 1600, h.presence || 1200]
  }
%>

<%# Semantic <article> wraps the property-specific content (hero +
    details + location). Google and Yandex use <article> as a strong
    "this is the main content" signal — helps with content area detection
    for Core Web Vitals scoring and with rich-snippet generation. The
    "Похожие"/"В районе" blocks below stay outside since they're related
    listings, not part of this property's article. itemtype matches the
    JSON-LD @type via Property#schema_org_type — without that, /properties/dom-*
    pages emitted Apartment microdata + House JSON-LD, which Google Rich
    Results flags as "conflicting entity types". %>
<article itemscope itemtype="https://schema.org/<%= @property.schema_org_type %>">
  <%= render 'shared/breadcrumb', items: [
    ['Каталог', properties_path],
    [@property.title, nil]
  ] %>

  <% cache [@property, 'gallery/v1'] do %>
    <%= render 'show_gallery', property: @property, all_images: all_images %>
  <% end %>

  <!-- Location — moved above main info so location is "right on the page", not buried -->
  <%= render 'location_section' %>

  <%# cache_unless защита: текущая Devise OFF делает user_signed_in? всегда
      false → partial cacheable. При re-enable favorites button рендерится
      per-user → cache skip автоматический. price_history.size в key чтобы
      добавление PriceHistory rows invalidated даже без property.touch. %>
  <% cache_unless user_signed_in?, [@property, 'main_info/v1', (@price_history.respond_to?(:size) ? @price_history.size : 0), !!@is_favorited] do %>
    <%= render 'show_main_info',
          property: @property,
          all_images: all_images,
          pswp_size: pswp_size,
          price_history: @price_history,
          is_favorited: @is_favorited %>
  <% end %>

  <!-- PhotoSwipe initialization -->
  <script type="module">
    import PhotoSwipeLightbox from 'https://unpkg.com/photoswipe@5.4.4/dist/photoswipe-lightbox.esm.min.js';

    // -----------------------------------------------------------
    // UX configuration — feel free to tune these for your audience.
    //   loop:        cycle to first photo after the last one
    //   wheelToZoom: scroll-wheel zoom (vs. swipe-to-next)
    //   bgOpacity:   backdrop dimming (1 = fully opaque)
    //   pinchToClose: drag/pinch downwards closes the lightbox
    // -----------------------------------------------------------
    const lightbox = new PhotoSwipeLightbox({
      gallery: '[data-photoswipe-gallery]',
      children: 'a',
      pswpModule: () => import('https://unpkg.com/photoswipe@5.4.4/dist/photoswipe.esm.min.js'),
      loop: true,
      wheelToZoom: true,
      bgOpacity: 0.95,
      pinchToClose: true,
      showHideAnimationType: 'fade',
      initialZoomLevel: 'fit',
      secondaryZoomLevel: 1.5,
      maxZoomLevel: 3,
      // Slower, easing-out slide transition for a calm, premium feel.
      easing: 'cubic-bezier(0.22, 1, 0.36, 1)'
    });
    lightbox.init();
  </script>
</article>

<% cache 'property_show/helpful_links/v1' do %>
  <%= render 'show_helpful_links' %>
<% end %>

<%# Anchor @property в key — иначе два разных property's с identical
    similar-set max(updated_at) и count могли бы collide на one cache entry. %>
<% if @similar_properties.respond_to?(:any?) && @similar_properties.any? %>
  <% cache [@property, 'similar/v1', @similar_properties] do %>
    <%= render 'show_similar', similar_properties: @similar_properties %>
  <% end %>
<% end %>

<% if @district_properties.respond_to?(:any?) && @district_properties.any? %>
  <% cache ['property_show/district_cluster/v1', @property.district, @district_properties] do %>
    <%= render 'show_district_cluster', property: @property, district_properties: @district_properties %>
  <% end %>
<% end %>
