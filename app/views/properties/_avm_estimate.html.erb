<%#
  Automated Valuation Model block for the property show page.
  Hidden entirely when:
    - PropertyAvm returns nil (insufficient comparables)
    - the resulting CI is too wide (spread > 30% — see PropertyAvm::Result#reliable?)
  Otherwise renders a trust-signal block: range + sample basis + methodology.
  No JSON-LD is emitted here — the headline Property.price stays the single
  canonical price for crawlers; the AVM range is editorial/UX only.
%>
<% avm = PropertyAvm.call(@property) %>
<% if avm&.reliable? %>
  <section class="my-12 lg:my-16 border border-border bg-card p-6 lg:p-8 max-w-4xl mx-auto">
    <div class="flex items-start gap-6 flex-col sm:flex-row">
      <div class="flex-1">
        <p class="text-xs tracking-[0.3em] text-muted-foreground mb-3 uppercase">Оценка АН «Виктори»</p>
        <p class="text-3xl lg:text-4xl font-light tracking-wider text-foreground mb-2 leading-tight">
          <%= number_with_delimiter(avm.min_price.to_i) %>&nbsp;—&nbsp;<%= number_with_delimiter(avm.max_price.to_i) %>&nbsp;₽
        </p>
        <p class="text-sm text-muted-foreground">
          <%= number_with_delimiter(avm.price_per_sqm) %>&nbsp;₽/м² · по&nbsp;<%= pluralize(avm.n_used, 'объекту', plural: 'объектам') %>
        </p>
      </div>

      <div class="text-xs text-muted-foreground sm:text-right sm:min-w-[180px]">
        <p class="mb-1">Точность модели: <span class="text-foreground"><%= avm.confidence_pct %>%</span></p>
        <p>Разброс: <span class="text-foreground">±<%= (avm.spread_pct / 2).round %>%</span></p>
      </div>
    </div>

    <details class="mt-6 text-xs text-muted-foreground">
      <summary class="cursor-pointer hover:text-foreground transition-colors">Как считаем</summary>
      <div class="mt-3 leading-relaxed space-y-2">
        <p><%= avm.methodology %></p>
        <p>Выборка: <%= avm.sample_basis %>.</p>
        <p class="text-foreground/60">
          Оценка — статистический ориентир. Точную стоимость объекта формирует продавец;
          сделка проходит по&nbsp;договорной цене.
        </p>
      </div>
    </details>
  </section>
<% end %>
