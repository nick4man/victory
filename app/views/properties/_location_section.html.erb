<%
  # Renders the "РАСПОЛОЖЕНИЕ" block. Sits between hero and main-info on the
  # property show page so location is "right on the page" — not buried at bottom.
  # Skipped entirely when there's no geocoded location; an empty card hurts more than it helps.
  return unless @property.latitude.present? && @property.longitude.present?

  has_key   = ENV['YANDEX_MAPS_API_KEY'].present?
  is_land   = @property.property_type&.slug == 'land'
  zoom      = is_land ? 14 : 16
  district  = @property.district.presence
  # metro_station_display — handles legacy corrupted Array.to_s strings.
  # См. Property#metro_station_display.
  metro     = @property.metro_station_display
  walk_min  = @property.metro_distance.present? ? (@property.metro_distance.to_f / 80).ceil : nil
  ymaps_url = "https://yandex.ru/maps/?ll=#{@property.longitude},#{@property.latitude}&z=17&pt=#{@property.longitude},#{@property.latitude}"
  route_url = "https://yandex.ru/maps/?rtext=~#{@property.latitude},#{@property.longitude}&rtt=auto"
%>

<section class="px-6 lg:px-12 pt-12 pb-16 lg:pt-16 lg:pb-20 bg-background border-t border-border">
  <div class="max-w-7xl mx-auto">
    <p class="text-sm tracking-[0.4em] text-muted-foreground mb-4">РАСПОЛОЖЕНИЕ</p>
    <h2 class="text-3xl lg:text-4xl font-light tracking-wider text-foreground uppercase mb-8">
      <%= [district, metro && "м. #{metro}"].compact.join(', ').presence || 'НА КАРТЕ' %>
    </h2>

    <%# Map + info-rail behave as a single visual unit (shared border, glued bottom edge) %>
    <div class="-mx-6 sm:mx-0">
      <div class="border-x sm:border border-border bg-card overflow-hidden">
        <% if has_key %>
          <div id="property-map-<%= @property.id %>"
               class="h-[320px] sm:h-[400px] lg:h-[460px] w-full"></div>
        <% else %>
          <div class="h-[280px] flex items-center justify-center px-6 text-center">
            <p class="text-sm text-muted-foreground tracking-wider">
              Интерактивная карта будет доступна вскоре. Открыть точку в Яндекс.Картах →
            </p>
          </div>
        <% end %>
      </div>

      <%# 3-cell info-rail glued to map's bottom edge — visually one device. %>
      <% rail = [] %>
      <% rail << ['АДРЕС',          @property.address] if @property.address.present? %>
      <% rail << ['РАЙОН / МЕТРО',  [district, metro && "м. #{metro}"].compact.join(' • ')] if district.present? || metro.present? %>
      <% rail << ['ПЕШКОМ',         "#{walk_min} мин до метро"] if walk_min %>
      <% if rail.any? %>
        <%# Tailwind JIT only picks up literal class strings, so we use a switch
            to keep grid-cols-{1,2,3} discoverable in the source. %>
        <% cols_class = { 1 => 'sm:grid-cols-1', 2 => 'sm:grid-cols-2', 3 => 'sm:grid-cols-3' }[rail.size] %>
        <div class="border-x border-b border-border bg-card grid grid-cols-1 <%= cols_class %> divide-y sm:divide-y-0 sm:divide-x divide-border">
          <% rail.each do |label, value| %>
            <div class="p-4 sm:p-5">
              <p class="text-[10px] tracking-[0.3em] text-muted-foreground mb-1 uppercase"><%= label %></p>
              <p class="text-sm tracking-wide text-foreground"><%= value %></p>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="mt-6 flex flex-wrap gap-x-8 gap-y-3 text-xs tracking-[0.3em]">
      <%# nofollow on outbound Yandex Maps links — they shouldn't pass
          PageRank away from our property pages and they're not editorial
          citations, just utility deeplinks. %>
      <a href="<%= ymaps_url %>" target="_blank" rel="noopener nofollow" class="text-foreground hover:text-muted-foreground transition-colors">
        ОТКРЫТЬ В ЯНДЕКС.КАРТАХ →
      </a>
      <a href="<%= route_url %>" target="_blank" rel="noopener nofollow" class="text-foreground hover:text-muted-foreground transition-colors">
        ПОСТРОИТЬ МАРШРУТ →
      </a>
    </div>

    <p class="mt-4 text-[10px] tracking-[0.3em] text-muted-foreground/70 uppercase">
      Адрес проверен • <%= l @property.updated_at, format: :long %>
    </p>
  </div>
</section>

<% if has_key %>
<%# Lazy-loads Yandex Maps API when the map enters the viewport.
    Inline because project's importmap-rails is disabled (same pattern
    as _chat_widget — direct CDN imports). Saves ~250 KB on initial render. %>
<script>
  (function () {
    var mapEl = document.getElementById('property-map-<%= @property.id %>');
    if (!mapEl) return;

    function showFallback (text) {
      while (mapEl.firstChild) mapEl.removeChild(mapEl.firstChild);
      var box = document.createElement('div');
      box.className = 'h-full flex items-center justify-center text-sm text-muted-foreground tracking-wider px-6 text-center';
      box.textContent = text;
      mapEl.appendChild(box);
    }

    var meta = document.querySelector('meta[name="yandex-maps-api-key"]');
    var apiKey = meta ? meta.content : '';
    if (!apiKey) { showFallback('API-ключ карты не настроен'); return; }

    var loaded = false;
    function loadMap () {
      if (loaded) return;
      loaded = true;

      function init () {
        ymaps.ready(function () {
          try {
            var coords = [<%= @property.latitude %>, <%= @property.longitude %>];
            var map = new ymaps.Map(mapEl, {
              center: coords,
              zoom: <%= zoom %>,
              controls: ['zoomControl', 'fullscreenControl']
            }, {
              suppressMapOpenBlock: true,
              yandexMapDisablePoiInteractivity: true
            });

            var placemark = new ymaps.Placemark(coords, {
              hintContent:          <%= raw @property.title.to_s.to_json %>,
              balloonContentHeader: <%= raw @property.title.to_s.to_json %>,
              balloonContentBody:   <%= raw (@property.address.presence || '').to_json %>
            }, { preset: 'islands#blackDotIcon' });
            map.geoObjects.add(placemark);

            if (window.innerWidth < 768) {
              map.behaviors.disable('scrollZoom');
            }
          } catch (e) {
            console.error('Yandex map init failed:', e);
            showFallback('Не удалось отобразить карту');
          }
        });
      }

      if (typeof ymaps !== 'undefined') {
        init();
      } else {
        var script = document.createElement('script');
        script.src = 'https://api-maps.yandex.ru/2.1/?apikey=' + encodeURIComponent(apiKey) + '&lang=ru_RU';
        script.async = true;
        script.onload = init;
        script.onerror = function () { showFallback('Не удалось загрузить карту'); };
        document.head.appendChild(script);
      }
    }

    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { io.disconnect(); loadMap(); }
        });
      }, { rootMargin: '200px' });
      io.observe(mapEl);
    } else {
      loadMap();
    }
  })();
</script>
<% end %>
