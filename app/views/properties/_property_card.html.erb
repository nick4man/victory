<%
  property = local_assigns[:property]
  # priority_image: true for the cards above the fold (LCP candidates).
  # property_picture maps it to loading="eager" + fetchpriority="high".
  # Default false so the same partial stays safe for grids below the fold
  # (landings, related listings, search results past page 1).
  priority_image = local_assigns.fetch(:priority_image, false)
  hero_img = property.respond_to?(:images) && property.images.attached? ? property.images.first : nil
%>
<div class="group relative bg-card border border-border overflow-hidden">
  <%= link_to property, class: "block" do %>
    <div class="relative aspect-[4/3] overflow-hidden">
      <%= property_picture hero_img,
            alt: property_image_alt(property),
            sizes: '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw',
            priority: priority_image,
            html_class: 'w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700',
            fallback: :card %>
      <div class="absolute inset-0 bg-background/20 group-hover:bg-transparent transition-colors duration-500"></div>

      <div class="absolute top-4 left-4 flex gap-2">
        <% if property.respond_to?(:is_featured) && property.is_featured %>
          <span class="px-3 py-1 text-xs tracking-widest bg-foreground text-background">ТОП</span>
        <% end %>
        <% if property.respond_to?(:external_source) && property.external_source.present? %>
          <span class="px-3 py-1 text-xs tracking-widest bg-background/80 backdrop-blur-sm text-foreground border border-border">БАЗА&nbsp;АГЕНТСТВ</span>
        <% end %>
      </div>

      <div class="absolute bottom-4 right-4 w-12 h-12 flex items-center justify-center bg-foreground text-background opacity-0 translate-y-4 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10M7 17 17 7"/></svg>
      </div>
    </div>

    <div class="p-6 pb-4">
      <h3 class="text-lg tracking-wider text-foreground mb-1 group-hover:text-muted-foreground transition-colors uppercase"><%= property.title %></h3>
      <p class="text-sm text-muted-foreground tracking-wide mb-4"><%= property.address.presence || 'Адрес уточните у агента' %></p>

      <div class="grid grid-cols-2 gap-4 py-4 border-t border-border">
        <div>
          <p class="text-xs tracking-widest text-muted-foreground mb-1">ПЛОЩАДЬ</p>
          <p class="text-sm tracking-wider text-foreground"><%= display_area(property) || "—" %></p>
        </div>
        <div>
          <p class="text-xs tracking-widest text-muted-foreground mb-1">ЭТАЖ</p>
          <p class="text-sm tracking-wider text-foreground">
            <% if property.floor.present? && property.total_floors.present? %>
              <%= property.floor %>/<%= property.total_floors %>
            <% else %>—<% end %>
          </p>
        </div>
      </div>

      <div class="pt-4 border-t border-border">
        <p class="text-xl tracking-wider text-foreground mb-1"><%= property.price_formatted %></p>
        <% if (ppu = display_price_per_unit(property)).present? %>
          <p class="text-xs tracking-wider text-muted-foreground"><%= ppu %></p>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Internal-linking strip: district as a hyperlink to the filtered catalog.
      Sits OUTSIDE the surrounding link_to (nested <a> is invalid HTML) and
      gives Yandex/Google a per-card geo-cluster signal. %>
  <% if property.respond_to?(:district) && property.district.present? %>
    <div class="px-6 pb-3 -mt-2 flex items-center gap-2 text-xs tracking-widest text-muted-foreground">
      <span class="opacity-70">РАЙОН</span>
      <%= link_to property.district.upcase,
                  properties_path(q: { district_eq: property.district }),
                  class: 'underline hover:text-foreground transition-colors' %>
    </div>
  <% end %>

  <% if (a = property.user)&.phone.present? %>
    <div class="px-6 pb-5 -mt-1 flex items-center justify-between text-xs text-muted-foreground tracking-wider">
      <span class="opacity-70 truncate mr-3"><%= a.full_name %></span>
      <a href="tel:<%= a.phone.gsub(/\D/, '') %>" class="underline hover:text-foreground whitespace-nowrap">ПОЗВОНИТЬ</a>
    </div>
  <% end %>
</div>
