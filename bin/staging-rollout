#!/usr/bin/env bash
# bin/staging-rollout <тег> — выкатить образ на staging-стек victory-staging:
# pull (при неудаче — локальная сборка) → up db/redis/web → health → smoke.
#
# Вызывается вручную и из CI (build.yml, через bin/deploy-gate по SSH).
# Прод этот скрипт не трогает: проект victory-staging со своими томами.
set -euo pipefail

TAG="${1:?usage: bin/staging-rollout <тег>}"
# Тег уходит аргументом в docker/compose — только безопасные символы.
[[ "$TAG" =~ ^[0-9a-z][0-9a-z.-]{0,39}$ ]] || { echo "некорректный тег: $TAG" >&2; exit 2; }
[ "$(hostname)" = victory ] || { echo "staging живёт на хосте victory (сейчас: $(hostname))" >&2; exit 2; }

PROD_DIR="${VICTORY_PROD_DIR:-/home/q/victory}"
cd "$PROD_DIR"
[ -f .env.staging ] || { echo "нет $PROD_DIR/.env.staging (образец: .env.staging.example)" >&2; exit 2; }
DOCKER="${DOCKER_BIN:-/usr/bin/docker}"

# Если STORAGE_DIR из .env.staging пропадёт, интерполяция ${STORAGE_DIR:-./storage}
# в docker-compose.yml молча смонтирует ПРОДОВСКИЙ storage (паспорта клиентов,
# запись) в staging-контейнер — WEB_PORT в той же ситуации упал бы громко,
# storage падает тихо. Гвардим до compose (ревью #111, P1).
STORAGE_DIR_CONF=$(grep -E '^STORAGE_DIR=' .env.staging | cut -d= -f2- || true)
if [ -z "$STORAGE_DIR_CONF" ] || [ "$STORAGE_DIR_CONF" = './storage' ]; then
  echo ".env.staging: STORAGE_DIR обязан быть задан и не равен ./storage (продовский каталог)" >&2
  exit 2
fi

WEB_PORT=$(grep -E '^WEB_PORT=' .env.staging | cut -d= -f2- || true)
WEB_PORT=${WEB_PORT:-3002}
[ "$WEB_PORT" != 3000 ] || { echo '.env.staging: WEB_PORT=3000 — это порт прода' >&2; exit 2; }

compose() {
  VICTORY_TAG="$TAG" RAILS_ENV_FILE=.env.staging \
    "$DOCKER" compose -p victory-staging \
    -f docker-compose.yml -f docker-compose.staging.yml \
    --env-file .env.staging "$@"
}

echo "staging-выкатка $TAG (порт $WEB_PORT)"
# --ignore-buildable: db собирается из Dockerfile.postgres и в реестре его
# нет — без флага pull падал бы на нём всегда (та же логика, что в bin/rollout).
compose pull --ignore-buildable web || compose build web
compose up -d db redis web

for i in $(seq 1 30); do
  curl -fsS --max-time 5 "http://127.0.0.1:$WEB_PORT/health/database" >/dev/null 2>&1 && break
  sleep 3
  [ "$i" = 30 ] && { echo 'health не поднялся за 90 с — docker compose -p victory-staging logs web' >&2; exit 1; }
done

ADMIN_TOKEN=$(grep -E '^ADMIN_TOKEN=' .env.staging | cut -d= -f2- || true)
bin/smoke "http://127.0.0.1:$WEB_PORT" "$ADMIN_TOKEN"

# Журнал «что выкачено» — в файле рядом со стеком, как .env.deploy у прода.
printf 'VICTORY_TAG=%s\n' "$TAG" > .env.staging-deploy
echo "staging выкачен: $TAG"
