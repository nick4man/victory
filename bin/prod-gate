#!/usr/bin/env bash
# bin/prod-gate — принудительная команда для SSH-ключа прод-выкатки из CI.
#
# Запись в authorized_keys на хосте victory (см. docs/runbooks/deploy-pipeline.md):
#   command="/home/q/victory/bin/prod-gate",no-agent-forwarding,no-port-forwarding,no-pty,no-user-rc ssh-ed25519 AAAA...
#
# Ключ с такой записью умеет ТОЛЬКО выкатку на прод: gate валидирует
# SSH_ORIGINAL_COMMAND и запускает bin/rollout. Произвольную команду через
# этот ключ выполнить нельзя — это вся его функция.
#
# Отдельный от bin/deploy-gate скрипт, а не второй глагол там — по ревью
# #111 (P1): staging-ключ не должен иметь пути к прод-выкатке даже через
# ошибку конфигурации. У прода свой ключ, свой gate, своя запись.
set -euo pipefail

CMD="${SSH_ORIGINAL_COMMAND:-}"
ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)

case "$CMD" in
  'rollout '*)
    TAG="${CMD#rollout }" ;;
  *)
    echo "prod-gate: команда не разрешена: ${CMD:-<пусто>}" >&2
    exit 2 ;;
esac

# Тег — только безопасные символы: он уходит аргументом в compose и docker.
[[ "$TAG" =~ ^[0-9a-z][0-9a-z.-]{0,39}$ ]] || { echo "prod-gate: некорректный тег: $TAG" >&2; exit 2; }

# --yes: подтверждение уже случилось в GitHub (environment production с
# required reviewers) — второй интерактивный вопрос по SSH бессмысленнен,
# а без TTY он бы просто повис.
exec "$ROOT/bin/rollout" "$TAG" --yes
