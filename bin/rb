#!/usr/bin/env bash
#
# rb — «ruby box». Запускает команду в контейнере с целевым Ruby из ЛЮБОГО
# worktree-сессии (victory / chat / seo / upgrade).
#
# На хосте менеджера версий Ruby нет (ни chruby, ни rbenv, ни mise), системный
# ruby не совпадает с пином в Gemfile — поэтому `bundle`, `rspec` и `bin/rails`
# напрямую в worktree не работают. Этот скрипт — их замена.
#
#   bin/rb ruby -v
#   bin/rb bundle install
#   bin/rb bundle exec rubocop
#   bin/rb --db bin/rails db:prepare          # --db поднимет postgres+redis
#   bin/rb --db bundle exec rspec spec/models
#   bin/rb --shell                            # интерактивный bash внутри
#   RUBY_TARGET=3.4.1 bin/rb --build ruby -v  # пробный прогон на другом Ruby
#
# Живой web — для доменов, где проверка идёт руками в браузере и по вебхукам
# (чат сайта, TG-боты), а не только спеками:
#
#   bin/rb --web up                            # поднять и оставить (development)
#   bin/rb --web logs                          # хвост логов
#   bin/rb --web bin/rails console             # в ЖИВОЙ процесс, не в новый
#   bin/rb --web 'bin/rails runner "p Property.count"'
#   bin/rb --web down                          # погасить, данные в волюмах живы
#
#   Порт — RB_WEB_PORT (по умолчанию 3001), адрес — RB_WEB_BIND (127.0.0.1).
#   Sidekiq в стеке НЕТ намеренно, см. docker-compose.ruby.yml.
#
# Гемы без `bundle install` — копией готового bundle-волюма прода:
#
#   bin/rb --seed-bundle                       # victory_bundle → волюм сессии
#   bin/rb --seed-bundle --from victory-victory_bundle
#   bin/rb --seed-bundle --force               # ЗАМЕНИТЬ содержимое непустого
#
#   Полная установка в свежем worktree — десятки минут и поход в сеть, а рядом
#   на хосте уже лежат распакованные гемы прода. Источник монтируется :ro.
#
#   ⚠ --force — замена, а не «долить поверх»: приёмник очищается перед копией.
#     Иначе гем, выпавший из Gemfile.lock, жил бы в волюме вечно — bundler по
#     локу его не подхватит, но в specifications/ остался бы гемспек
#     зависимости, которой в проекте уже нет. Непустой волюм без --force не
#     трогается вовсе.
#
#   ⚠ Копия идёт одноразовым контейнером из образа `alpine`. Если образа на
#     хосте ещё нет, первый запуск всё-таки сходит в сеть — но за ним одним,
#     а не за сотней гемов.
#
#   ⚠ Гемы прод-волюма соответствуют Gemfile.lock ПРОДА. Если в этом worktree
#     lock другой (бампнули гем, ветка с новой зависимостью), `bundle check`
#     не сойдётся и `bundle install` всё равно понадобится — но доставит он
#     только разницу, а не весь bundle с нуля. Проверять сразу после заливки:
#         bin/rb bundle check
#
# Флаги:
#   --db      поднять postgres+redis перед командой (нужно для rails/rspec;
#             без него контейнер стартует один — быстрее в разы)
#   --web     работать с живым web-контейнером вместо одноразового
#   --build   пересобрать образ (после смены RUBY_TARGET или правки Gemfile)
#   --shell   интерактивный bash вместо разовой команды
#   --down    погасить стек ЭТОЙ сессии (данные в волюмах сохраняются)
#   --nuke    погасить + снести волюмы ЭТОЙ сессии (чужие и прод не трогает)
#   --seed-bundle [--from <волюм>] [--force]
#             залить гемы в bundle-волюм ЭТОЙ сессии из чужого волюма
#             (по умолчанию прод-волюм victory_bundle, монтируется :ro)
#
# У каждой сессии свой compose-проект `victory-rb-<session>`, поэтому четыре
# сессии могут работать параллельно, не деля ни БД, ни bundle-волюм. Образ
# (victory-rubybox:<version>) общий — собирается один раз на всех.

set -euo pipefail

# Полный путь — совпадает с allow-rule в permissions, не ловим лишний промпт.
DOCKER=/usr/bin/docker

ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo '')
if [ -z "$ROOT" ]; then
  echo 'bin/rb: не git-репозиторий.' >&2
  exit 1
fi

# ── Guard: прод-checkout ────────────────────────────────────────────────────
# main checkout — live bind-mount в victory-web-1 (RAILS_ENV=development +
# code-reload). Поднимать здесь второй стек = гонять миграции по каталогу,
# который сию секунду обслуживает victory62.org. Отказ, без вариантов.
#
# Путь main checkout вычисляем, а не хардкодим: репозиторий живёт на двух хостах
# (`<home>/victory` и `/opt/.openclaw/victory`), и на обоих main checkout — тот же
# live bind-mount. Хардкод одного пути оставлял вторую машину без защиты.
# `--git-common-dir` даёт `<main checkout>/.git`, значит родитель — сам checkout.
#
# `pwd -P` обязателен. `$ROOT` приходит из `git rev-parse --show-toplevel` — это
# ВСЕГДА физический путь. Логический `pwd` вернул бы путь через симлинк, строки
# не совпали бы, и guard молча пропустил бы прод: зайти в `/tmp/link-на-victory`
# достаточно, чтобы поднять стек на живом каталоге сайта.
GIT_COMMON=$(git rev-parse --git-common-dir 2>/dev/null || echo '')
MAIN=''
[ -n "$GIT_COMMON" ] && MAIN=$(cd "$GIT_COMMON/.." 2>/dev/null && pwd -P)

# fail-closed: не смогли определить main checkout — отказ, а не молчаливый пропуск.
# Пустой `--git-common-dir` дал бы `cd /..` → `MAIN=/`, и guard не сработал бы
# никогда; `--separate-git-dir` уводит common-dir наружу, и родитель перестаёт
# быть чекаутом. Для защиты прода «не знаю» должно значить «нет», а не «да».
if [ -z "$MAIN" ] || [ "$MAIN" = '/' ] || [ ! -e "$MAIN/.git" ]; then
  echo "bin/rb: не удалось определить main checkout (--git-common-dir → '${GIT_COMMON:-пусто}')." >&2
  echo '   Без него guard прода не работает, поэтому отказ. Проверь layout репозитория.' >&2
  exit 1
fi

if [ "$ROOT" = "$MAIN" ]; then
  if [ -n "${VICTORY_RB_ALLOW_MAIN:-}" ]; then
    # Снятие единственной защиты прода не должно проходить бесследно.
    echo "⚠️  VICTORY_RB_ALLOW_MAIN=1 — guard прода снят вручную." >&2
    echo "   Поднимаю стек в main checkout ($MAIN). Если это прод-хост, ты ломаешь живой сайт." >&2
  else
    cat >&2 <<MSG
❌ Это main checkout ($MAIN) — live-prod bind-mount victory-web-1.
   ruby-box здесь не поднимаем. Перейди в свой worktree, например:
       cd ../victory-upgrade && bin/rb ...
   Если этот чекаут заведомо НЕ прод (чистый клон) — VICTORY_RB_ALLOW_MAIN=1.
MSG
    exit 1
  fi
fi

cd "$ROOT"

# Идентичность — из marker-файла (та же схема, что у SessionStart-хука).
# Fallback на имя каталога: worktree без маркера всё равно получит свой проект,
# а не свалится в чужие волюмы.
SESSION=$(cat "$ROOT/.claude-session" 2>/dev/null || echo '')
[ -n "$SESSION" ] || SESSION=$(basename "$ROOT" | sed 's/^victory-//')
PROJECT="victory-rb-${SESSION}"

if [ ! -f .env ]; then
  echo "❌ Нет $ROOT/.env — контейнер не получит DATABASE_URL/REDIS_URL." >&2
  echo "   Забери из main checkout:  cp $MAIN/.env .env && chmod 600 .env" >&2
  exit 1
fi

export HOST_UID="$(id -u)" HOST_GID="$(id -g)"

COMPOSE=("$DOCKER" compose -p "$PROJECT" -f docker-compose.ruby.yml)

# ── Гемы копией готового волюма вместо bundle install ───────────────────────
# `bundle install` в свежем worktree — десятки минут и поход в сеть за гемами,
# которые уже лежат распакованными в bundle-волюме прода. Копируем их в волюм
# ЭТОЙ сессии. Источник монтируется :ro — прод не изменяется никогда.
#
# Пришло из bin/chat-stack (ветка dev/chat), где команда `seed-bundle` умела
# ровно одну пару волюмов, зашитую в две константы. Здесь адресат вычисляется,
# поэтому командой пользуется любая сессия.
seed_bundle() {
  local src='victory_bundle' force=0 key dst resolved occupied rc

  while [ $# -gt 0 ]; do
    case "$1" in
      --from)
        src="${2:-}"
        [ -n "$src" ] || { echo 'bin/rb: --from без имени волюма.' >&2; exit 2; }
        shift 2 ;;
      --force) force=1; shift ;;
      *)
        echo "bin/rb: --seed-bundle не понимает '$1'. Форма: --seed-bundle [--from <волюм>] [--force]" >&2
        exit 2 ;;
    esac
  done

  # Имя целевого волюма НЕ собираем строкой из ${PROJECT}_bundle: если compose
  # когда-нибудь начнёт называть волюмы иначе, такая догадка молча создаст
  # пустой волюм не того имени, а гемы уедут в никуда. Спрашиваем сам compose:
  # ключ волюма ищем по точке монтирования (/usr/local/bundle) в сервисе ruby,
  # итоговое имя берём из секции volumes его же вывода.
  resolved=$("${COMPOSE[@]}" config --format json | python3 -c '
import json, sys
cfg = json.load(sys.stdin)
mounts = [m for m in cfg["services"]["ruby"]["volumes"]
          if m.get("type") == "volume" and m.get("target") == "/usr/local/bundle"]
if len(mounts) != 1:
    sys.exit(1)
key = mounts[0]["source"]
print(key, cfg.get("volumes", {}).get(key, {}).get("name") or key)
' 2>/dev/null) || {
    echo 'bin/rb: не нашёл в docker-compose.ruby.yml волюм на /usr/local/bundle у сервиса ruby.' >&2
    echo '        Причина одна из: сервис или волюм переименован, compose-файл не читается,' >&2
    echo '        на хосте нет python3. Что именно — покажет:' >&2
    echo "            $DOCKER compose -p $PROJECT -f docker-compose.ruby.yml config --format json" >&2
    exit 1
  }
  read -r key dst <<<"$resolved"

  if ! "$DOCKER" volume inspect "$src" >/dev/null 2>&1; then
    echo "bin/rb: волюма-источника '$src' на хосте нет." >&2
    echo '        Проверь имя:  /usr/bin/docker volume ls | grep bundle' >&2
    echo '        Прод-волюм называется victory_bundle и существует только там, где поднят прод-стек.' >&2
    exit 1
  fi

  if "$DOCKER" volume inspect "$dst" >/dev/null 2>&1; then
    occupied=$("$DOCKER" run --rm -v "$dst:/dst:ro" alpine sh -c 'ls -A /dst | head -1')
    if [ -n "$occupied" ] && [ "$force" -ne 1 ]; then
      echo "bin/rb: волюм '$dst' уже не пуст — молча поверх не заливаю." >&2
      echo '        Так бывает штатно: первый же запуск контейнера наполняет пустой волюм' >&2
      echo '        гемами из образа. Если те гемы устраивают — заливка не нужна.' >&2
      echo '        Перезалить осознанно:  bin/rb --seed-bundle --force' >&2
      echo '        Снести и начать с нуля:  bin/rb --nuke' >&2
      echo '        (--nuke уносит ВСЕ волюмы сессии, включая pgdata/redisdata, не только гемы)' >&2
      exit 1
    fi
  else
    # Метки те же, что ставит compose: без них он на каждый запуск ругается
    # «volume exists but was not created by Docker Compose».
    "$DOCKER" volume create \
      --label com.docker.compose.project="$PROJECT" \
      --label com.docker.compose.volume="$key" \
      "$dst" >/dev/null
  fi

  echo "Копирую $src → $dst (источник :ro) ..."
  # Приёмник чистим перед копией. `cp -a` только доливает: без очистки
  # --force означал бы «слить два бандла», и гем, выпавший из Gemfile.lock,
  # остался бы в волюме вместе со своим гемспеком. Удаляем строго внутри
  # /dst; источник смонтирован :ro и на запись физически недоступен.
  #
  # Пустой источник отбиваем ДО удаления (код 3): иначе --force молча
  # превращал бы рабочий волюм в пустой и рапортовал «Готово: 0 гемов».
  #
  # chown: в прод-волюме гемы принадлежат root, а контейнер бежит под uid
  # хоста. Без этого читать можно, а `bundle install` за недостающим гемом
  # падает с Permission denied.
  #
  # Объём считаем по ИСТОЧНИКУ, хотя интересен размер копии: du берёт st_blocks,
  # а у только что записанных файлов они ещё нулевые (delayed allocation), и
  # свежий /dst показывал 7-14M вместо 242M. Копия побайтовая — размеры равны.
  rc=0
  "$DOCKER" run --rm -v "$src:/src:ro" -v "$dst:/dst" alpine sh -c "
    set -e
    if [ -z \"\$(ls -A /src)\" ]; then
      echo 'bin/rb: волюм-источник пуст — заливать нечего, приёмник не тронут.' >&2
      exit 3
    fi
    find /dst -mindepth 1 -delete
    cp -a /src/. /dst/
    chown -R ${HOST_UID}:${HOST_GID} /dst
    printf 'Готово: %s гемов, %s\\n' \"\$(ls -d /dst/ruby/*/gems/*/ 2>/dev/null | wc -l)\" \"\$(du -sh /src | cut -f1)\"
  " || rc=$?

  if [ "$rc" -eq 3 ]; then
    # Источник пуст — контейнер сказал об этом сам и ничего не удалил.
    exit 1
  elif [ "$rc" -ne 0 ]; then
    echo "❌ Заливка оборвалась (код $rc). Волюм '$dst' — в неизвестном состоянии:" >&2
    echo '   старое уже могло быть снесено, новое доехало не целиком. Как есть не используй.' >&2
    echo '   Повторить:  bin/rb --seed-bundle --force' >&2
    echo "   Или снести волюм целиком:  $DOCKER volume rm $dst" >&2
    exit 1
  fi

  echo 'Проверка:  bin/rb bundle check'
  echo '⚠ Гемы соответствуют Gemfile.lock ПРОДА. Если lock в этом worktree другой —'
  echo '  bundle check не сойдётся, и bundle install всё равно нужен (но доставит разницу).'
}

WITH_DB=0
DO_BUILD=0
WEB=0
while [ $# -gt 0 ]; do
  case "$1" in
    --db)    WITH_DB=1; shift ;;
    --web)   WEB=1; shift ;;
    --build) DO_BUILD=1; shift ;;
    --down)  exec "${COMPOSE[@]}" --profile web down ;;
    --nuke)  exec "${COMPOSE[@]}" --profile web down -v ;;
    --seed-bundle) shift; seed_bundle "$@"; exit 0 ;;
    --shell) shift; set -- 'bash'; break ;;
    --) shift; break ;;
    *) break ;;
  esac
done

[ "$DO_BUILD" -eq 1 ] && "${COMPOSE[@]}" build ruby

# ── Живой web ───────────────────────────────────────────────────────────────
# Отдельная ветка, потому что здесь всё наоборот: не «запустить одноразовый
# контейнер», а «зайти в уже работающий». Команда выполняется через exec, то
# есть видит то же состояние процесса и ту же базу, что и браузер.
if [ "$WEB" -eq 1 ]; then
  case "${1:-}" in
    up)
      "${COMPOSE[@]}" --profile web up -d --wait web
      # Схему накатываем сами: у web стоит SKIP_DB_PREPARE=1, потому что
      # db:prepare на чистой базе доходит до db/seeds.rb и падает на формате
      # телефона. db:prepare здесь идёт без сидов — схема есть, мусора нет.
      "${COMPOSE[@]}" exec -T web bash -c 'bin/rails db:prepare 2>&1 | tail -3' || true
      # app/assets/builds/* в .gitignore, поэтому в свежем worktree их нет и
      # первый же запрос падает с «asset tailwind.css is not present».
      # Идемпотентно, несколько секунд.
      "${COMPOSE[@]}" exec -T web bash -c 'bin/rails tailwindcss:build 2>&1 | tail -2' || true
      echo "✓ web поднят: http://${RB_WEB_BIND:-127.0.0.1}:${RB_WEB_PORT:-3001}"
      echo "  логи: bin/rb --web logs   |   консоль: bin/rb --web bin/rails console"
      exit 0 ;;
    logs)  shift; exec "${COMPOSE[@]}" logs -f --tail=100 web ;;
    ps)    exec "${COMPOSE[@]}" --profile web ps ;;
    '')
      echo 'usage: bin/rb --web up|logs|ps | bin/rb --web <команда в живом контейнере>' >&2
      exit 2 ;;
  esac

  # Всё остальное — выполнить в живом web. Одна строка идёт как есть, несколько
  # аргументов экранируются (та же логика, что для одноразового ruby ниже).
  if [ $# -eq 1 ]; then WEB_CMD="$1"; else WEB_CMD=$(printf '%q ' "$@"); fi
  exec "${COMPOSE[@]}" exec web bash -c "$WEB_CMD"
fi

if [ $# -eq 0 ]; then
  echo 'usage: bin/rb [--db|--web|--build|--shell|--down|--nuke] <команда...>' >&2
  echo '       bin/rb --seed-bundle [--from <волюм>] [--force]   # гемы копией чужого волюма' >&2
  exit 2
fi

# Одна строка — это уже готовая shell-команда, отдаём как есть (иначе `bin/rb
# 'a; b'` сломается). Несколько аргументов — экранируем каждый, чтобы кавычки
# и пробелы дожили до контейнера (важно для `rspec -e 'foo bar'`).
if [ $# -eq 1 ]; then
  CMD="$1"
else
  CMD=$(printf '%q ' "$@")
fi

# DATABASE_URL прилетает из .env прибитым к viktory_realty_development и
# перебивает database.yml — RAILS_ENV=test молча ушёл бы в dev-базу. Снимаем:
# блоки development/test в database.yml собираются из
# DATABASE_HOST/USERNAME/PASSWORD/PORT и в URL не нуждаются.
#
# Раньше здесь URL переписывался под текущий env, потому что снять его было
# нельзя: staging-блок делал ENV.fetch без дефолта, а ERB рендерит весь файл на
# любой среде → KeyError. Блок исправлен, костыль больше не нужен.
CMD='unset DATABASE_URL; '"${CMD}"

if [ "$WITH_DB" -eq 1 ]; then
  "${COMPOSE[@]}" up -d --wait db redis
  exec "${COMPOSE[@]}" run --rm ruby "$CMD"
fi

# --no-deps: без БД контейнер стартует за доли секунды.
exec "${COMPOSE[@]}" run --rm --no-deps ruby "$CMD"
