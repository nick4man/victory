#!/usr/bin/env python3
"""Держит инвариант по путям: относительное внутри репозитория, абсолютное — где иначе никак.

Правило записано в `.claude/memory/techContext.md`, секция «Где абсолютный путь
обязателен», но проза сама себя не защищает. 10.09.26 остаток абсолютных путей
попробовали «довести до одного вида» заменой `/home/q` → `~`. Тильду разворачивает
только шелл, поэтому легли git-метаданные всех worktree, MCP-сервер `postgres`,
deny-правило в `.claude/settings.json` и live-prod guard в `bin/rb` — четыре поломки
из одной замены, и ни одна не проявилась ошибкой при правке.

Проверка ловит оба направления дрейфа:
  1. абсолютный домашний путь в файле, которому он не положен;
  2. путь, который перестаёт быть детерминированным: `~/...`, `~/-worktree/...`,
     `$HOME/...`, `${HOME}/...`. Потребители делятся на два вида, и запрет один:
       * JSON, systemd, nginx, dotenv не разворачивают ни `~`, ни `$HOME` вовсе
         (у systemd есть спецификатор `%h`, но в СИСТЕМНЫХ юнитах он равен `/root`
         — man systemd.unit, — поэтому альтернативой абсолютному пути не является);
       * compose и крон разворачивают, но по `HOME` ВЫЗЫВАЮЩЕГО. Проверено:
         `docker compose config` превращает и `${HOME}/victory`, и `~/victory` в
         `/home/q/victory` — а под `sudo` тот же файл даст `/root/victory`, молча
         создав bind-mount не туда. Это хуже, чем отказ: поломки не видно.
     `$HOME` здесь не прихоть: его называет само правило в techContext.md.

Границы охвата, чтобы зелёная галочка не читалась как «такого больше не случится»:

  * проверяются только отслеживаемые git'ом файлы. Самая дорогая поломка 10.09.26 —
    `.git/worktrees/*/gitdir` у 15 worktree — лежит вне индекса и никакой проверкой
    содержимого репозитория не ловится;
  * `/opt/.openclaw/...` намеренно не проверяется: это легитимная цель деплоя на
    второй машине, её упоминают десяток отслеживаемых файлов;
  * не-UTF8 файлы пропускаются молча (41 шрифт, картинка, снапшот). Здесь намеренное
    расхождение с `bin/services-check`, который читает с `errors='replace'`: с ним в
    проход попали бы все бинарники. Цена — legacy-файл в cp1251 не проверится.

Запуск: bin/paths-check    (нужен только python3 — проверка обязана работать и там,
где Ruby нет)
"""

import fnmatch
import os
import re
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

# Файлы, которым абсолютный домашний путь положен. Причины — по группам в
# techContext.md: VDS (другая машина), файлы вне чекаута, потребители без cwd,
# восстановление с нуля и sudo-шаги. Добавлять сюда — осознанное решение в диффе.
ABSOLUTE_ALLOWED = {
    '.claude/agents/traefik-vds-ops.md',
    '.claude/docs/vds-infra-cheatsheet.md',
    '.claude/memory/activeContext.md',
    '.claude/memory/techContext.md',
    '.claude/settings.json',
    '.claude/skills/crowdsec-policy-management/SKILL.md',
    '.claude/skills/traefik-config-authoring/SKILL.md',
    '.mcp.json',
    'CLAUDE.md',
    'DEPLOYMENT.md',
    'DEPLOYMENT_PROGRESS.md',
    'app/services/topnlab/client.rb',
    'bin/backup',
    'bin/paths-check',
    'config/backup.env.example',
    'config/nginx/viktory-realty.conf',
    'config/schedule.rb',
    'config/systemd/puma.service',
    'deploy/systemd/victory-backup-daily.service',
    'docs/runbooks/restore.md',
    'docs/superpowers/plans/2026-08-09-backups.md',
    'docs/superpowers/plans/2026-09-07-zhk-registry.md',
    'docs/superpowers/specs/2026-08-09-backups-design.md',
    'docs/topnlab-webhook-setup.md',
    'services/audit-engine/SKILL_API_CONTRACT.md',
    'services/zhk-registry/crontab.example',
}

# Потребители, у которых домашний путь недетерминирован: либо не разворачивается
# вовсе, либо разворачивается по `HOME` вызывающего (см. docstring).
# Список выводится из имени файла, а не перечисляется вручную: умолчание должно быть
# «защищён, пока не исключили», иначе следующий такой файл приедет без защиты — так
# устроен и `bin/services-check`, который берёт предмет проверки с диска.
LITERAL_SUFFIX = ('.service', '.timer', '.json', '.conf')
LITERAL_GLOB = ('docker-compose*.yml', 'docker-compose*.yaml', 'crontab*',
                '.env', '.env.*', '*.env', '*env*.example')
LITERAL_PATH = ('config/database.yml', 'config/storage.yml', 'config/schedule.rb')
# Opt-out для файлов, где такая строка заведомо не путь (пока пусто — но место есть,
# чтобы исключение было видно в диффе, а не растворилось в регулярке).
LITERAL_EXEMPT = set()

ABS_RX = re.compile(r"/home/(?:[^/\s\"'`]+/|q\b)")
# `~`, `~/-upgrade` (имена worktree начинаются с дефиса), `$HOME`, `${HOME}`.
# Пробел после `~` не ловим намеренно: nginx-директива `location ^~ /assets/` — не путь.
UNEXPANDED_RX = re.compile(r'(?:~[A-Za-z0-9_-]*|\$\{?HOME\}?)/')

DOC = '.claude/memory/techContext.md, секция «Где абсолютный путь обязателен»'


def tracked_files():
    try:
        out = subprocess.run(['git', '-C', ROOT, 'ls-files', '-z'],
                             capture_output=True, check=True).stdout
        return [p.decode('utf-8') for p in out.split(b'\0') if p]
    except (OSError, subprocess.CalledProcessError, UnicodeDecodeError):
        found = []
        for base, dirs, files in os.walk(ROOT):
            dirs[:] = [d for d in dirs if d not in ('.git', 'node_modules', 'tmp')]
            for name in files:
                found.append(os.path.relpath(os.path.join(base, name), ROOT))
        return found


def literal_consumer(path):
    if path in LITERAL_EXEMPT:
        return False
    if path in LITERAL_PATH or path.endswith(LITERAL_SUFFIX):
        return True
    name = os.path.basename(path)
    return any(fnmatch.fnmatch(name, pattern) for pattern in LITERAL_GLOB)


def main():
    errors = []
    tracked = tracked_files()

    for path in tracked:
        try:
            with open(os.path.join(ROOT, path), encoding='utf-8') as handle:
                lines = handle.readlines()
        except (OSError, UnicodeDecodeError):
            continue

        for num, line in enumerate(lines, 1):
            if ABS_RX.search(line) and path not in ABSOLUTE_ALLOWED:
                errors.append(
                    f'{path}:{num}: абсолютный домашний путь в файле, которому он не положен.\n'
                    f'    Внутри репозитория путь должен быть относительным либо\n'
                    f'    вычисляться в рантайме (git rev-parse --show-toplevel,\n'
                    f'    --git-common-dir). Если путь правда обязан быть абсолютным —\n'
                    f'    добавь файл в ABSOLUTE_ALLOWED и объясни причину в {DOC}.')
            if UNEXPANDED_RX.search(line) and literal_consumer(path):
                errors.append(
                    f'{path}:{num}: `~` или `$HOME` там, где путь перестаёт быть\n'
                    f'    детерминированным. JSON, systemd и nginx не развернут их вовсе;\n'
                    f'    compose и крон развернут по HOME вызывающего — под sudo это\n'
                    f'    /root, и bind-mount уедет молча. Нужен абсолютный путь: {DOC}.')

    # Гниение allowlist: запись без вхождений выдаёт файлу бессрочную лицензию молча.
    tracked_set = set(tracked)
    for entry in sorted(ABSOLUTE_ALLOWED):
        if entry not in tracked_set:
            errors.append(f'{entry}: запись в ABSOLUTE_ALLOWED, но файла в индексе нет — убери её.')
            continue
        try:
            with open(os.path.join(ROOT, entry), encoding='utf-8') as handle:
                body = handle.read()
        except (OSError, UnicodeDecodeError):
            continue
        if not ABS_RX.search(body):
            errors.append(
                f'{entry}: абсолютных путей в файле больше нет, а запись в '
                f'ABSOLUTE_ALLOWED осталась — убери её, иначе лицензия бессрочная.')

    if errors:
        print('bin/paths-check: нарушения инварианта по путям\n')
        for err in errors:
            print(err + '\n')
        print(f'Всего: {len(errors)}')
        return 1

    print(f'bin/paths-check: инвариант по путям соблюдён '
          f'({len(ABSOLUTE_ALLOWED)} файлов в allowlist, проверено {len(tracked)})')
    return 0


if __name__ == '__main__':
    sys.exit(main())
