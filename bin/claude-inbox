#!/usr/bin/env bash
# bin/claude-inbox — inter-session message inbox
#
# Sessions identified by CLAUDE_SESSION env, else per-worktree .claude-session
# marker file.
#
# The QUEUE itself lives in the MAIN checkout (parent of `git --git-common-dir`),
# not in the current worktree. Each worktree carries its own copy of .claude/ on
# disk, and .gitignore excludes inbox/**/*.md — so a worktree-local path would
# put the message somewhere the receiver never looks, and git would not carry it
# either. One shared queue is the only path that actually delivers.
#
# Messages stored as markdown in <main-checkout>/.claude/sessions/inbox/<session>/

set -e

# Where THIS session runs — the identity marker is per-worktree.
WORKTREE_ROOT="${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"

# Where the shared queue lives. CLAUDE_INBOX_ROOT overrides (tests, odd layouts).
resolve_inbox_root() {
  if [ -n "$CLAUDE_INBOX_ROOT" ]; then
    printf '%s' "$CLAUDE_INBOX_ROOT"
    return
  fi
  local common
  common=$(cd "$WORKTREE_ROOT" 2>/dev/null && git rev-parse --git-common-dir 2>/dev/null) || common=''
  if [ -z "$common" ]; then
    printf '%s' "$WORKTREE_ROOT"
    return
  fi
  # Relative form (`.git`) is relative to WORKTREE_ROOT; absolute form is used as-is.
  case "$common" in
    /*) ;;
    *) common="$WORKTREE_ROOT/$common" ;;
  esac
  (cd "$common/.." 2>/dev/null && pwd) || printf '%s' "$WORKTREE_ROOT"
}

INBOX_ROOT="$(resolve_inbox_root)"
INBOX_DIR="$INBOX_ROOT/.claude/sessions/inbox"
MY_SESSION="${CLAUDE_SESSION:-$(cat "$WORKTREE_ROOT/.claude-session" 2>/dev/null || echo unknown)}"

# Known session names. A worktree not listed here self-registers by creating its
# own inbox directory — is_valid_session accepts any existing one.
valid_sessions=("victory" "chat" "seo" "upgrade" "urgent-collector")

known_receivers() {
  local all=("${valid_sessions[@]}")
  local d
  shopt -s nullglob
  for d in "$INBOX_DIR"/*/; do
    d=$(basename "$d")
    [ "$d" = "archive" ] && continue
    case " ${all[*]} " in *" $d "*) ;; *) all+=("$d") ;; esac
  done
  shopt -u nullglob
  printf '%s' "$(IFS='|'; echo "${all[*]}")"
}

is_valid_session() {
  local s="$1"
  [ -z "$s" ] && return 1
  # Reject path traversal / separators — $s is interpolated into a filesystem path.
  case "$s" in */*|*'\'*|.|..) return 1 ;; esac
  for v in "${valid_sessions[@]}"; do
    [ "$s" = "$v" ] && return 0
  done
  # New worktrees self-register via an existing inbox directory.
  [ -d "$INBOX_DIR/$s" ] && return 0
  return 1
}

usage() {
  cat <<USAGE
Usage: bin/claude-inbox <command> [args...]

Commands:
  send <to> "<message>"     Create message FROM me TO <to> ($(known_receivers))
  list                       List pending messages for my session
  read <id>                  Display message by id prefix (timestamp)
  done <id>                  Move message to archive/

Environment:
  CLAUDE_SESSION   identifies your current session — must be set for list/done.
                   Current value: $MY_SESSION
  CLAUDE_INBOX_ROOT  override the shared queue location.

Queue (shared by all worktrees): $INBOX_DIR
USAGE
}

cmd_send() {
  local to="$1"; shift
  local msg="$*"
  if [ -z "$to" ] || [ -z "$msg" ]; then
    echo "Usage: send <to> \"<message>\"" >&2
    exit 1
  fi
  if ! is_valid_session "$to"; then
    echo "Unknown receiver: $to (expected $(known_receivers))" >&2
    echo "  A new worktree self-registers with: mkdir -p $INBOX_DIR/$to" >&2
    exit 1
  fi
  if [ "$MY_SESSION" = "unknown" ]; then
    echo "⚠️  CLAUDE_SESSION not set. Sender will be 'unknown' in the message." >&2
  fi
  mkdir -p "$INBOX_DIR/$to"
  local ts
  ts=$(date +'%Y-%m-%dT%H-%M-%S')
  local slug
  # Кириллицу сохраняем: `tr -c '[:alnum:]'` в C-локали не считает её буквами,
  # и у всех русских сообщений имя файла выходило одинаковым — «msg».
  # Убираем только то, что мешает файловой системе, пробелы → дефисы.
  # `head -c` режет по байтам, поэтому последний двухбайтовый символ разрубается
  # пополам и имя файла выходит невалидным UTF-8; `iconv -c` срезает обломок.
  # Он стоит не последним в конвейере, а pipefail здесь не включён — ненулевой
  # код iconv на обрубке статус не портит.
  slug=$(printf '%s' "$msg" | head -c 60 | iconv -c -f UTF-8 -t UTF-8 2>/dev/null \
         | tr -d '\n\r/\\:*?"<>|' | tr -s '[:space:]' '-' | sed 's/^-//;s/-$//')
  [ -z "$slug" ] && slug="msg"
  local fname="${ts}_from-${MY_SESSION}_${slug}.md"
  local fpath="$INBOX_DIR/$to/$fname"

  cat > "$fpath" <<EOF
---
from: $MY_SESSION
to: $to
created: $(date -Iseconds)
priority: normal
related_files: []
---

$msg
EOF

  echo "✓ Sent to $to:"
  echo "  $fname"
  echo "  ($fpath)"
}

cmd_list() {
  if [ "$MY_SESSION" = "unknown" ]; then
    echo "⚠️  CLAUDE_SESSION not set. Export CLAUDE_SESSION=$(known_receivers), or write the name to $WORKTREE_ROOT/.claude-session" >&2
    exit 1
  fi
  local my_dir="$INBOX_DIR/$MY_SESSION"
  if [ ! -d "$my_dir" ]; then
    echo "No inbox directory for $MY_SESSION"
    exit 0
  fi
  local count=0
  shopt -s nullglob
  for msg in "$my_dir"/*.md; do
    local name
    name=$(basename "$msg" .md)
    local from
    from=$(grep '^from:' "$msg" 2>/dev/null | head -1 | sed 's/from: *//')
    local created
    created=$(grep '^created:' "$msg" 2>/dev/null | head -1 | sed 's/created: *//')
    local prio
    prio=$(grep '^priority:' "$msg" 2>/dev/null | head -1 | sed 's/priority: *//')
    local preview
    preview=$(awk '/^---$/{n++; next} n==2' "$msg" 2>/dev/null | sed '/^$/d' | head -1 | head -c 80)
    printf '[%s]\n' "$name"
    printf '  from: %s  created: %s  priority: %s\n' "$from" "$created" "$prio"
    printf '  %s\n\n' "$preview"
    count=$((count + 1))
  done
  shopt -u nullglob
  echo "Total pending: $count"
}

cmd_read() {
  local id="$1"
  if [ -z "$id" ]; then
    echo "Usage: read <id>" >&2
    exit 1
  fi
  if [ "$MY_SESSION" = "unknown" ]; then
    echo "⚠️  CLAUDE_SESSION not set." >&2
    exit 1
  fi
  local found
  found=$(find "$INBOX_DIR/$MY_SESSION" -maxdepth 1 -name "${id}*.md" 2>/dev/null | head -1)
  if [ -z "$found" ]; then
    echo "No such message: $id" >&2
    exit 1
  fi
  cat "$found"
}

cmd_done() {
  local id="$1"
  if [ -z "$id" ]; then
    echo "Usage: done <id>" >&2
    exit 1
  fi
  if [ "$MY_SESSION" = "unknown" ]; then
    echo "⚠️  CLAUDE_SESSION not set." >&2
    exit 1
  fi
  local archive="$INBOX_DIR/$MY_SESSION/archive"
  mkdir -p "$archive"
  local found
  found=$(find "$INBOX_DIR/$MY_SESSION" -maxdepth 1 -name "${id}*.md" 2>/dev/null | head -1)
  if [ -z "$found" ]; then
    echo "No such message: $id" >&2
    exit 1
  fi
  mv "$found" "$archive/"
  echo "✓ Archived: $(basename "$found")"
}

main() {
  if [ $# -eq 0 ]; then
    usage
    exit 0
  fi
  local cmd="$1"; shift
  case "$cmd" in
    send) cmd_send "$@" ;;
    list) cmd_list ;;
    read) cmd_read "$@" ;;
    done) cmd_done "$@" ;;
    -h|--help|help) usage ;;
    *)
      echo "Unknown command: $cmd" >&2
      usage
      exit 1
      ;;
  esac
}

main "$@"
